{
    "version": "0.2.0",
    "configurations": [
        {
            // Keep this configuration first: F5 always starts the first entry of the list.
            "name": "Launch TraceView Desktop",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-debug",
            "program": "${workspaceFolder}/Caly.Desktop/bin/Debug/net10.0/TraceView.app/Contents/MacOS/TraceView",
            "args": [],
            "cwd": "${workspaceFolder}/Caly.Desktop/bin/Debug/net10.0",
            "console": "internalConsole",
            "stopAtEntry": false,
            "justMyCode": true
        },
        {
            // Local attach only: pipeTransport is for SSH/remote attach and made VS Code
            // spawn a pipe program that does not exist here, which failed with rc:1.
            // debuggerPath is intentionally omitted so the C# extension uses its own vsdbg.
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickProcess}"
        }
    ]
}