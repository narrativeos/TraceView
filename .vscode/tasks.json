{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build-debug",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"build",
				"${workspaceFolder}/Caly.Desktop/Caly.Desktop.csproj",
				"-c",
				"Debug",
				"-f",
				"net10.0"
			],
			"group": "build",
			"problemMatcher": "$msCompile"
		},
		{
			"label": "build-release",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"build",
				"${workspaceFolder}/Caly.Desktop/Caly.Desktop.csproj",
				"-c",
				"Release",
				"-f",
				"net10.0"
			],
			"group": "build",
			"problemMatcher": "$msCompile"
		},
		{
			"label": "publish",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"publish",
				"${workspaceFolder}/Caly.Desktop/Caly.Desktop.csproj",
				"-c",
				"Release",
				"-f",
				"net10.0",
				"-o",
				"${workspaceFolder}/publish"
			],
			"group": "build",
			"problemMatcher": "$msCompile"
		},
		{
			"label": "clean",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"clean",
				"${workspaceFolder}/Caly.Desktop/Caly.Desktop.csproj"
			],
			"group": "build",
			"problemMatcher": []
		},
		{
			"label": "build-tests",
			"type": "shell",
			"command": "dotnet build /Users/futuremeng/github/narrativeos/TraceView/Caly.Tests/Caly.Tests.csproj -c Debug -f net10.0",
			"group": "build"
		},
		{
			"label": "run-popo-tests",
			"type": "shell",
			"command": "dotnet test /Users/futuremeng/github/narrativeos/TraceView/Caly.Tests/Caly.Tests.csproj --filter \"FullyQualifiedName~PopoJsonService\" -f net10.0",
			"group": "test"
		},
		{
			"label": "run-popo-tests-2",
			"type": "shell",
			"command": "dotnet test /Users/futuremeng/github/narrativeos/TraceView/Caly.Tests/Caly.Tests.csproj --filter \"FullyQualifiedName~PopoJsonService\" -f net10.0 -v detailed",
			"group": "test"
		},
		{
			"label": "build-and-test-popo",
			"type": "shell",
			"command": "dotnet build /Users/futuremeng/github/narrativeos/TraceView/Caly.Desktop/Caly.Desktop.csproj -c Debug -f net10.0 && dotnet test /Users/futuremeng/github/narrativeos/TraceView/Caly.Tests/Caly.Tests.csproj --filter \"FullyQualifiedName~PopoJsonService\" -f net10.0",
			"group": "build"
		}
	]
}