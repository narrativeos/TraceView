<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Caly.Core.ViewModels"
             xmlns:agent="using:Caly.Core.Services.Agent"
             x:Class="Caly.Core.Controls.AgentConversationControl"
             x:DataType="vm:AnalysisViewModel">

    <DockPanel>
        <!-- Header: title and close entry -->
        <Border DockPanel.Dock="Top"
                Padding="8,6"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource CalyCardBorderBrush}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="内置智能体对话"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource CalyStrongForegroundBrush}"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Content="×"
                        Command="{Binding HideAgentConversationCommand}"
                        FontSize="14"
                        Padding="6,0"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTip.Tip="隐藏对话面板"/>
            </Grid>
        </Border>

        <!-- Composer row -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    Spacing="4"
                    Margin="4">
            <TextBox x:Name="PART_AgentComposer"
                     Text="{Binding AgentComposerText}"
                     PlaceholderText="对智能体说…（Enter 发送，运行中发送会排队）"
                     MinWidth="160"
                     HorizontalAlignment="Stretch"
                     KeyDown="OnAgentComposerKeyDown"
                     ToolTip.Tip="Enter 发送；Shift+Enter 换行"/>
            <Button Content="发送"
                    Command="{Binding SendAgentPromptCommand}"/>
            <Button Content="取消"
                    Command="{Binding CancelAgentRunCommand}"
                    IsVisible="{Binding IsAgentRunning}"/>
            <Button Content="测试连接"
                    Command="{Binding TestAgentConnectionCommand}"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom"
                   Text="{Binding AgentConnectionStatus}"
                   FontSize="11"
                   Opacity="0.7"
                   Margin="6,0,6,2"
                   TextWrapping="Wrap"/>

        <ScrollViewer x:Name="PART_AgentScroll"
                      VerticalScrollBarVisibility="Auto"
                      Padding="6">
            <ItemsControl x:Name="PART_AgentMessages" ItemsSource="{Binding AgentMessages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="agent:AgentMessage">
                        <StackPanel Spacing="2" Margin="0,4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding RoleLabel}" FontWeight="Bold" FontSize="12"/>
                                <TextBlock Text="{Binding TimeText}"
                                           FontSize="11"
                                           Opacity="0.55"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Text}"
                                       TextWrapping="Wrap"
                                       FontSize="12"/>
                            <Expander IsVisible="{Binding HasTrace}"
                                      Header="执行轨迹"
                                      FontSize="11"
                                      IsExpanded="False">
                                <TextBlock Text="{Binding TraceText}"
                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           Opacity="0.7"
                                           FontFamily="{DynamicResource CalyMonoFontFamily}"/>
                            </Expander>
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        IsVisible="{Binding ShowActions}">
                                <Button Content="{Binding ApproveLabel}"
                                        Command="{Binding ApproveCommand}"
                                        FontSize="12"/>
                                <Button Content="{Binding DenyLabel}"
                                        Command="{Binding DenyCommand}"
                                        FontSize="12"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Status}"
                                       IsVisible="{Binding HasStatus}"
                                       FontSize="11"
                                       Opacity="0.6"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
