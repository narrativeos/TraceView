<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Caly.Core.ViewModels"
             xmlns:controls="clr-namespace:Caly.Core.Controls"
             xmlns:utilities="clr-namespace:Caly.Core.Utilities"
             xmlns:services="clr-namespace:Caly.Core.Services"
             xmlns:tabalonia="clr-namespace:Tabalonia.Controls;assembly=Tabalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Caly.Core.Controls.DocumentsTabsControl"
             x:DataType="vm:MainViewModel"
             SizeChanged="OnSizeChanged">

    <UserControl.Resources>
        <utilities:BoolToGridLengthConverter x:Key="BoolToGridLengthConverter"/>
        <utilities:EqualsConverter x:Key="EqualsConverter"/>
        <utilities:NotEqualsConverter x:Key="NotEqualsConverter"/>
        <utilities:IsNotNullConverter x:Key="IsNotNullConverter"/>
        <utilities:IsNullConverter x:Key="IsNullConverter"/>
    </UserControl.Resources>

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

	<tabalonia:TabsControl Background="Transparent"
                           Padding="0"
                           Margin="0"
                           AddItemCommand="{Binding OpenFileCommand}"
                           CloseItemCommand="{Binding CloseTabCommand}"
                           ItemsSource="{Binding PdfDocuments}"
                           SelectedIndex="{Binding SelectedDocumentIndex}"
                           RightThumbWidth="300"
                           MinTabItemWidth="100">
		<TabControl.ItemTemplate>
			<DataTemplate>
				<TextBlock DockPanel.Dock="Left"
						   Text="{Binding FileName}"
						   TextTrimming="CharacterEllipsis"/>
			</DataTemplate>
		</TabControl.ItemTemplate>
		<TabControl.ContentTemplate>
			<DataTemplate x:DataType="vm:DocumentViewModel">

				<Grid RowDefinitions="30,*">

					<!-- Top navigation bar -->
					<DockPanel Grid.Row="0">

						<!-- Toggle sidebar -->
						<ToggleButton DockPanel.Dock="Left"
                                      VerticalAlignment="Stretch"
                                      Background="Transparent"
                                      IsChecked="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).IsDocumentPaneOpen}">
							<ToggleButton.Styles>
								<Style Selector="PathIcon.closed">
									<Setter Property="Data" Value="{StaticResource pane_close_regular}" />
								</Style>
								<Style Selector="PathIcon.opened">
									<Setter Property="Data" Value="{StaticResource pane_open_regular}" />
								</Style>
							</ToggleButton.Styles>

							<PathIcon Width="17"
                                      Height="17"
                                      Classes.opened="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).IsDocumentPaneOpen}"
									  Classes.closed="{Binding !$parent[UserControl].((vm:MainViewModel)DataContext).IsDocumentPaneOpen}">
								<ToolTip.Tip>Toggle Sidebar Menu</ToolTip.Tip>
							</PathIcon>
						</ToggleButton>

						<!-- Page navigation -->
                        <Button DockPanel.Dock="Left"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Stretch"
                                Background="Transparent"
                                Command="{Binding GoToPreviousPageCommand}">
                            <PathIcon Width="14"
                                      Height="14"
                                      Data="{StaticResource chevron_up_regular}">
                                <ToolTip.Tip>Previous Page</ToolTip.Tip>
                            </PathIcon>
                        </Button>

                        <Button DockPanel.Dock="Left"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Stretch"
                                Background="Transparent"
                                Command="{Binding GoToNextPageCommand}">
                            <PathIcon Width="14"
                                      Height="14"
                                      Data="{StaticResource chevron_down_regular}">
                                <ToolTip.Tip>Next Page</ToolTip.Tip>
                            </PathIcon>
                        </Button>

						<TextBox Name="PART_TextBoxPageNumber"
                                 MinWidth="50"
                                 MaxWidth="50"
                                 TextAlignment="Center"
                                 HorizontalContentAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 VerticalAlignment="Center"
								 KeyDown="PageNumberTextBox_OnKeyDown"
                                 Text="{Binding SelectedPageNumber, UpdateSourceTrigger=Explicit}"
                                 AcceptsReturn="False">
							<TextBox.Styles>
                                <Style Selector="DataValidationErrors">
                                    <Setter Property="Template">
                                        <ControlTemplate>
                                            <ContentPresenter DockPanel.Dock="Left"
                                                              Content="{TemplateBinding Content}"
                                                              Margin="0"/>
                                        </ControlTemplate>
                                    </Setter>
                                </Style>
                            </TextBox.Styles>
                        </TextBox>

						<TextBlock DockPanel.Dock="Left"
								   VerticalAlignment="Center"
								   HorizontalAlignment="Center"
								   TextAlignment="Center"
								   Margin="5,0">
							<Run Text="/"/>
							<Run Text="{Binding PageCount}"/>
						</TextBlock>

						<controls:VerticalSeparator/>

						<!-- Rotate pages -->
						<Button DockPanel.Dock="Left"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Stretch"
                                Background="Transparent"
                                Command="{Binding RotateAllPagesCounterclockwiseCommand}">
							<PathIcon Width="17"
                                      Height="17"
                                      Data="{StaticResource arrow_rotate_counterclockwise_regular}">
								<ToolTip.Tip>Rotate Pages Counterclockwise</ToolTip.Tip>
							</PathIcon>
						</Button>

						<Button DockPanel.Dock="Left"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Stretch"
                                Background="Transparent"
                                Command="{Binding RotateAllPagesClockwiseCommand}">
							<PathIcon Width="17"
                                      Height="17"
                                      Data="{StaticResource arrow_rotate_clockwise_regular}">
								<ToolTip.Tip>Rotate Pages Clockwise</ToolTip.Tip>
							</PathIcon>
						</Button>

						<controls:VerticalSeparator/>

						<!-- Zoom in / out -->
						<Button DockPanel.Dock="Left"
								HorizontalAlignment="Center"
								VerticalAlignment="Stretch"
								Background="Transparent"
								Command="{Binding ZoomOutCommand}">
							<PathIcon Width="17"
									  Height="17"
									  Data="{StaticResource zoom_out_regular}">
								<ToolTip.Tip>Zoom Out</ToolTip.Tip>
							</PathIcon>
						</Button>

						<Button DockPanel.Dock="Left"
								HorizontalAlignment="Center"
								VerticalAlignment="Stretch"
								Background="Transparent"
								Command="{Binding ZoomInCommand}">
							<PathIcon Width="17"
									  Height="17"
									  Data="{StaticResource zoom_in_regular}">
								<ToolTip.Tip>Zoom In</ToolTip.Tip>
							</PathIcon>
						</Button>

						<!-- Fit to Page Width -->
						<Button DockPanel.Dock="Left"
								HorizontalAlignment="Center"
								VerticalAlignment="Stretch"
								Background="Transparent"
								Command="{Binding ZoomToPageWidthCommand}">
							<PathIcon Width="17"
									  Height="17"
									  Data="{StaticResource fit_to_width_regular}">
								<ToolTip.Tip>Fit to Page Width</ToolTip.Tip>
							</PathIcon>
						</Button>

						<TextBlock DockPanel.Dock="Left"
								   Margin="5,0"
								   Text="{Binding ZoomLevel, StringFormat={}{0:0.#%}}"
								   VerticalAlignment="Center"
								   HorizontalAlignment="Center"/>

						<controls:VerticalSeparator/>

						<!-- Toggle MinerU Column -->
						<ToggleButton DockPanel.Dock="Left"
                                        Margin="5,0,0,0"
									   HorizontalAlignment="Center"
									   VerticalAlignment="Stretch"
									   Background="Transparent"
									   IsChecked="{Binding ShowMinerUColumn}">
							<PathIcon Width="17"
									  Height="17"
									  Data="{StaticResource mineru_blocks_regular}">
								<ToolTip.Tip>Toggle MinerU Blocks</ToolTip.Tip>
							</PathIcon>
						</ToggleButton>

						<!-- Toggle Popo Column -->
						<ToggleButton DockPanel.Dock="Left"
                                        Margin="0,0,0,0"
									   HorizontalAlignment="Center"
									   VerticalAlignment="Stretch"
									   Background="Transparent"
									   IsChecked="{Binding ShowAnalysisColumn}">
							<PathIcon Width="17"
									  Height="17"
									  Data="{StaticResource popo_blocks_regular}">
								<ToolTip.Tip>Toggle Popo Blocks</ToolTip.Tip>
							</PathIcon>
						</ToggleButton>

						<controls:VerticalSeparator/>

						<!-- Popo Process -->
						<Button DockPanel.Dock="Right"
                                Margin="0,0,5,0"
								HorizontalAlignment="Center"
								VerticalAlignment="Stretch"
								Background="Transparent"
								Command="{Binding ProcessWithPopoCommand}"
                                IsVisible="{Binding HasMinerUZip}">
							<PathIcon Width="17"
									  Height="17"
									  Data="{StaticResource popo_process_regular}">
								<ToolTip.Tip>Process with Popo</ToolTip.Tip>
							</PathIcon>
						</Button>

						<!-- MinerU AI Parse -->
						<Button DockPanel.Dock="Right"
                                Margin="0,0,5,0"
								HorizontalAlignment="Center"
								VerticalAlignment="Stretch"
								Background="Transparent"
								Command="{Binding ParseWithMinerUCommand}"
                                IsVisible="{Binding MinerUEnabled}">
							<PathIcon Width="17"
									  Height="17"
									  Data="{StaticResource mineru_parse_regular}">
								<ToolTip.Tip>AI Parse with MinerU</ToolTip.Tip>
							</PathIcon>
						</Button>

						<!-- Print -->
						<Button DockPanel.Dock="Right"
                                Margin="0,0,5,0"
								HorizontalAlignment="Center"
								VerticalAlignment="Stretch"
								Background="Transparent"
								Command="{Binding PrintCommand}">
							<PathIcon Width="17"
									  Height="17"
									  Data="{StaticResource print_regular}">
								<ToolTip.Tip>Print</ToolTip.Tip>
							</PathIcon>
						</Button>

						<Grid/>

					</DockPanel>

					<SplitView Grid.Row="1"
							   Name="PART_SplitView"
							   IsPaneOpen="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).IsDocumentPaneOpen, Mode=TwoWay}"
							   OpenPaneLength="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).PaneSize, Mode=TwoWay}"
							   CompactPaneLength="0"
							   DisplayMode="CompactInline">

                    <!-- Three-column layout: PDF | MinerU Blocks | Popo Blocks -->
                    <SplitView.Content>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="{Binding ShowMinerUColumn, Converter={StaticResource BoolToGridLengthConverter}}"/>
                                <ColumnDefinition Width="{Binding ShowAnalysisColumn, Converter={StaticResource BoolToGridLengthConverter}}"/>
                            </Grid.ColumnDefinitions>

                            <!-- Column 1: PDF Document -->
                            <controls:DocumentControl Grid.Column="0"/>

                            <!-- GridSplitter between PDF and MinerU -->
                            <GridSplitter Grid.Column="0"
                                          HorizontalAlignment="Right"
                                          Width="4"
                                          Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                          IsVisible="{Binding ShowMinerUColumn}"/>

                            <!-- Column 2: MinerU Blocks with In-Place Progress -->
                            <Border Grid.Column="1"
                                    Padding="8"
                                    Background="{DynamicResource SystemChromeLowColor}"
                                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                    BorderThickness="1"
                                    IsVisible="{Binding ShowMinerUColumn}">
                                <DockPanel>
                                    <!-- Header -->
                                    <StackPanel DockPanel.Dock="Top"
                                                Orientation="Horizontal"
                                                Spacing="4"
                                                Margin="0,0,0,6">
                                        <TextBlock Text="MinerU"
                                                   FontWeight="Bold"
                                                   FontSize="12"/>
                                        <TextBlock Text="{Binding MinerUBlocks.Count, StringFormat='({0} blocks)'}"
                                                   FontSize="11"
                                                   Opacity="0.6"
                                                   IsVisible="{Binding !IsMinerUParsing}"/>
                                    </StackPanel>

                                    <!-- Progress State: shown during parsing -->
                                    <Border IsVisible="{Binding IsMinerUParsing}"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Stretch">
                                        <StackPanel VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"
                                                    Spacing="12">
                                            <!-- Spinner -->
                                            <PathIcon Width="32"
                                                      Height="32"
                                                      Data="{StaticResource spinner_regular}"
                                                      Foreground="{DynamicResource SystemAccentColor}"
                                                      HorizontalAlignment="Center"/>

                                            <!-- Status Text -->
                                            <TextBlock Text="{Binding MinerUStatusText}"
                                                       FontSize="13"
                                                       HorizontalAlignment="Center"
                                                       TextAlignment="Center"/>

                                            <!-- Progress Bar -->
                                            <ProgressBar Width="200"
                                                         Minimum="0"
                                                         Maximum="100"
                                                         Value="{Binding MinerUProgress}"
                                                         HorizontalAlignment="Center"/>

                                            <!-- Progress Percentage -->
                                            <TextBlock Text="{Binding MinerUProgress, StringFormat='{}{0}%'}"
                                                       FontSize="11"
                                                       HorizontalAlignment="Center"
                                                       Opacity="0.7"/>

                                            <!-- Cancel Button -->
                                            <Button Content="Cancel"
                                                    Command="{Binding CancelMinerUParseCommand}"
                                                    HorizontalAlignment="Center"
                                                    Padding="20,4"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Blocks List: shown when not parsing -->
                                    <ScrollViewer IsVisible="{Binding !IsMinerUParsing}">
                                        <ItemsControl ItemsSource="{Binding MinerUBlocks}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:MinerUBlockViewModel">
                                                    <Border Padding="6"
                                                            Margin="0,2"
                                                            Background="{DynamicResource SystemChromeMediumLowColor}"
                                                            CornerRadius="3">
                                                        <StackPanel Spacing="3">
                                                            <StackPanel Orientation="Horizontal"
                                                                        Spacing="4">
                                                                <TextBlock Text="{Binding Id, StringFormat='#{0}'}"
                                                                           FontSize="10"
                                                                           FontWeight="Bold"
                                                                           Opacity="0.7"/>
                                                                <TextBlock Text="{Binding TypeLabel}"
                                                                           FontSize="10"
                                                                           FontWeight="SemiBold"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding ContentPreview}"
                                                                       FontSize="10"
                                                                       TextWrapping="Wrap"
                                                                       Opacity="0.8"
                                                                       MaxLines="3"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>

                            <!-- GridSplitter between MinerU and Popo -->
                            <GridSplitter Grid.Column="1"
                                          HorizontalAlignment="Right"
                                          Width="4"
                                          Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                          IsVisible="{Binding ShowAnalysisColumn}"/>

                            <!-- Column 3: Popo Blocks with In-Place Progress -->
                            <Border Grid.Column="2"
                                    Padding="8"
                                    Background="{DynamicResource SystemChromeLowColor}"
                                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                    BorderThickness="1"
                                    IsVisible="{Binding ShowAnalysisColumn}">
                                <DockPanel>
                                    <!-- Header -->
                                    <StackPanel DockPanel.Dock="Top"
                                                Orientation="Horizontal"
                                                Spacing="4"
                                                Margin="0,0,0,6">
                                        <TextBlock Text="Popo"
                                                   FontWeight="Bold"
                                                   FontSize="12"/>
                                        <TextBlock Text="{Binding PopoTreeNodeCount, StringFormat='({0} nodes)'}"
                                                   FontSize="11"
                                                   Opacity="0.6"
                                                   IsVisible="{Binding !IsPopoProcessing}"/>
                                    </StackPanel>

                                    <!-- Progress State: shown during Popo processing -->
                                    <Border IsVisible="{Binding IsPopoProcessing}"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Stretch">
                                        <StackPanel VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"
                                                    Spacing="12">
                                            <!-- Spinner -->
                                            <PathIcon Width="32"
                                                      Height="32"
                                                      Data="{StaticResource spinner_regular}"
                                                      Foreground="{DynamicResource SystemAccentColor}"
                                                      HorizontalAlignment="Center"/>

                                            <!-- Status Text -->
                                            <TextBlock Text="{Binding PopoStatusText}"
                                                       FontSize="13"
                                                       HorizontalAlignment="Center"
                                                       TextAlignment="Center"/>

                                            <!-- Progress Bar -->
                                            <ProgressBar Width="200"
                                                         Minimum="0"
                                                         Maximum="100"
                                                         Value="{Binding PopoProgress}"
                                                         HorizontalAlignment="Center"/>

                                            <!-- Progress Percentage -->
                                            <TextBlock Text="{Binding PopoProgress, StringFormat='{}{0}%'}"
                                                       FontSize="11"
                                                       HorizontalAlignment="Center"
                                                       Opacity="0.7"/>

                                            <!-- Cancel Button -->
                                            <Button Content="Cancel"
                                                    Command="{Binding CancelPopoProcessCommand}"
                                                    HorizontalAlignment="Center"
                                                    Padding="20,4"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Error/Status Message: shown when processing failed -->
                                    <Border IsVisible="{Binding PopoStatus, Converter={StaticResource EqualsConverter}, ConverterParameter={x:Static services:PopoProcessStatus.Failed}}"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Stretch"
                                            Padding="12"
                                            Background="#FFF2F2"
                                            CornerRadius="4">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="{Binding PopoStatusText}"
                                                       FontSize="12"
                                                       Foreground="#FF4444"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"/>
                                            <Button Content="Retry"
                                                    Command="{Binding ProcessWithPopoCommand}"
                                                    HorizontalAlignment="Center"
                                                    Padding="20,4"/>
                                        </StackPanel>
                                    </Border>

                                      <!-- Blocks List: shown only when not processing and no error -->
                                      <ScrollViewer IsVisible="{Binding ShowPopoBlocksList}"
                                                    HorizontalScrollBarVisibility="Disabled">
                                          <TreeView ItemsSource="{Binding PopoTreeRootChildren}"
                                                    BorderThickness="0"
                                                    Background="Transparent"
                                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                             <TreeView.Styles>
                                                 <Style Selector="TreeViewItem">
                                                     <Setter Property="IsExpanded" Value="True"/>
                                                 </Style>
                                             </TreeView.Styles>
                                             <TreeView.ItemTemplate>
                                                 <TreeDataTemplate x:DataType="vm:TreeNodeViewModel"
                                                                   ItemsSource="{Binding Children}">
                                                      <Border Padding="6,4"
                                                              Margin="0,1"
                                                              CornerRadius="3"
                                                              Background="{DynamicResource SystemChromeMediumLowColor}"
                                                              HorizontalAlignment="Stretch">
                                                          <StackPanel Spacing="2"
                                                                      HorizontalAlignment="Stretch">
                                                             <!-- Type badge + title -->
                                                             <Grid ColumnDefinitions="Auto,*,Auto">
                                                                 <Border Grid.Column="0"
                                                                         Padding="2,0"
                                                                         CornerRadius="2"
                                                                         Background="{Binding TypeColorHex}"
                                                                         Margin="4,0,6,0">
                                                                     <TextBlock Text="{Binding Type}"
                                                                                FontSize="9"
                                                                                FontWeight="SemiBold"
                                                                                Foreground="White"
                                                                                TextAlignment="Center"/>
                                                                  </Border>
                                                                   <TextBlock Grid.Column="1"
                                                                              Text="{Binding DisplayTitle}"
                                                                              FontSize="11"
                                                                              FontWeight="SemiBold"
                                                                              MaxLines="1"
                                                                              TextTrimming="CharacterEllipsis"
                                                                              VerticalAlignment="Center"
                                                                              HorizontalAlignment="Stretch"
                                                                              TextAlignment="Left"/>
                                                                  <TextBlock Grid.Column="2"
                                                                             Text="{Binding PageRange}"
                                                                             FontSize="9"
                                                                             Foreground="#4FC3F7"
                                                                             VerticalAlignment="Center"
                                                                             Margin="6,0,4,0"/>
                                                              </Grid>

                                                               <!-- Image display for image nodes -->
                                                               <Border IsVisible="{Binding IsImage}"
                                                                       MaxHeight="200"
                                                                       CornerRadius="3"
                                                                       ClipToBounds="True"
                                                                       Margin="0,2,0,0">
                                                                   <Grid>
                                                                       <Image Source="{Binding ImageBitmap}"
                                                                              Stretch="Uniform"
                                                                              HorizontalAlignment="Stretch"
                                                                              VerticalAlignment="Stretch"/>
                                                                       <TextBlock Text="{Binding ImagePathText}"
                                                                                  FontSize="10"
                                                                                  Foreground="#FF9800"
                                                                                  TextWrapping="Wrap"
                                                                                  VerticalAlignment="Center"
                                                                                  HorizontalAlignment="Center"
                                                                                  IsVisible="{Binding !HasImageBitmap}"/>
                                                                   </Grid>
                                                               </Border>

                                                              <!-- Content preview (collapsed, non-image nodes) -->
                                                              <TextBlock Text="{Binding ContentPreview}"
                                                                         FontSize="10"
                                                                         Opacity="0.7"
                                                                         MaxLines="2"
                                                                         TextTrimming="CharacterEllipsis"
                                                                         IsVisible="{Binding ShowContentPreview}"
                                                                         HorizontalAlignment="Stretch"
                                                                         TextAlignment="Left"/>

                                                              <!-- Full content (expanded, non-image nodes) -->
                                                              <TextBlock Text="{Binding DisplayContent}"
                                                                         FontSize="10"
                                                                         Opacity="0.8"
                                                                         TextWrapping="Wrap"
                                                                         IsVisible="{Binding ShowFullContent}"
                                                                         HorizontalAlignment="Stretch"
                                                                         TextAlignment="Left"/>

                                                             <!-- Expand/Collapse button for long content -->
                                                             <Button Command="{Binding ToggleContentExpandCommand}"
                                                                     HorizontalAlignment="Right"
                                                                     VerticalAlignment="Bottom"
                                                                     Padding="6,2"
                                                                     FontSize="9"
                                                                     Background="Transparent"
                                                                     BorderThickness="0"
                                                                     IsVisible="{Binding IsContentLong}">
                                                                 <Button.Content>
                                                                     <StackPanel Orientation="Horizontal" Spacing="2">
                                                                         <TextBlock Text="展开"
                                                                                    IsVisible="{Binding !IsContentExpanded}"/>
                                                                         <TextBlock Text="折叠"
                                                                                    IsVisible="{Binding IsContentExpanded}"/>
                                                                     </StackPanel>
                                                                 </Button.Content>
                                                             </Button>
                                                         </StackPanel>
                                                     </Border>
                                                 </TreeDataTemplate>
                                             </TreeView.ItemTemplate>
                                         </TreeView>
                                     </ScrollViewer>
                                </DockPanel>
                            </Border>

                        </Grid>
                    </SplitView.Content>

						<!-- Left navigation bar -->
						<SplitView.Pane>

							<Grid ColumnDefinitions="*,5"
                                  IsVisible="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).IsDocumentPaneOpen}">

                                <Border Grid.Column="0"
                                        BorderThickness="1">

									<TabControl Name="PART_TabControlNavigation"
												TabStripPlacement="Left"
												Padding="12,0,0,0"
												SelectedIndex="{Binding SelectedTabIndex}">

										<!-- Thumbnails tab -->
										<TabItem MinHeight="40"
												 IsSelected="True">
											<TabItem.Header>
												<PathIcon Width="17"
														  Height="17"
														  Data="{StaticResource copy_regular}">
													<ToolTip.Tip>Thumbnails</ToolTip.Tip>
													<PathIcon.RenderTransform>
														<ScaleTransform ScaleY="-1"/>
													</PathIcon.RenderTransform>
												</PathIcon>
											</TabItem.Header>
											<Grid>
                                                <controls:ThumbnailItemsControl
                                                    IsVisible="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).IsDocumentPaneOpen}"
                                                    RefreshThumbnails="{Binding RefreshThumbnailsCommand}"
													RealisedThumbnails="{Binding RealisedThumbnails}"
													VisibleThumbnails="{Binding VisibleThumbnails}"
                                                    Background="Transparent"
                                                    SelectionMode="Single,AlwaysSelected"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"
                                                    BorderThickness="0"
                                                    ItemsSource="{Binding Pages}"
                                                    SelectedIndex="{Binding SelectedPageIndex, Mode=TwoWay}">

                                                    <controls:ThumbnailItemsControl.Styles>
                                                        <Style Selector="ListBoxItem">
                                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                                        </Style>
                                                    </controls:ThumbnailItemsControl.Styles>

                                                    <controls:ThumbnailItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:PageViewModel">
                                                            
                                                            <Grid Margin="3,4"
                                                                  Width="{Binding ThumbnailSize.Width}"
                                                                  Height="{Binding ThumbnailSize.Height}">
                                                                <controls:ThumbnailControl VisibleArea="{Binding VisibleArea}"
                                                                        ThumbnailSize="{Binding ThumbnailSize}"
                                                                        PageSize="{Binding Size}"
                                                                        HorizontalAlignment="Stretch"
                                                                        VerticalAlignment="Stretch"/>
                                                                <Label Content="{Binding PageNumber}"
                                                                       MinWidth="25"
                                                                       HorizontalAlignment="Center"
                                                                       HorizontalContentAlignment="Center"
                                                                       VerticalAlignment="Bottom"
                                                                       Padding="3,0"
                                                                       Margin="3"
                                                                       Background="{DynamicResource SystemChromeMediumLowColor}"
                                                                       BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                                                       BorderThickness="1"
                                                                       CornerRadius="7"/>
                                                            </Grid>

                                                        </DataTemplate>
                                                    </controls:ThumbnailItemsControl.ItemTemplate>

                                                </controls:ThumbnailItemsControl>
                                            </Grid>
										</TabItem>

										<!-- Bookmarks tab -->
                                        <TabItem MinHeight="40"
                                                 IsVisible="{Binding BookmarksSource^, Converter={StaticResource IsNotNullConverter}}"
                                                 IsEnabled="{Binding BookmarksSource^, Converter={StaticResource IsNotNullConverter}}">
											<TabItem.Header>
												<PathIcon Width="17"
														  Height="17"
														  Data="{StaticResource bookmark_regular}">
													<ToolTip.Tip>Bookmarks</ToolTip.Tip>
												</PathIcon>
											</TabItem.Header>

                                            <TreeDataGrid Source="{Binding BookmarksSource^}"
                                                          ShowColumnHeaders="False"
                                                          CanUserSortColumns="False"
                                                          HorizontalAlignment="Stretch"
                                                          AutoScrollHorizontally="False"
                                                          AutoScrollSelectionIntoView="True"/>
										</TabItem>

										<!-- Search tab -->
										<TabItem MinHeight="40">
											<TabItem.Header>
												<PathIcon Width="17"
														  Height="17"
														  Data="{StaticResource document_search_regular}">
													<ToolTip.Tip>Search</ToolTip.Tip>
												</PathIcon>
											</TabItem.Header>

											<controls:FullSearchPanelControl/>
										</TabItem>

										<!-- Doc information tab -->
										<TabItem MinHeight="40">
											<TabItem.Header>
												<PathIcon Width="17"
														  Height="17"
														  Data="{StaticResource info_regular}">
													<ToolTip.Tip>Document Properties</ToolTip.Tip>
												</PathIcon>
											</TabItem.Header>

											<controls:DocumentPropertiesControl DataContext="{Binding Properties^}"/>

										</TabItem>

                                        <!-- Embedded files tab -->
                                        <TabItem MinHeight="40"
                                                 IsVisible="{Binding !!EmbeddedFiles^.Count}"
                                                 IsEnabled="{Binding !!EmbeddedFiles^.Count}">
                                            <TabItem.Header>
                                                <PathIcon Width="17"
                                                          Height="17"
                                                          Data="{StaticResource attach_text_regular}">
                                                    <ToolTip.Tip>Embedded Files</ToolTip.Tip>
                                                </PathIcon>
                                            </TabItem.Header>
                                            
                                            <ListBox ItemsSource="{Binding EmbeddedFiles^}"
                                                     Background="Transparent">
                                                <ListBox.Styles>
                                                    <Style Selector="ListBoxItem">
                                                        <Setter Property="Padding" Value="5,0" />
                                                    </Style>
                                                </ListBox.Styles>


                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel Background="Transparent"
                                                                   HorizontalSpacing="5"
                                                                   HorizontalAlignment="Stretch"
																   VerticalAlignment="Stretch"
                                                                   PointerPressed="EmbeddedFiles_OnPointerPressed"
                                                                   MinHeight="20">

                                                            <TextBlock DockPanel.Dock="Left"
                                                                       Text="{Binding Name}"
                                                                       HorizontalAlignment="Left"
                                                                       VerticalAlignment="Center"/>

                                                            <TextBlock DockPanel.Dock="Right"
                                                                       Text="{Binding FileSize}"
                                                                       HorizontalAlignment="Right"
                                                                       VerticalAlignment="Center"/>

                                                            <DockPanel.ContextFlyout>
                                                                <MenuFlyout>
                                                                    <MenuItem Header="Open" Command="{Binding OpenCommand}">
                                                                        <MenuItem.Icon>
                                                                            <PathIcon Width="15" Height="15" Data="{StaticResource open_regular}"/>
                                                                        </MenuItem.Icon>
                                                                    </MenuItem>

                                                                    <MenuItem Header="Save As..." Command="{Binding SaveAsCommand}">
                                                                        <MenuItem.Icon>
                                                                            <PathIcon Width="15" Height="15" Data="{StaticResource save_regular}"/>
                                                                        </MenuItem.Icon>
                                                                    </MenuItem>
                                                                </MenuFlyout>
                                                            </DockPanel.ContextFlyout>

                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </TabItem>

                                        <!-- AI Analysis tab -->
                                        <TabItem MinHeight="40"
                                                 IsVisible="{Binding HasStructureDocument}"
                                                 IsEnabled="{Binding HasStructureDocument}">
                                            <TabItem.Header>
                                                <PathIcon Width="17"
                                                          Height="17"
                                                          Data="{StaticResource question_regular}">
                                                    <ToolTip.Tip>AI Analysis</ToolTip.Tip>
                                                </PathIcon>
                                            </TabItem.Header>

                                            <controls:AnalysisView DataContext="{Binding AnalysisViewModel}"/>
                                        </TabItem>

									</TabControl>
								</Border>

								<!-- Resize left navigation bar -->
                                <Grid Grid.Column="1"
									  Background="Transparent"
                                      PointerMoved="Resize_OnPointerMoved"
                                      PointerEntered="Resize_OnPointerEntered"
                                      PointerExited="Resize_OnPointerExited"
                                      PointerPressed="Resize_OnPointerPressed"
                                      PointerReleased="Resize_OnPointerReleased">
                                    <Rectangle Width="{DynamicResource CalySplitViewHandleWidth}"
                                               HorizontalAlignment="Center"
                                               Fill="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"/>
                                </Grid>
							</Grid>
						</SplitView.Pane>

					</SplitView>

				</Grid>

			</DataTemplate>
		</TabControl.ContentTemplate>
	</tabalonia:TabsControl>

</UserControl>