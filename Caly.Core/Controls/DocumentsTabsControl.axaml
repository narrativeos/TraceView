<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Caly.Core.ViewModels"
             xmlns:controls="clr-namespace:Caly.Core.Controls"
             xmlns:utilities="clr-namespace:Caly.Core.Utilities"
             xmlns:services="clr-namespace:Caly.Core.Services"
             xmlns:models="clr-namespace:Caly.Core.Models"
             xmlns:tabalonia="clr-namespace:Tabalonia.Controls;assembly=Tabalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Caly.Core.Controls.DocumentsTabsControl"
             x:DataType="vm:MainViewModel"
             SizeChanged="OnSizeChanged">

    <UserControl.Resources>
        <utilities:BoolToGridLengthConverter x:Key="BoolToGridLengthConverter"/>
        <utilities:EqualsConverter x:Key="EqualsConverter"/>
        <utilities:NotEqualsConverter x:Key="NotEqualsConverter"/>
        <utilities:IsNotNullConverter x:Key="IsNotNullConverter"/>
        <utilities:IsNullConverter x:Key="IsNullConverter"/>
        <utilities:IsGreaterThanConverter x:Key="IsGreaterThanConverter"/>
        <utilities:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <utilities:CompletedToOpacityConverter x:Key="CompletedToOpacityConverter"/>
</UserControl.Resources>

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

	<tabalonia:TabsControl Background="Transparent"
                           Padding="0"
                           Margin="0"
                           AddItemCommand="{Binding OpenFileCommand}"
                           CloseItemCommand="{Binding CloseTabCommand}"
                           ItemsSource="{Binding PdfDocuments}"
                           SelectedIndex="{Binding SelectedDocumentIndex}"
                           RightThumbWidth="300"
                           MinTabItemWidth="100">
		<TabControl.ItemTemplate>
			<DataTemplate>
				<TextBlock DockPanel.Dock="Left"
						   Text="{Binding FileName}"
						   TextTrimming="CharacterEllipsis">
					<!-- Right click (or Control+click) on a document tab -->
					<TextBlock.ContextFlyout>
						<MenuFlyout>
							<MenuItem Header="关闭文档"
									  Command="{Binding $parent[tabalonia:TabsControl].((vm:MainViewModel)DataContext).CloseTabCommand}"
									  CommandParameter="{Binding}" />
							<MenuItem Header="在 Finder 中显示"
									  Command="{Binding RevealInFinderCommand}" />
						</MenuFlyout>
					</TextBlock.ContextFlyout>
				</TextBlock>
			</DataTemplate>
		</TabControl.ItemTemplate>
		<TabControl.ContentTemplate>
			<DataTemplate x:DataType="vm:DocumentViewModel">

				<Grid RowDefinitions="30,*">

					<!-- Top navigation bar -->
					<DockPanel Grid.Row="0">

					<DockPanel.Styles>
						<!--
							工具轨按钮：28x26、圆角 6 的图标按钮。
							默认透明 -> hover 淡色 -> 按下更深 -> 勾选态用主色淡底 + 主色描边，
							让“当前工具”一眼可见。
						-->
						<Style Selector="Button, ToggleButton">
							<Setter Property="Width" Value="28"/>
							<Setter Property="Height" Value="26"/>
							<Setter Property="Padding" Value="0"/>
							<Setter Property="VerticalAlignment" Value="Center"/>
							<Setter Property="CornerRadius" Value="{StaticResource CalyToolbarButtonCornerRadius}"/>
							<Setter Property="Background" Value="Transparent"/>
							<Setter Property="BorderThickness" Value="1"/>
							<Setter Property="BorderBrush" Value="Transparent"/>
						</Style>
						<Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
							<Setter Property="Background" Value="{DynamicResource CalyToolbarHoverBackgroundBrush}"/>
						</Style>
						<Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter, ToggleButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
							<Setter Property="Background" Value="{DynamicResource CalyToolbarPressedBackgroundBrush}"/>
						</Style>
						<Style Selector="ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter">
							<Setter Property="Background" Value="{DynamicResource CalyToolbarActiveBackgroundBrush}"/>
							<Setter Property="BorderBrush" Value="{DynamicResource CalyToolbarActiveBorderBrush}"/>
						</Style>
						<!-- Active toggle also takes the accent colour, which the stroked toolbar glyphs inherit. -->
						<Style Selector="ToggleButton:checked">
							<Setter Property="Foreground" Value="{DynamicResource CalyPrimaryBrush}"/>
						</Style>
						<!-- 次要信息（页码 / 缩放百分比）：12pt 灰字；页码输入框去掉边框，融入工具轨 -->
						<Style Selector="TextBlock.meta">
							<Setter Property="FontSize" Value="12"/>
							<Setter Property="Foreground" Value="{DynamicResource CalyMutedForegroundBrush}"/>
						</Style>
						<Style Selector="TextBox.meta">
							<Setter Property="FontSize" Value="12"/>
							<Setter Property="Foreground" Value="{DynamicResource CalyMutedForegroundBrush}"/>
							<Setter Property="Background" Value="Transparent"/>
							<Setter Property="BorderThickness" Value="0"/>
							<Setter Property="CornerRadius" Value="{StaticResource CalyToolbarButtonCornerRadius}"/>
							<Setter Property="Height" Value="22"/>
							<Setter Property="Padding" Value="2,0"/>
						</Style>
						<Style Selector="TextBox.meta:pointerover /template/ Border#PART_BorderElement">
							<Setter Property="Background" Value="{DynamicResource CalyToolbarHoverBackgroundBrush}"/>
						</Style>
					</DockPanel.Styles>

						<!-- Toggle sidebar -->
						<ToggleButton DockPanel.Dock="Left"
                                      AutomationProperties.Name="显示侧边栏"
                                      ToolTip.Tip="显示侧边栏 (Cmd+Ctrl+S)"
                                      IsChecked="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).IsDocumentPaneOpen}">
							<ToggleButton.Styles>
								<Style Selector="PathIcon.closed">
									<Setter Property="Data" Value="{StaticResource pane_close_regular}" />
								</Style>
								<Style Selector="PathIcon.opened">
									<Setter Property="Data" Value="{StaticResource pane_open_regular}" />
								</Style>
							</ToggleButton.Styles>

							<PathIcon Width="17"
                                      Height="17"
                                      Classes.opened="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).IsDocumentPaneOpen}"
									  Classes.closed="{Binding !$parent[UserControl].((vm:MainViewModel)DataContext).IsDocumentPaneOpen}">
								<ToolTip.Tip>切换侧边栏</ToolTip.Tip>
							</PathIcon>
						</ToggleButton>

						<!-- Page navigation -->
                        <Button DockPanel.Dock="Left"
                                HorizontalAlignment="Center"
                            AutomationProperties.Name="上一页"
                                Command="{Binding GoToPreviousPageCommand}">
                            <PathIcon Width="14"
                                      Height="14"
                                      Data="{StaticResource chevron_left_regular}">
                                <ToolTip.Tip>上一页</ToolTip.Tip>
                            </PathIcon>
                        </Button>

                        <Button DockPanel.Dock="Left"
                                HorizontalAlignment="Center"
                            AutomationProperties.Name="下一页"
                                Command="{Binding GoToNextPageCommand}">
                            <PathIcon Width="14"
                                      Height="14"
                                      Data="{StaticResource chevron_right_regular}">
                                <ToolTip.Tip>下一页</ToolTip.Tip>
                            </PathIcon>
                        </Button>

						<TextBox Name="PART_TextBoxPageNumber"
                                 Classes="meta"
                                 MinWidth="50"
                                 MaxWidth="50"
                                 TextAlignment="Center"
                                 HorizontalContentAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 VerticalAlignment="Center"
								 KeyDown="PageNumberTextBox_OnKeyDown"
                                 Text="{Binding SelectedPageNumber, UpdateSourceTrigger=Explicit}"
                                 AcceptsReturn="False">
							<TextBox.Styles>
                                <Style Selector="DataValidationErrors">
                                    <Setter Property="Template">
                                        <ControlTemplate>
                                            <ContentPresenter DockPanel.Dock="Left"
                                                              Content="{TemplateBinding Content}"
                                                              Margin="0"/>
                                        </ControlTemplate>
                                    </Setter>
                                </Style>
                            </TextBox.Styles>
                        </TextBox>

						<TextBlock DockPanel.Dock="Left"
								   VerticalAlignment="Center"
								   HorizontalAlignment="Center"
								   TextAlignment="Center"
					   Classes="meta"
								   Margin="5,0">
							<Run Text="/"/>
							<Run Text="{Binding PageCount}"/>
						</TextBlock>

						<controls:VerticalSeparator/>

						<!-- Rotate pages -->
						<Button DockPanel.Dock="Left"
                                HorizontalAlignment="Center"
						    AutomationProperties.Name="逆时针旋转页面"
                                Command="{Binding RotateAllPagesCounterclockwiseCommand}">
							<PathIcon Width="17"
                                      Height="17"
                                      Data="{StaticResource arrow_rotate_counterclockwise_regular}">
								<ToolTip.Tip>逆时针旋转页面</ToolTip.Tip>
							</PathIcon>
						</Button>

						<Button DockPanel.Dock="Left"
                                HorizontalAlignment="Center"
						    AutomationProperties.Name="顺时针旋转页面"
                                Command="{Binding RotateAllPagesClockwiseCommand}">
							<PathIcon Width="17"
                                      Height="17"
                                      Data="{StaticResource arrow_rotate_clockwise_regular}">
								<ToolTip.Tip>顺时针旋转页面</ToolTip.Tip>
							</PathIcon>
						</Button>

						<controls:VerticalSeparator/>

						<!-- Zoom in / out -->
						<Button DockPanel.Dock="Left"
								HorizontalAlignment="Center"
						    AutomationProperties.Name="缩小"
								Command="{Binding ZoomOutCommand}">
							<PathIcon Width="17"
									  Height="17"
									  Data="{StaticResource zoom_out_regular}">
								<ToolTip.Tip>缩小</ToolTip.Tip>
							</PathIcon>
						</Button>

						<Button DockPanel.Dock="Left"
								HorizontalAlignment="Center"
						    AutomationProperties.Name="放大"
								Command="{Binding ZoomInCommand}">
							<PathIcon Width="17"
									  Height="17"
									  Data="{StaticResource zoom_in_regular}">
								<ToolTip.Tip>放大</ToolTip.Tip>
							</PathIcon>
						</Button>

						<!-- Fit to Page Width -->
						<Button DockPanel.Dock="Left"
								HorizontalAlignment="Center"
						    AutomationProperties.Name="适应页面宽度"
								Command="{Binding ZoomToPageWidthCommand}">
							<PathIcon Width="17"
									  Height="17"
									  Data="{StaticResource fit_to_width_regular}">
								<ToolTip.Tip>适应页面宽度</ToolTip.Tip>
							</PathIcon>
						</Button>

						<TextBlock DockPanel.Dock="Left"
								   Margin="5,0"
								   Text="{Binding ZoomLevel, StringFormat={}{0:0.#%}}"
								   VerticalAlignment="Center"
					   Classes="meta"
								   HorizontalAlignment="Center"/>

						<controls:VerticalSeparator/>

						<!-- Toggle MinerU Column -->
						<ToggleButton DockPanel.Dock="Left"
                                        Margin="5,0,0,0"
									   HorizontalAlignment="Center"
						    AutomationProperties.Name="切换 MinerU 块列"
									   IsChecked="{Binding ShowMinerUColumn}">
							<Path Classes="toolIcon" Width="20"
									  Height="20"
									  Data="{StaticResource glyph_blocks_regular}">
								<ToolTip.Tip>切换 MinerU 块列</ToolTip.Tip>
							</Path>
						</ToggleButton>

							<!-- Toggle Popo Column -->
							<ToggleButton DockPanel.Dock="Left"
                                        Margin="0,0,0,0"
									   HorizontalAlignment="Center"
							    AutomationProperties.Name="切换 Popo 块列"
									   IsChecked="{Binding ShowAnalysisColumn}">
								<Path Classes="toolIcon" Width="20"
										  Height="20"
										  Data="{StaticResource glyph_link_regular}">
									<ToolTip.Tip>切换 Popo 块列</ToolTip.Tip>
								</Path>
							</ToggleButton>

                            <!-- Toggle Semantic Column -->
                            <ToggleButton DockPanel.Dock="Left"
                                        Margin="0,0,0,0"
                                       HorizontalAlignment="Center"
                                AutomationProperties.Name="切换语义分析列"
                                       IsChecked="{Binding ShowSemanticColumn}">
                                <Path Classes="toolIcon" Width="20"
                                          Height="20"
                                          Data="{StaticResource glyph_graph_regular}">
                                    <ToolTip.Tip>切换语义分析列</ToolTip.Tip>
                                </Path>
                            </ToggleButton>

                            <!-- Toggle Geo Column -->
                            <ToggleButton DockPanel.Dock="Left"
                                         Margin="0,0,0,0"
                                        HorizontalAlignment="Center"
                                        IsChecked="{Binding ShowGeoColumn}"
                                AutomationProperties.Name="切换地理视图列"
                                        IsVisible="{Binding HasSemanticData}">
                                <Path Classes="toolIcon" Width="20"
                                          Height="20"
                                          Data="{StaticResource glyph_map_regular}">
                                    <ToolTip.Tip>切换地理视图列</ToolTip.Tip>
                                </Path>
                            </ToggleButton>

                            <!-- Toggle Enriched Column -->
                            <ToggleButton DockPanel.Dock="Left"
                                         Margin="0,0,0,0"
                                        HorizontalAlignment="Center"
                                        IsChecked="{Binding ShowEnrichedColumn}"
                                AutomationProperties.Name="切换富化实体列"
                                        IsVisible="{Binding HasSemanticData}">
                                <Path Classes="toolIcon" Width="20"
                                          Height="20"
                                          Data="{StaticResource glyph_tag_regular}">
                                    <ToolTip.Tip>切换富化实体列</ToolTip.Tip>
                                </Path>
                            </ToggleButton>

                            <!-- Toggle Term Column -->
                            <ToggleButton DockPanel.Dock="Left"
                                         Margin="0,0,0,0"
                                        HorizontalAlignment="Center"
                                        IsChecked="{Binding ShowTermColumn}"
                                AutomationProperties.Name="切换术语发现列"
                                        IsVisible="{Binding HasSemanticData}">
                                <Path Classes="toolIcon" Width="20"
                                          Height="20"
                                          Data="{StaticResource glyph_book_regular}">
                                    <ToolTip.Tip>切换术语发现列</ToolTip.Tip>
                                </Path>
                            </ToggleButton>

                            <!-- Alignment Report -->
						<Button DockPanel.Dock="Left"
                                Margin="5,0,0,0"
								HorizontalAlignment="Center"
								Command="{Binding GenerateAlignmentReportCommand}"
						    AutomationProperties.Name="生成 MinerU-Popo 对齐报告"
                                IsVisible="{Binding HasStructureDocument}">
							<Path Classes="toolIcon" Width="20"
									  Height="20"
									  Data="{StaticResource glyph_report_regular}">
								<ToolTip.Tip>生成 MinerU-Popo 对齐报告</ToolTip.Tip>
							</Path>
						</Button>

						<controls:VerticalSeparator/>

						<!-- GeoLibre JSON Export (visible when semantic data exists, enabled when loaded in memory) -->
						<Button DockPanel.Dock="Right"
                                Margin="0,0,5,0"
								HorizontalAlignment="Center"
                                Click="OnExportGeoLibreClick"
                                IsVisible="{Binding HasSemanticData}"
						    AutomationProperties.Name="导出到 GeoLibre"
                                IsEnabled="{Binding HasSemanticResults}">
							<Path Classes="toolIcon" Width="20"
									  Height="20"
									  Data="{StaticResource glyph_export_regular}"
									  Opacity="{Binding HasGeoLibreFile, Converter={StaticResource CompletedToOpacityConverter}}">
								<ToolTip.Tip>
									<TextBlock Text="{Binding ExportGeoLibreButtonTooltip}"/>
								</ToolTip.Tip>
							</Path>
						</Button>

						<!-- Term Process (visible when semantic data exists) -->
						<Button DockPanel.Dock="Right"
                                Margin="0,0,5,0"
								HorizontalAlignment="Center"
                                Click="OnTermProcessClick"
                                IsEnabled="{Binding CanProcessTerm}"
						    AutomationProperties.Name="术语发现"
                                IsVisible="{Binding HasSemanticData}">
							<Path Classes="toolIcon" Width="20"
									  Height="20"
									  Data="{StaticResource act_book_regular}"
									  Opacity="{Binding HasTermData, Converter={StaticResource CompletedToOpacityConverter}}">
								<ToolTip.Tip>
									<TextBlock Text="{Binding TermButtonTooltip}"/>
								</ToolTip.Tip>
							</Path>
						</Button>

						<!-- Enrich Entities (visible when semantic data exists) -->
						<Button DockPanel.Dock="Right"
                                Margin="0,0,5,0"
								HorizontalAlignment="Center"
                                Click="OnEnrichClick"
                                IsEnabled="{Binding CanEnrich}"
						    AutomationProperties.Name="富化实体"
                                IsVisible="{Binding HasSemanticData}">
							<Path Classes="toolIcon" Width="20"
									  Height="20"
									  Data="{StaticResource act_tag_regular}"
									  Opacity="{Binding HasEnrichedData, Converter={StaticResource CompletedToOpacityConverter}}">
								<ToolTip.Tip>
									<TextBlock Text="{Binding EnrichButtonTooltip}"/>
								</ToolTip.Tip>
							</Path>
						</Button>

						<!-- GeoJSON Generate (visible when semantic data exists, enabled when loaded in memory) -->
						<Button DockPanel.Dock="Right"
                                Margin="0,0,5,0"
								HorizontalAlignment="Center"
                                Click="OnGenerateGeoJsonClick"
                                IsVisible="{Binding HasSemanticData}"
						    AutomationProperties.Name="生成 GeoJSON"
                                IsEnabled="{Binding HasSemanticResults}">
							<Path Classes="toolIcon" Width="20"
									  Height="20"
									  Data="{StaticResource act_map_regular}"
									  Opacity="{Binding IsGeoCompleted, Converter={StaticResource CompletedToOpacityConverter}}">
								<ToolTip.Tip>
									<TextBlock Text="{Binding GeoButtonTooltip}"/>
								</ToolTip.Tip>
							</Path>
						</Button>

							<!-- NLP Analyze (visible when MinerU data exists) -->
						<Button DockPanel.Dock="Right"
                                  Margin="0,0,5,0"
								HorizontalAlignment="Center"
                                Click="OnSemanticProcessClick"
						    AutomationProperties.Name="NLP 语义分析"
                                  IsVisible="{Binding HasMinerUData}">
							<Path Classes="toolIcon" Width="20"
									  Height="20"
									  Data="{StaticResource act_graph_regular}"
									  Opacity="{Binding IsSemanticCompleted, Converter={StaticResource CompletedToOpacityConverter}}">
								<ToolTip.Tip>
									<TextBlock Text="{Binding SemanticButtonTooltip}"/>
								</ToolTip.Tip>
							</Path>
						</Button>

						<!-- Popo Process (always visible when MinerU ZIP exists, allows re-processing) -->
						<Button DockPanel.Dock="Right"
                                Margin="0,0,5,0"
								HorizontalAlignment="Center"
                                Click="OnPopoProcessClick"
						    AutomationProperties.Name="Popo 块分析"
                                IsVisible="{Binding HasMinerUZip}">
							<Path Classes="toolIcon" Width="20"
									  Height="20"
									  Data="{StaticResource act_link_regular}"
									  Opacity="{Binding IsPopoCompleted, Converter={StaticResource CompletedToOpacityConverter}}">
								<ToolTip.Tip>
									<TextBlock Text="{Binding PopoButtonTooltip}"/>
								</ToolTip.Tip>
							</Path>
						</Button>

						<!-- MinerU AI Parse -->
						<Button DockPanel.Dock="Right"
                                Margin="0,0,5,0"
								HorizontalAlignment="Center"
                                Click="OnMinerUParseClick"
						    AutomationProperties.Name="MinerU 解析"
                                IsVisible="{Binding MinerUEnabled}">
							<Path Classes="toolIcon" Width="20"
									  Height="20"
									  Data="{StaticResource act_blocks_regular}"
									  Opacity="{Binding IsMinerUCompleted, Converter={StaticResource CompletedToOpacityConverter}}">
								<ToolTip.Tip>
									<TextBlock Text="{Binding MinerUButtonTooltip}"/>
								</ToolTip.Tip>
							</Path>
						</Button>

						<!-- Print -->
						<Button DockPanel.Dock="Right"
                                Margin="0,0,5,0"
								HorizontalAlignment="Center"
						    AutomationProperties.Name="打印"
								Command="{Binding PrintCommand}">
							<Path Classes="toolIcon" Width="20"
									  Height="20"
									  Data="{StaticResource glyph_print_regular}">
								<ToolTip.Tip>打印</ToolTip.Tip>
							</Path>
						</Button>

						<Grid/>

					</DockPanel>

					<SplitView Grid.Row="1"
							   Name="PART_SplitView"
							   IsPaneOpen="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).IsDocumentPaneOpen, Mode=TwoWay}"
							   OpenPaneLength="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).PaneSize, Mode=TwoWay}"
							   CompactPaneLength="0"
							   DisplayMode="CompactInline">

                    <!-- Three-column layout: PDF | MinerU Blocks | Popo Blocks -->
                    <SplitView.Content>
                        <Grid>
                            <Grid Name="PART_ThreeColumnGrid">
                             <Grid.ColumnDefinitions>
                                 <ColumnDefinition Width="*"/>
                                 <ColumnDefinition Width="{Binding ShowMinerUColumn, Converter={StaticResource BoolToGridLengthConverter}}"/>
                                 <ColumnDefinition Width="{Binding ShowAnalysisColumn, Converter={StaticResource BoolToGridLengthConverter}}"/>
                                 <ColumnDefinition Width="{Binding ShowSemanticColumn, Converter={StaticResource BoolToGridLengthConverter}}"/>
                                 <ColumnDefinition Width="{Binding ShowGeoColumn, Converter={StaticResource BoolToGridLengthConverter}}"/>
                                 <ColumnDefinition Width="{Binding ShowEnrichedColumn, Converter={StaticResource BoolToGridLengthConverter}}"/>
                                 <ColumnDefinition Width="{Binding ShowTermColumn, Converter={StaticResource BoolToGridLengthConverter}}"/>
                             </Grid.ColumnDefinitions>

                            <!-- Column 1: PDF Document -->
                            <controls:DocumentControl Grid.Column="0"
                                                     Name="PART_DocumentControl"/>

                            <!-- GridSplitter between PDF and MinerU -->
                            <GridSplitter Grid.Column="0"
                                          HorizontalAlignment="Right"
                                          Width="4"
                                          Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                          IsVisible="{Binding ShowMinerUColumn}"/>

                            <!-- Column 2: MinerU Blocks with In-Place Progress -->
                            <Border Grid.Column="1"
                                    Padding="8"
                                    Background="{DynamicResource SystemChromeLowColor}"
                                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                    BorderThickness="1"
                                    IsVisible="{Binding ShowMinerUColumn}">
                                <DockPanel>
                                     <!-- Header -->
                                     <StackPanel DockPanel.Dock="Top"
                                                 Orientation="Horizontal"
                                                 Spacing="4"
                                                 Margin="0,0,0,6">
                                         <TextBlock Text="MinerU"
                                                    FontWeight="Bold"
                                                    FontSize="12"/>
                                         <TextBlock Text="{Binding VisiblePagesText}"
                                                    FontSize="11"
                                                    Opacity="0.6"
                                                    IsVisible="{Binding !IsMinerUParsing}"/>
                                         <TextBlock Text="{Binding VisibleMinerUBlocks.Count, StringFormat='({0} blocks)'}"
                                                    FontSize="11"
                                                    Opacity="0.6"
                                                    IsVisible="{Binding !IsMinerUParsing}"/>
                                     </StackPanel>

                                     <!-- Progress State: shown during parsing -->
                                     <Border IsVisible="{Binding IsMinerUParsing}"
                                             VerticalAlignment="Center"
                                             HorizontalAlignment="Stretch">
                                         <StackPanel VerticalAlignment="Center"
                                                     HorizontalAlignment="Center"
                                                     Spacing="12">
                                             <!-- Spinner -->
                                             <PathIcon Width="32"
                                                       Height="32"
                                                       Data="{StaticResource spinner_regular}"
                                                       Foreground="{DynamicResource SystemAccentColor}"
                                                       HorizontalAlignment="Center"/>

                                             <!-- Status Text -->
                                             <TextBlock Text="{Binding MinerUStatusText}"
                                                        FontSize="13"
                                                        HorizontalAlignment="Center"
                                                        TextAlignment="Center"/>

                                             <!-- Progress Bar -->
                                             <ProgressBar Width="200"
                                                          Minimum="0"
                                                          Maximum="100"
                                                          Value="{Binding MinerUProgress}"
                                                          HorizontalAlignment="Center"/>

                                             <!-- Progress Percentage -->
                                             <TextBlock Text="{Binding MinerUProgress, StringFormat='{}{0}%'}"
                                                        FontSize="11"
                                                        HorizontalAlignment="Center"
                                                        Opacity="0.7"/>

                                             <!-- Cancel Button -->
                                             <Button Content="取消"
                                                     Command="{Binding CancelMinerUParseCommand}"
                                                     HorizontalAlignment="Center"
                                                 AutomationProperties.Name="取消 MinerU 解析"
                                                     Padding="20,4"/>
                                         </StackPanel>
                                     </Border>

                                     <!-- Error/Failed State: shown when parsing failed -->
                                     <Border IsVisible="{Binding MinerUStatus, Converter={StaticResource EqualsConverter}, ConverterParameter={x:Static models:MinerUParseStatus.Failed}}"
                                             VerticalAlignment="Center"
                                             HorizontalAlignment="Stretch"
                                             Padding="12"
                                             Background="{DynamicResource CalyAlertCardBackgroundBrush}"
                                             CornerRadius="4">
                                         <StackPanel Spacing="8"
                                                     HorizontalAlignment="Center">
                                             <TextBlock Text="{Binding MinerUStatusText}"
                                                        FontSize="12"
                                                        Foreground="{DynamicResource CalyAlertCardForegroundBrush}"
                                                        TextAlignment="Center"
                                                        TextWrapping="Wrap"/>
                                             <Button Content="重试"
                                                     Command="{Binding ParseWithMinerUCommand}"
                                                     HorizontalAlignment="Center"
                                                 AutomationProperties.Name="重新解析"
                                                     Padding="20,4"/>
                                         </StackPanel>
                                     </Border>

                                     <!-- Blocks List: shown when not parsing and no error -->
                                     <ScrollViewer Name="PART_MinerUScrollViewer"
                                                      IsVisible="{Binding ShowMinerUBlocksList}"
                                                      ScrollChanged="OnMinerUScrollChanged">
                                           <ItemsControl Name="PART_MinerUItemsControl"
                                                         ItemsSource="{Binding VisibleMinerUBlocks}">
                                              <ItemsControl.ItemTemplate>
                                                  <DataTemplate x:DataType="vm:MinerUBlockViewModel">
                                                      <Border Padding="6"
                                                              Margin="0,2"
                                                              Background="{DynamicResource SystemChromeMediumLowColor}"
                                                              CornerRadius="3"
                                                              BorderThickness="1.5"
                                                              BorderBrush="{Binding BorderBrush}"
                                                              ToolTip.Tip="{Binding IdentifiersToolTip}"
                                                              PointerPressed="MinerUBlock_OnPointerPressed"
                                                              Loaded="MinerUBlockBorder_OnLoaded">
                                                          <StackPanel Spacing="3">
                                                              <StackPanel Orientation="Horizontal"
                                                                          Spacing="4">
                                                                  <!-- Auto 1-based index within the page; same badge style as the PDF overlay -->
                                                                  <Border Padding="4,1"
                                                                          CornerRadius="3"
                                                                          Background="{DynamicResource CalyScrimStrongBrush}"
                                                                          VerticalAlignment="Center">
                                                                      <TextBlock Text="{Binding IndexLabel}"
                                                                                 FontSize="11"
                                                                                 FontWeight="Bold"
                                                                                 Foreground="{DynamicResource CalyOnSolidBrush}"/>
                                                                  </Border>
                                                                  <TextBlock Text="{Binding TypeLabel}"
                                                                             FontSize="11"
                                                                             FontWeight="SemiBold"/>
                                                                  <!-- Source Badge: only visible for para/discarded blocks -->
                                                                  <Border Padding="2,1"
                                                                          CornerRadius="2"
                                                                          IsVisible="{Binding HasSourceBadge}"
                                                                          Background="{Binding BadgeBackground}"
                                                                          Opacity="0.8">
                                                                      <TextBlock Text="{Binding SourceBadgeText}"
                                                                                 FontSize="11"
                                                                                 Foreground="{DynamicResource CalyOnSolidBrush}"
                                                                                 TextAlignment="Center"
                                                                                 VerticalAlignment="Center"/>
                                                                  </Border>
                                                              </StackPanel>

                                                              <!-- Image display for image blocks -->
                                                              <Border IsVisible="{Binding IsImage}"
                                                                      MaxHeight="200"
                                                                      CornerRadius="3"
                                                                      ClipToBounds="True"
                                                                      Margin="0,2,0,0">
                                                                  <Grid>
                                                                      <Image Source="{Binding ImageBitmap}"
                                                                             Stretch="Uniform"
                                                                             HorizontalAlignment="Stretch"
                                                                             VerticalAlignment="Stretch"/>
                                                                      <TextBlock Text="{Binding ImagePathText}"
                                                                                 FontSize="11"
                                                                                 Foreground="{DynamicResource CalyWarningForegroundBrush}"
                                                                                 TextWrapping="Wrap"
                                                                                 VerticalAlignment="Center"
                                                                                 HorizontalAlignment="Center"
                                                                                 IsVisible="{Binding !HasImageBitmap}"/>
                                                                  </Grid>
                                                              </Border>

                                                              <!-- Content preview for non-image blocks -->
                                                              <TextBlock Text="{Binding ContentPreview}"
                                                                         FontSize="11"
                                                                         TextWrapping="Wrap"
                                                                         Opacity="0.8"
                                                                         MaxLines="3"
                                                                         IsVisible="{Binding !IsImage}"/>
                                                          </StackPanel>
                                                      </Border>
                                                  </DataTemplate>
                                              </ItemsControl.ItemTemplate>
                                          </ItemsControl>
                                      </ScrollViewer>
                                </DockPanel>
                            </Border>

                            <!-- GridSplitter between MinerU and Popo -->
                            <GridSplitter Grid.Column="1"
                                          HorizontalAlignment="Right"
                                          Width="4"
                                          Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                          IsVisible="{Binding ShowAnalysisColumn}"/>

                            <!-- Column 3: Popo Blocks with In-Place Progress -->
                            <Border Grid.Column="2"
                                    Padding="8"
                                    Background="{DynamicResource SystemChromeLowColor}"
                                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                    BorderThickness="1"
                                    IsVisible="{Binding ShowAnalysisColumn}">
                                <DockPanel>
                                     <!-- Header -->
                                     <Grid DockPanel.Dock="Top"
                                           Margin="0,0,0,6"
                                           ColumnDefinitions="*,Auto">
                                         <StackPanel Grid.Column="0"
                                                     Orientation="Horizontal"
                                                     Spacing="4">
                                             <TextBlock Text="Popo"
                                                        FontWeight="Bold"
                                                        FontSize="12"/>
                                             <TextBlock Text="{Binding PopoTreeNodeCount, StringFormat='({0} nodes)'}"
                                                        FontSize="11"
                                                        Opacity="0.6"
                                                        IsVisible="{Binding !IsPopoProcessing}"/>
                                         </StackPanel>
                                         <StackPanel Grid.Column="1"
                                                     Orientation="Horizontal"
                                                     Spacing="4">
                                             <Button Content="目录"
                                                     Command="{Binding GenerateTocCommand}"
                                                     IsEnabled="{Binding CanGenerateToc}"
                                                     IsVisible="{Binding !IsPopoProcessing}"
                                                     MinWidth="60"
                                                 AutomationProperties.Name="生成目录"
                                                     FontSize="11"/>
                                             <Button Content="参考文献"
                                                     Command="{Binding GenerateReferencesCommand}"
                                                     IsEnabled="{Binding CanGenerateReferences}"
                                                     IsVisible="{Binding !IsPopoProcessing}"
                                                     MinWidth="60"
                                                 AutomationProperties.Name="生成参考文献"
                                                     FontSize="11"/>
                                         </StackPanel>
                                     </Grid>

                                     <!-- Progress State: shown during Popo processing -->
                                     <Border IsVisible="{Binding IsPopoProcessing}"
                                             VerticalAlignment="Center"
                                             HorizontalAlignment="Stretch">
                                         <StackPanel VerticalAlignment="Center"
                                                     HorizontalAlignment="Center"
                                                     Spacing="12">
                                             <!-- Spinner -->
                                             <PathIcon Width="32"
                                                       Height="32"
                                                       Data="{StaticResource spinner_regular}"
                                                       Foreground="{DynamicResource SystemAccentColor}"
                                                       HorizontalAlignment="Center"/>

                                             <!-- Status Text -->
                                             <TextBlock Text="{Binding PopoStatusText}"
                                                        FontSize="13"
                                                        HorizontalAlignment="Center"
                                                        TextAlignment="Center"/>

                                             <!-- Progress Bar -->
                                             <ProgressBar Width="200"
                                                          Minimum="0"
                                                          Maximum="100"
                                                          Value="{Binding PopoProgress}"
                                                          HorizontalAlignment="Center"/>

                                             <!-- Progress Percentage -->
                                             <TextBlock Text="{Binding PopoProgress, StringFormat='{}{0}%'}"
                                                        FontSize="11"
                                                        HorizontalAlignment="Center"
                                                        Opacity="0.7"/>

                                              <!-- Detailed Progress Message from Popo API -->
                                              <TextBlock Text="{Binding PopoProgressMessage}"
                                                         FontSize="11"
                                                         HorizontalAlignment="Center"
                                                         TextAlignment="Center"
                                                         Opacity="0.5"
                                                         TextWrapping="Wrap"
                                                         MaxWidth="250"
                                                         IsVisible="{Binding PopoProgressMessage, Converter={StaticResource IsNotNullConverter}}"/>

                                             <!-- Cancel Button -->
                                             <Button Content="取消"
                                                     Command="{Binding CancelPopoProcessCommand}"
                                                     HorizontalAlignment="Center"
                                                 AutomationProperties.Name="取消 Popo 处理"
                                                     Padding="20,4"/>
                                         </StackPanel>
                                     </Border>

                                    <!-- Error/Status Message: shown when processing failed -->
                                    <Border IsVisible="{Binding PopoStatus, Converter={StaticResource EqualsConverter}, ConverterParameter={x:Static services:PopoProcessStatus.Failed}}"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Stretch"
                                            Padding="12"
                                            Background="{DynamicResource CalyAlertCardBackgroundBrush}"
                                            CornerRadius="4">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="{Binding PopoStatusText}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource CalyAlertCardForegroundBrush}"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"/>
                                            <Button Content="重试"
                                                    Command="{Binding ProcessWithPopoCommand}"
                                                    HorizontalAlignment="Center"
                                                AutomationProperties.Name="重新处理"
                                                    Padding="20,4"/>
                                        </StackPanel>
                                    </Border>

                                      <!-- Blocks List: shown only when not processing and no error -->
                                      <ScrollViewer Name="PART_PopoScrollViewer"
                                                    IsVisible="{Binding ShowPopoBlocksList}"
                                                    HorizontalScrollBarVisibility="Disabled"
                                                    ScrollChanged="OnPopoScrollChanged">
                                           <TreeView Name="PART_PopoTreeView"
                                                     ItemsSource="{Binding PopoTreeRootChildren}"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                             <TreeView.Styles>
                                                 <Style Selector="TreeViewItem">
                                                     <Setter Property="IsExpanded" Value="True"/>
                                                 </Style>
                                             </TreeView.Styles>
                                             <TreeView.ItemTemplate>
                                                 <TreeDataTemplate x:DataType="vm:TreeNodeViewModel"
                                                                   ItemsSource="{Binding Children}">
                                                       <Border Padding="6,4"
                                                               Margin="0,1"
                                                               CornerRadius="3"
                                                               Background="{DynamicResource SystemChromeMediumLowColor}"
                                                               HorizontalAlignment="Stretch"
                                                               SizeChanged="PopoTreeNodeBorder_OnSizeChanged">
                                                          <StackPanel Spacing="2"
                                                                      HorizontalAlignment="Stretch">
                                                             <!-- Type badge + title -->
                                                             <Grid ColumnDefinitions="Auto,*,Auto">
                                                                 <Border Grid.Column="0"
                                                                         Padding="2,0"
                                                                         CornerRadius="2"
                                                                         Background="{Binding TypeColorHex}"
                                                                         Margin="4,0,6,0">
                                                                     <TextBlock Text="{Binding Type}"
                                                                                FontSize="11"
                                                                                FontWeight="SemiBold"
                                                                                Foreground="{DynamicResource CalyOnSolidBrush}"
                                                                                TextAlignment="Center"/>
                                                                  </Border>
                                                                   <TextBlock Grid.Column="1"
                                                                              Text="{Binding DisplayTitle}"
                                                                              FontSize="11"
                                                                              FontWeight="SemiBold"
                                                                              MaxLines="1"
                                                                              TextTrimming="CharacterEllipsis"
                                                                              VerticalAlignment="Center"
                                                                              HorizontalAlignment="Stretch"
                                                                              TextAlignment="Left"/>
                                                                  <TextBlock Grid.Column="2"
                                                                             Text="{Binding PageRange}"
                                                                             FontSize="11"
                                                                             Foreground="{DynamicResource CalyAccentLightBlueBrush}"
                                                                             VerticalAlignment="Center"
                                                                             Margin="6,0,4,0"/>
                                                              </Grid>

                                                               <!-- Image display for image nodes -->
                                                               <Border IsVisible="{Binding IsImage}"
                                                                       MaxHeight="200"
                                                                       CornerRadius="3"
                                                                       ClipToBounds="True"
                                                                       Margin="0,2,0,0">
                                                                   <Grid>
                                                                       <Image Source="{Binding ImageBitmap}"
                                                                              Stretch="Uniform"
                                                                              HorizontalAlignment="Stretch"
                                                                              VerticalAlignment="Stretch"/>
                                                                       <TextBlock Text="{Binding ImagePathText}"
                                                                                  FontSize="11"
                                                                                  Foreground="{DynamicResource CalyWarningForegroundBrush}"
                                                                                  TextWrapping="Wrap"
                                                                                  VerticalAlignment="Center"
                                                                                  HorizontalAlignment="Center"
                                                                                  IsVisible="{Binding !HasImageBitmap}"/>
                                                                   </Grid>
                                                               </Border>

                                                              <!-- Content preview (collapsed, non-image nodes) -->
                                                              <TextBlock Text="{Binding ContentPreview}"
                                                                         FontSize="11"
                                                                         Opacity="0.7"
                                                                         MaxLines="2"
                                                                         TextTrimming="CharacterEllipsis"
                                                                         IsVisible="{Binding ShowContentPreview}"
                                                                         HorizontalAlignment="Stretch"
                                                                         TextAlignment="Left"/>

                                                              <!-- Full content (expanded, non-image nodes) -->
                                                              <TextBlock Text="{Binding DisplayContent}"
                                                                         FontSize="11"
                                                                         Opacity="0.8"
                                                                         TextWrapping="Wrap"
                                                                         IsVisible="{Binding ShowFullContent}"
                                                                         HorizontalAlignment="Stretch"
                                                                         TextAlignment="Left"/>

                                                              <!-- Structured table (table_data / table_key_value / legacy HTML table) -->
                                                              <Button 
                                                                      FontSize="11"
                                                                      Padding="4,1"
                                                                      HorizontalAlignment="Right"
                                                                      Background="Transparent"
                                                                      BorderThickness="0"
                                                                      IsVisible="{Binding CanCopyTable}"
                                                                  AutomationProperties.Name="复制 Markdown"
                                                                      Click="OnCopyTableMarkdownClick">
                                                                  <Path Classes="toolIcon" Width="13" Height="13" Data="{StaticResource glyph_copy_regular}"/>
                                                                  <ToolTip.Tip>复制 Markdown</ToolTip.Tip>
                                                              </Button>
                                                              <DataGrid ItemsSource="{Binding TableRows}"
                                                                        AutoGenerateColumns="False"
                                                                        HeadersVisibility="{Binding TableHeadersVisibility}"
                                                                        GridLinesVisibility="Horizontal"
                                                                        FontSize="11"
                                                                        MaxHeight="200"
                                                                        HorizontalAlignment="Stretch"
                                                                        IsVisible="{Binding ShowTableGrid}"
                                                                        Loaded="OnTableDataGridLoaded"
                                                                        DataContextChanged="OnTableDataGridDataContextChanged"/>
                                                             <!-- Expand/Collapse button for long content -->
                                                             <Button Command="{Binding ToggleContentExpandCommand}"
                                                                     HorizontalAlignment="Right"
                                                                     VerticalAlignment="Bottom"
                                                                     Padding="6,2"
                                                                     FontSize="11"
                                                                     Background="Transparent"
                                                                     BorderThickness="0"
                                                                 AutomationProperties.Name="展开或折叠内容"
                                                                     ToolTip.Tip="展开或折叠这段内容"
                                                                     IsVisible="{Binding CanToggleContentExpand}">
                                                                 <Button.Content>
                                                                     <StackPanel Orientation="Horizontal" Spacing="2">
                                                                         <TextBlock Text="展开"
                                                                                    IsVisible="{Binding !IsContentExpanded}"/>
                                                                         <TextBlock Text="折叠"
                                                                                    IsVisible="{Binding IsContentExpanded}"/>
                                                                     </StackPanel>
                                                                 </Button.Content>
                                                             </Button>
                                                         </StackPanel>
                                                     </Border>
                                                 </TreeDataTemplate>
                                             </TreeView.ItemTemplate>
                                         </TreeView>
                                     </ScrollViewer>
                                </DockPanel>
                            </Border>

                            <!-- GridSplitter between Popo and Semantic -->
                            <GridSplitter Grid.Column="2"
                                          HorizontalAlignment="Right"
                                          Width="4"
                                          Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                          IsVisible="{Binding ShowSemanticColumn}"/>

                            <!-- Column 4: Semantic Analysis -->
                            <Border Grid.Column="3"
                                    Padding="8"
                                    Background="{DynamicResource SystemChromeLowColor}"
                                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                    BorderThickness="1"
                                    IsVisible="{Binding ShowSemanticColumn}">
                                <DockPanel>
                                    <!-- Header -->
                                    <Grid DockPanel.Dock="Top"
                                          Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="4">
                                            <TextBlock Text="Semantic"
                                                       FontWeight="Bold"
                                                       FontSize="12"/>
                                            <TextBlock Text="{Binding SemanticNodeCount, StringFormat='({0} nodes)'}"
                                                       FontSize="11"
                                                       Opacity="0.6"
                                                       IsVisible="{Binding !IsSemanticProcessing}"/>
                                            <TextBlock Text="{Binding SemanticEntityCount, StringFormat='({0} entities)'}"
                                                       FontSize="11"
                                                       Opacity="0.4"
                                                       IsVisible="{Binding !IsSemanticProcessing}"/>
                                        </StackPanel>
                                        <Button Content="公式"
                                                HorizontalAlignment="Right"
                                                Command="{Binding OpenFormulaPanelCommand}"
                                                IsVisible="{Binding !IsSemanticProcessing}"
                                                MinWidth="50"
                                            AutomationProperties.Name="公式索引"
                                                FontSize="11"/>
                                    </Grid>

                                    <!-- Progress State: shown during NLP processing -->
                                    <Border IsVisible="{Binding IsSemanticProcessing}"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Stretch">
                                        <StackPanel VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"
                                                    Spacing="12">
                                            <PathIcon Width="32"
                                                      Height="32"
                                                      Data="{StaticResource spinner_regular}"
                                                      Foreground="{DynamicResource SystemAccentColor}"
                                                      HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding SemanticStatusText}"
                                                       FontSize="13"
                                                       HorizontalAlignment="Center"
                                                       TextAlignment="Center"/>
                                            <ProgressBar Width="200"
                                                         Minimum="0"
                                                         Maximum="100"
                                                         Value="{Binding SemanticProgress}"
                                                         HorizontalAlignment="Center"/>
                                            <!-- Progress Percentage -->
                                            <TextBlock Text="{Binding SemanticProgress, StringFormat='{}{0}%'}"
                                                       FontSize="11"
                                                       HorizontalAlignment="Center"
                                                       Opacity="0.7"/>
                                            <Button Content="取消"
                                                    Command="{Binding CancelSemanticProcessCommand}"
                                                    HorizontalAlignment="Center"
                                                AutomationProperties.Name="取消语义分析"
                                                    Padding="20,4"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Error State -->
                                    <Border IsVisible="{Binding SemanticStatus, Converter={StaticResource EqualsConverter}, ConverterParameter=Failed}"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Stretch"
                                            Padding="12"
                                            Background="{DynamicResource CalyAlertCardBackgroundBrush}"
                                            CornerRadius="4">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="{Binding SemanticStatusText}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource CalyAlertCardForegroundBrush}"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"/>
                                            <Button Content="重试"
                                                    Command="{Binding ProcessWithSemanticCommand}"
                                                    HorizontalAlignment="Center"
                                                AutomationProperties.Name="重新分析"
                                                    Padding="20,4"/>
                                        </StackPanel>
                                    </Border>

                                       <!-- Placeholder when no results -->
                                      <Border IsVisible="{Binding ShowSemanticPlaceholder}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Stretch"
                                              Padding="16">
                                          <StackPanel Spacing="8"
                                                      HorizontalAlignment="Center">
                                              <TextBlock Text="NLP 分析"
                                                         FontSize="14"
                                                         FontWeight="SemiBold"
                                                         HorizontalAlignment="Center"/>
                                              <TextBlock Text="点击“NLP 分析”开始处理 Popo 内容块"
                                                         FontSize="11"
                                                         Opacity="0.6"
                                                         TextAlignment="Center"/>
                                          </StackPanel>
                                      </Border>

                                      <!-- Semantic Results List -->
                                      <ScrollViewer Name="PART_SemanticScrollViewer"
                                                    IsVisible="{Binding ShowSemanticBlocksList}"
                                                    ScrollChanged="OnSemanticScrollChanged">
                                          <StackPanel Spacing="6">
                                              <ItemsControl ItemsSource="{Binding SemanticBlockViewModels}">
                                                  <ItemsControl.ItemTemplate>
                                                      <DataTemplate x:DataType="vm:SemanticBlockViewModel">
                                                          <Border Padding="8"
                                                                  Margin="0,2"
                                                                  Background="{DynamicResource SystemChromeMediumLowColor}"
                                                                  CornerRadius="4"
                                                                  BorderThickness="1"
                                                                  BorderBrush="{DynamicResource SystemControlTransparentBrush}">
                                                              <StackPanel Spacing="6">
                                                                  <!-- Popo node header: type badge + title -->
                                                                  <Grid ColumnDefinitions="Auto,*,Auto"
                                                                        IsVisible="{Binding HasTitleOrType}">
                                                                      <Border Grid.Column="0"
                                                                              Padding="3,2"
                                                                              CornerRadius="2"
                                                                              Background="{Binding TypeColorHex}"
                                                                              Margin="0,0,6,0">
                                                                          <TextBlock Text="{Binding Type}"
                                                                                     FontSize="11"
                                                                                     FontWeight="SemiBold"
                                                                                     Foreground="{DynamicResource CalyOnSolidBrush}"
                                                                                     TextAlignment="Center"/>
                                                                      </Border>
                                                                      <TextBlock Grid.Column="1"
                                                                                 Text="{Binding Title}"
                                                                                 FontSize="11"
                                                                                 FontWeight="SemiBold"
                                                                                 MaxLines="1"
                                                                                 TextTrimming="CharacterEllipsis"
                                                                                 VerticalAlignment="Center"/>
                                                                      <TextBlock Grid.Column="2"
                                                                                 Text="{Binding EntitySummary}"
                                                                                 FontSize="11"
                                                                                 Foreground="{DynamicResource CalyAccentLightBlueBrush}"
                                                                                 VerticalAlignment="Center"
                                                                                 Margin="6,0,0,0"/>
                                                                  </Grid>

                                                                  <!-- Content preview -->
                                                                  <TextBlock Text="{Binding ContentPreview}"
                                                                             FontSize="11"
                                                                             Opacity="0.6"
                                                                             MaxLines="2"
                                                                             TextTrimming="CharacterEllipsis"
                                                                             IsVisible="{Binding HasContent}"
                                                                             HorizontalAlignment="Stretch"
                                                                             TextAlignment="Left"/>

                                                                   <!-- Entities grouped by category -->
                                                                   <StackPanel Spacing="4"
                                                                               IsVisible="{Binding HasEntities}">
                                                                       <!-- LOCATION entities -->
                                                                       <StackPanel Spacing="2"
                                                                                   IsVisible="{Binding LocationEntities.Count}">
                                                                           <TextBlock Text="地点"
                                                                                      FontSize="11"
                                                                                      FontWeight="SemiBold"
                                                                                      Foreground="{DynamicResource CalyAccentGreenBrush}"
                                                                                      Opacity="0.8"
                                                                                      Margin="0,0,0,2"/>
                                                                           <ItemsControl ItemsSource="{Binding LocationEntities}">
                                                                               <ItemsControl.ItemsPanel>
                                                                                   <ItemsPanelTemplate>
                                                                                       <WrapPanel/>
                                                                                   </ItemsPanelTemplate>
                                                                               </ItemsControl.ItemsPanel>
                                                                               <ItemsControl.ItemTemplate>
                                                                                   <DataTemplate x:DataType="models:SemanticEntity">
                                                                                       <Border Padding="4,2"
                                                                                               Margin="0,0,2,2"
                                                                                               CornerRadius="2"
                                                                                               Background="{DynamicResource CalyTagGreenBackgroundBrush}"
                                                                                               BorderThickness="0.8"
                                                                                               BorderBrush="{DynamicResource CalyTagGreenBorderBrush}">
                                                                                           <TextBlock Text="{Binding Text}"
                                                                                                      FontSize="11"
                                                                                                      FontWeight="Medium"
                                                                                                      Foreground="{DynamicResource CalyTagGreenForegroundBrush}"/>
                                                                                       </Border>
                                                                                   </DataTemplate>
                                                                               </ItemsControl.ItemTemplate>
                                                                           </ItemsControl>
                                                                       </StackPanel>

                                                                       <!-- DATE entities -->
                                                                       <StackPanel Spacing="2"
                                                                                   IsVisible="{Binding DateEntities.Count}">
                                                                           <TextBlock Text="时间"
                                                                                      FontSize="11"
                                                                                      FontWeight="SemiBold"
                                                                                      Foreground="{DynamicResource CalyAccentAmberBrush}"
                                                                                      Opacity="0.8"
                                                                                      Margin="0,0,0,2"/>
                                                                           <ItemsControl ItemsSource="{Binding DateEntities}">
                                                                               <ItemsControl.ItemsPanel>
                                                                                   <ItemsPanelTemplate>
                                                                                       <WrapPanel/>
                                                                                   </ItemsPanelTemplate>
                                                                               </ItemsControl.ItemsPanel>
                                                                               <ItemsControl.ItemTemplate>
                                                                                   <DataTemplate x:DataType="models:SemanticEntity">
                                                                                       <Border Padding="4,2"
                                                                                               Margin="0,0,2,2"
                                                                                               CornerRadius="2"
                                                                                               Background="{DynamicResource CalyTagAmberBackgroundBrush}"
                                                                                               BorderThickness="0.8"
                                                                                               BorderBrush="{DynamicResource CalyTagAmberBorderBrush}">
                                                                                           <TextBlock Text="{Binding Text}"
                                                                                                      FontSize="11"
                                                                                                      FontWeight="Medium"
                                                                                                      Foreground="{DynamicResource CalyTagAmberForegroundBrush}"/>
                                                                                       </Border>
                                                                                   </DataTemplate>
                                                                               </ItemsControl.ItemTemplate>
                                                                           </ItemsControl>
                                                                       </StackPanel>

                                                                       <!-- PERSON entities -->
                                                                       <StackPanel Spacing="2"
                                                                                   IsVisible="{Binding PersonEntities.Count}">
                                                                           <TextBlock Text="人物"
                                                                                      FontSize="11"
                                                                                      FontWeight="SemiBold"
                                                                                      Foreground="{DynamicResource CalyAccentBlueBrush}"
                                                                                      Opacity="0.8"
                                                                                      Margin="0,0,0,2"/>
                                                                           <ItemsControl ItemsSource="{Binding PersonEntities}">
                                                                               <ItemsControl.ItemsPanel>
                                                                                   <ItemsPanelTemplate>
                                                                                       <WrapPanel/>
                                                                                   </ItemsPanelTemplate>
                                                                               </ItemsControl.ItemsPanel>
                                                                               <ItemsControl.ItemTemplate>
                                                                                   <DataTemplate x:DataType="models:SemanticEntity">
                                                                                       <Border Padding="4,2"
                                                                                               Margin="0,0,2,2"
                                                                                               CornerRadius="2"
                                                                                               Background="{DynamicResource CalyTagBlueBackgroundBrush}"
                                                                                               BorderThickness="0.8"
                                                                                               BorderBrush="{DynamicResource CalyTagBlueBorderBrush}">
                                                                                           <TextBlock Text="{Binding Text}"
                                                                                                      FontSize="11"
                                                                                                      FontWeight="Medium"
                                                                                                      Foreground="{DynamicResource CalyTagBlueForegroundBrush}"/>
                                                                                       </Border>
                                                                                   </DataTemplate>
                                                                               </ItemsControl.ItemTemplate>
                                                                           </ItemsControl>
                                                                       </StackPanel>

                                                                       <!-- NUMBER entities -->
                                                                       <StackPanel Spacing="2"
                                                                                   IsVisible="{Binding NumberEntities.Count}">
                                                                           <TextBlock Text="数值"
                                                                                      FontSize="11"
                                                                                      FontWeight="SemiBold"
                                                                                      Foreground="{DynamicResource CalyTagVioletForegroundBrush}"
                                                                                      Opacity="0.8"
                                                                                      Margin="0,0,0,2"/>
                                                                           <ItemsControl ItemsSource="{Binding NumberEntities}">
                                                                               <ItemsControl.ItemsPanel>
                                                                                   <ItemsPanelTemplate>
                                                                                       <WrapPanel/>
                                                                                   </ItemsPanelTemplate>
                                                                               </ItemsControl.ItemsPanel>
                                                                               <ItemsControl.ItemTemplate>
                                                                                   <DataTemplate x:DataType="models:SemanticEntity">
                                                                                       <Border Padding="4,2"
                                                                                               Margin="0,0,2,2"
                                                                                               CornerRadius="2"
                                                                                               Background="{DynamicResource CalyTagPurpleBackgroundBrush}"
                                                                                               BorderThickness="0.8"
                                                                                               BorderBrush="{DynamicResource CalyTagPurpleBorderBrush}">
                                                                                           <TextBlock Text="{Binding Text}"
                                                                                                      FontSize="11"
                                                                                                      FontWeight="Medium"
                                                                                                      Foreground="{DynamicResource CalyTagPurpleForegroundBrush}"/>
                                                                                       </Border>
                                                                                   </DataTemplate>
                                                                               </ItemsControl.ItemTemplate>
                                                                           </ItemsControl>
                                                                       </StackPanel>

                                                                       <!-- FACILITY entities -->
                                                                       <StackPanel Spacing="2"
                                                                                   IsVisible="{Binding FacilityEntities.Count}">
                                                                           <TextBlock Text="设施"
                                                                                      FontSize="11"
                                                                                      FontWeight="SemiBold"
                                                                                      Foreground="{DynamicResource CalyTagSteelForegroundBrush}"
                                                                                      Opacity="0.8"
                                                                                      Margin="0,0,0,2"/>
                                                                           <ItemsControl ItemsSource="{Binding FacilityEntities}">
                                                                               <ItemsControl.ItemsPanel>
                                                                                   <ItemsPanelTemplate>
                                                                                       <WrapPanel/>
                                                                                   </ItemsPanelTemplate>
                                                                               </ItemsControl.ItemsPanel>
                                                                               <ItemsControl.ItemTemplate>
                                                                                   <DataTemplate x:DataType="models:SemanticEntity">
                                                                                       <Border Padding="4,2"
                                                                                               Margin="0,0,2,2"
                                                                                               CornerRadius="2"
                                                                                               Background="{DynamicResource CalyTagSlateBackgroundBrush}"
                                                                                               BorderThickness="0.8"
                                                                                               BorderBrush="{DynamicResource CalyTagSlateBorderBrush}">
                                                                                           <TextBlock Text="{Binding Text}"
                                                                                                      FontSize="11"
                                                                                                      FontWeight="Medium"
                                                                                                      Foreground="{DynamicResource CalyTagSlateForegroundBrush}"/>
                                                                                       </Border>
                                                                                   </DataTemplate>
                                                                               </ItemsControl.ItemTemplate>
                                                                           </ItemsControl>
                                                                       </StackPanel>

                                                                       <!-- ORGANIZATION entities -->
                                                                       <StackPanel Spacing="2"
                                                                                   IsVisible="{Binding OrganizationEntities.Count}">
                                                                           <TextBlock Text="组织"
                                                                                      FontSize="11"
                                                                                      FontWeight="SemiBold"
                                                                                      Foreground="{DynamicResource CalyAccentPinkBrush}"
                                                                                      Opacity="0.8"
                                                                                      Margin="0,0,0,2"/>
                                                                           <ItemsControl ItemsSource="{Binding OrganizationEntities}">
                                                                               <ItemsControl.ItemsPanel>
                                                                                   <ItemsPanelTemplate>
                                                                                       <WrapPanel/>
                                                                                   </ItemsPanelTemplate>
                                                                               </ItemsControl.ItemsPanel>
                                                                               <ItemsControl.ItemTemplate>
                                                                                   <DataTemplate x:DataType="models:SemanticEntity">
                                                                                       <Border Padding="4,2"
                                                                                               Margin="0,0,2,2"
                                                                                               CornerRadius="2"
                                                                                               Background="{DynamicResource CalyTagPinkBackgroundBrush}"
                                                                                               BorderThickness="0.8"
                                                                                               BorderBrush="{DynamicResource CalyTagPinkBorderBrush}">
                                                                                           <TextBlock Text="{Binding Text}"
                                                                                                      FontSize="11"
                                                                                                      FontWeight="Medium"
                                                                                                      Foreground="{DynamicResource CalyTagPinkForegroundBrush}"
                                                                                                      TextTrimming="CharacterEllipsis"
                                                                                                      MaxWidth="200"/>
                                                                                       </Border>
                                                                                   </DataTemplate>
                                                                               </ItemsControl.ItemTemplate>
                                                                           </ItemsControl>
                                                                       </StackPanel>

                                                                       <!-- OTHER entities (UNKNOWN, MATERIAL, etc.) -->
                                                                       <StackPanel Spacing="2"
                                                                                   IsVisible="{Binding OtherEntities.Count}">
                                                                           <TextBlock Text="其他"
                                                                                      FontSize="11"
                                                                                      FontWeight="SemiBold"
                                                                                      Foreground="{DynamicResource CalyAccentSlateBrush}"
                                                                                      Opacity="0.7"
                                                                                      Margin="0,0,0,2"/>
                                                                           <ItemsControl ItemsSource="{Binding OtherEntities}">
                                                                               <ItemsControl.ItemsPanel>
                                                                                   <ItemsPanelTemplate>
                                                                                       <WrapPanel/>
                                                                                   </ItemsPanelTemplate>
                                                                               </ItemsControl.ItemsPanel>
                                                                               <ItemsControl.ItemTemplate>
                                                                                   <DataTemplate x:DataType="models:SemanticEntity">
                                                                                       <Border Padding="4,2"
                                                                                               Margin="0,0,2,2"
                                                                                               CornerRadius="2"
                                                                                               Background="{DynamicResource CalyTagSteelBackgroundBrush}"
                                                                                               BorderThickness="0.8"
                                                                                               BorderBrush="{DynamicResource CalyTagSteelBorderBrush}"
                                                                                               Opacity="0.7">
                                                                                           <TextBlock Text="{Binding Text}"
                                                                                                      FontSize="11"
                                                                                                      FontWeight="Medium"
                                                                                                      Foreground="{DynamicResource CalyTagSteelForegroundBrush}"/>
                                                                                       </Border>
                                                                                   </DataTemplate>
                                                                               </ItemsControl.ItemTemplate>
                                                                           </ItemsControl>
                                                                       </StackPanel>

                                                                       <!-- Formula references -->
                                                                       <StackPanel Spacing="2"
                                                                                   IsVisible="{Binding HasFormulas}">
                                                                           <TextBlock Text="公式"
                                                                                      FontSize="11"
                                                                                      FontWeight="SemiBold"
                                                                                      Foreground="{DynamicResource CalyTagVioletForegroundBrush}"
                                                                                      Opacity="0.8"
                                                                                      Margin="0,0,0,2"/>
                                                                           <ItemsControl ItemsSource="{Binding FormulaReferences}">
                                                                               <ItemsControl.ItemsPanel>
                                                                                   <ItemsPanelTemplate>
                                                                                       <WrapPanel/>
                                                                                   </ItemsPanelTemplate>
                                                                               </ItemsControl.ItemsPanel>
                                                                               <ItemsControl.ItemTemplate>
                                                                                   <DataTemplate x:DataType="models:FormulaReference">
                                                                                       <Border Padding="4,2"
                                                                                               Margin="0,0,2,2"
                                                                                               CornerRadius="2"
                                                                                               Background="{DynamicResource CalyTagPurpleBackgroundBrush}"
                                                                                               BorderThickness="0.8"
                                                                                               BorderBrush="{DynamicResource CalyTagPurpleBorderBrush}">
                                                                                           <TextBlock Text="{Binding FormulaId}"
                                                                                                      FontSize="11"
                                                                                                      FontWeight="Medium"
                                                                                                      Foreground="{DynamicResource CalyTagVioletForegroundBrush}">
                                                                                               <ToolTip.Tip>
                                                                                                   <TextBlock Text="{Binding Placeholder}"
                                                                                                            TextWrapping="Wrap"
                                                                                                            MaxWidth="300"/>
                                                                                               </ToolTip.Tip>
                                                                                           </TextBlock>
                                                                                       </Border>
                                                                                   </DataTemplate>
                                                                               </ItemsControl.ItemTemplate>
                                                                           </ItemsControl>
                                                                       </StackPanel>

                                                                   </StackPanel>

                                                                    <!-- Expand/Collapse button for details (like Popo) -->
                                                                    <Button Command="{Binding ToggleDetailsExpandCommand}"
                                                                            HorizontalAlignment="Right"
                                                                            VerticalAlignment="Bottom"
                                                                            Padding="6,2"
                                                                            FontSize="11"
                                                                            Background="Transparent"
                                                                            BorderThickness="0"
                                                                        AutomationProperties.Name="展开或折叠详情"
                                                                            ToolTip.Tip="展开或折叠详情"
                                                                            IsVisible="{Binding HasExpandableDetails}">
                                                                        <Button.Content>
                                                                            <StackPanel Orientation="Horizontal" Spacing="2">
                                                                                <TextBlock Text="展开详情"
                                                                                           IsVisible="{Binding !IsDetailsExpanded}"/>
                                                                                <TextBlock Text="折叠"
                                                                                           IsVisible="{Binding IsDetailsExpanded}"/>
                                                                            </StackPanel>
                                                                        </Button.Content>
                                                                    </Button>

                                                                    <!-- Details: Tokens + Relations (collapsed by default) -->
                                                                    <StackPanel Spacing="6"
                                                                                IsVisible="{Binding IsDetailsExpanded}"
                                                                                Margin="0,4,0,0">
                                                                          <!-- Tokens section -->
                                                                          <StackPanel IsVisible="{Binding Tokens.Count}"
                                                                                      Spacing="2">
                                                                              <TextBlock Text="分词"
                                                                                         FontSize="11"
                                                                                         FontWeight="SemiBold"
                                                                                         Foreground="{DynamicResource CalyBlueDeepBrush}"/>
                                                                              <ItemsControl ItemsSource="{Binding Tokens}">
                                                                                  <ItemsControl.ItemsPanel>
                                                                                      <ItemsPanelTemplate>
                                                                                          <WrapPanel/>
                                                                                      </ItemsPanelTemplate>
                                                                                  </ItemsControl.ItemsPanel>
                                                                                  <ItemsControl.ItemTemplate>
                                                                                      <DataTemplate x:DataType="models:SemanticToken">
                                                                                          <Border Padding="3,1"
                                                                                                  Margin="1"
                                                                                                  Background="{DynamicResource CalyTagAzureBackgroundBrush}"
                                                                                                  CornerRadius="2">
                                                                                              <StackPanel Orientation="Horizontal" Spacing="2">
                                                                                                  <TextBlock Text="{Binding Text}"
                                                                                                             FontSize="11"
                                                                                                             Foreground="{DynamicResource CalyTagAzureForegroundBrush}"/>
                                                                                                  <TextBlock Text="{Binding Pos}"
                                                                                                             FontSize="11"
                                                                                                             Foreground="{DynamicResource CalyAccentBlueBrush}"/>
                                                                                              </StackPanel>
                                                                                          </Border>
                                                                                      </DataTemplate>
                                                                                  </ItemsControl.ItemTemplate>
                                                                              </ItemsControl>
                                                                           </StackPanel>

                                                                           <!-- Location Syntactic Roles section -->
                                                                           <StackPanel IsVisible="{Binding LocationEntities.Count}"
                                                                                       Spacing="2">
                                                                               <TextBlock Text="地点句法"
                                                                                          FontSize="11"
                                                                                          FontWeight="SemiBold"
                                                                                          Foreground="{DynamicResource CalySuccessForegroundBrush}"/>
                                                                               <ItemsControl ItemsSource="{Binding LocationEntities}">
                                                                                   <ItemsControl.ItemTemplate>
                                                                                       <DataTemplate x:DataType="models:SemanticEntity">
                                                                                           <Border Padding="4,2"
                                                                                                   Margin="0,1"
                                                                                                   Background="{DynamicResource CalyTagGreenBackgroundBrush}"
                                                                                                   CornerRadius="2">
                                                                                               <StackPanel Orientation="Horizontal" Spacing="4">
                                                                                                   <TextBlock Text="{Binding Text}"
                                                                                                              FontSize="11"
                                                                                                              FontWeight="SemiBold"
                                                                                                              Foreground="{DynamicResource CalyTagGreenForegroundBrush}"/>
                                                                                                    <TextBlock Text="{Binding SyntacticRole}"
                                                                                                               FontSize="11"
                                                                                                               Foreground="{DynamicResource CalyAccentGreenBrush}"
                                                                                                               Opacity="0.8"/>
                                                                                                   <TextBlock Text="{Binding GoverningVerb}"
                                                                                                              FontSize="11"
                                                                                                              Foreground="{DynamicResource CalyAccentMintBrush}"
                                                                                                              IsVisible="{Binding GoverningVerb}"/>
                                                                                               </StackPanel>
                                                                                           </Border>
                                                                                       </DataTemplate>
                                                                                   </ItemsControl.ItemTemplate>
                                                                               </ItemsControl>
                                                                            </StackPanel>

                                                                            <!-- Dependency Tree Visualization -->
                                                                            <StackPanel IsVisible="{Binding HasDepTree}"
                                                                                        Spacing="4"
                                                                                        Margin="0,4,0,0">
                                                                                <TextBlock Text="依存句法树"
                                                                                           FontSize="11"
                                                                                           FontWeight="SemiBold"
                                                                                           Foreground="{DynamicResource CalyWarningForegroundBrush}"/>
                                                                                <Border Background="{DynamicResource CalyCodeBackgroundBrush}"
                                                                                        CornerRadius="4"
                                                                                        Padding="8"
                                                                                        MaxHeight="250">
                                                                                    <ScrollViewer HorizontalScrollBarVisibility="Auto">
                                                                                        <controls:DepTreeControl Tokens="{Binding DepTokens}"
                                                                                                               Edges="{Binding DepEdges}"
                                                                                                               Height="200"/>
                                                                                    </ScrollViewer>
                                                                                </Border>
                                                                            </StackPanel>

                                                                            <!-- Relations section -->
                                                                           <StackPanel IsVisible="{Binding Relations.Count}"
                                                                                      Spacing="2">
                                                                              <TextBlock Text="关系"
                                                                                         FontSize="11"
                                                                                         FontWeight="SemiBold"
                                                                                         Foreground="{DynamicResource CalyPurpleDeepBrush}"/>
                                                                              <ItemsControl ItemsSource="{Binding Relations}">
                                                                                  <ItemsControl.ItemTemplate>
                                                                                      <DataTemplate x:DataType="models:SemanticRelation">
                                                                                          <Border Padding="4,2"
                                                                                                  Margin="0,1"
                                                                                                  Background="{DynamicResource CalyTagVioletBackgroundBrush}"
                                                                                                  CornerRadius="2">
                                                                                              <StackPanel Orientation="Horizontal" Spacing="2">
                                                                                                  <TextBlock Text="{Binding Subject}"
                                                                                                             FontSize="11"
                                                                                                             FontWeight="SemiBold"
                                                                                                             Foreground="{DynamicResource CalyTagVioletForegroundBrush}"/>
                                                                                                  <TextBlock Text="→"
                                                                                                             FontSize="11"
                                                                                                             Foreground="{DynamicResource CalyAccentVioletBrush}"/>
                                                                                                  <TextBlock Text="{Binding Predicate}"
                                                                                                             FontSize="11"
                                                                                                             Foreground="{DynamicResource CalyAccentVioletBrush}"/>
                                                                                                  <TextBlock Text="→"
                                                                                                             FontSize="11"
                                                                                                             Foreground="{DynamicResource CalyAccentVioletBrush}"/>
                                                                                                  <TextBlock Text="{Binding ObjectText}"
                                                                                                             FontSize="11"
                                                                                                             FontWeight="SemiBold"
                                                                                                             Foreground="{DynamicResource CalyTagVioletForegroundBrush}"/>
                                                                                              </StackPanel>
                                                                                          </Border>
                                                                                      </DataTemplate>
                                                                                  </ItemsControl.ItemTemplate>
                                                                              </ItemsControl>
                                                                          </StackPanel>
                                                                      </StackPanel>
                                                              </StackPanel>
                                                          </Border>
                                                      </DataTemplate>
                                                  </ItemsControl.ItemTemplate>
                                              </ItemsControl>
                                          </StackPanel>
                                      </ScrollViewer>
                                 </DockPanel>
                             </Border>

                             <!-- GridSplitter between Semantic and Geo -->
                             <GridSplitter Grid.Column="3"
                                           HorizontalAlignment="Right"
                                           Width="4"
                                           Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                           IsVisible="{Binding ShowGeoColumn}"/>

                              <!-- Column 5: Geo View -->
                              <Border Grid.Column="4"
                                      Padding="8"
                                      Background="{DynamicResource SystemChromeLowColor}"
                                      BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                      BorderThickness="1"
                                      IsVisible="{Binding ShowGeoColumn}">
                                   <DockPanel>
                                        <!-- Header -->
                                        <Grid DockPanel.Dock="Top"
                                              Margin="0,0,0,6"
                                              ColumnDefinitions="*,Auto">
                                           <StackPanel Grid.Column="0"
                                                       Orientation="Horizontal"
                                                       Spacing="4">
                                               <TextBlock Text="Geo"
                                                          FontWeight="Bold"
                                                          FontSize="12"/>
                                               <TextBlock Text="{Binding GeoStatusText}"
                                                          FontSize="11"
                                                          Opacity="0.5"
                                                          IsVisible="{Binding !IsGeoProcessing}"/>
                                               <TextBlock Text="{Binding GeocodingTotalCount, StringFormat='({0} locations)'}"
                                                          FontSize="11"
                                                          Opacity="0.4"
                                                          IsVisible="{Binding !IsGeoProcessing}"/>
                                           </StackPanel>
                                       </Grid>

                                       <!-- Progress State: shown during Geo processing -->
                                       <Border IsVisible="{Binding IsGeoProcessing}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Stretch"
                                               DockPanel.Dock="Top"
                                               Margin="0,12,0,12">
                                           <StackPanel VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       Spacing="12">
                                               <!-- Spinner -->
                                               <PathIcon Width="32"
                                                         Height="32"
                                                         Data="{StaticResource spinner_regular}"
                                                         Foreground="{DynamicResource SystemAccentColor}"
                                                         HorizontalAlignment="Center"/>

                                               <!-- Status Text -->
                                               <TextBlock Text="{Binding GeoStatusText}"
                                                          FontSize="13"
                                                          HorizontalAlignment="Center"
                                                          TextAlignment="Center"/>

                                               <!-- Progress Bar -->
                                               <ProgressBar Width="200"
                                                            Minimum="0"
                                                            Maximum="100"
                                                            Value="{Binding GeoProgress}"
                                                            HorizontalAlignment="Center"/>

                                               <!-- Progress Percentage -->
                                               <TextBlock Text="{Binding GeoProgress, StringFormat='{}{0}%'}"
                                                          FontSize="11"
                                                          HorizontalAlignment="Center"
                                                          Opacity="0.7"/>

                                               <!-- Cancel Button -->
                                               <Button Content="取消"
                                                       Command="{Binding CancelGeoProcessCommand}"
                                                       HorizontalAlignment="Center"
                                                   AutomationProperties.Name="取消地理处理"
                                                       Padding="20,4"/>
                                           </StackPanel>
                                       </Border>

                                       <!-- Location Table -->
                                       <ScrollViewer IsVisible="{Binding GeocodingTotalCount, Converter={StaticResource IsGreaterThanConverter}, ConverterParameter=0}"
                                                     HorizontalScrollBarVisibility="Disabled">
                                           <StackPanel>
                                                   <!-- Header row -->
                                                   <Border Margin="0,0,0,4"
                                                           Background="{DynamicResource SystemChromeMediumColor}">
                                                        <Grid ColumnDefinitions="20,80,45,*,60,50,50,50,40,50,35,35,70,70">
                                                            <!-- Expand button placeholder -->
                                                            <TextBlock Text=" "
                                                                       FontSize="11"
                                                                       Margin="0,2,0,2"/>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="地点"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Margin="4,2,0,2"/>
                                                            <TextBlock Grid.Column="2"
                                                                       Text="句法角色"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Margin="0,2,0,2"/>
                                                            <TextBlock Grid.Column="3"
                                                                       Text="标准名"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Margin="0,2,0,2"/>
                                                            <TextBlock Grid.Column="4"
                                                                       Text="状态"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Margin="0,2,0,2"/>
                                                            <TextBlock Grid.Column="5"
                                                                       Text="匹配类型"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Margin="0,2,0,2"/>
                                                            <TextBlock Grid.Column="6"
                                                                       Text="匹配名"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Margin="0,2,0,2"/>
                                                            <TextBlock Grid.Column="7"
                                                                       Text="标签"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Margin="0,2,0,2"/>
                                                            <TextBlock Grid.Column="8"
                                                                       Text="谐音"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Margin="0,2,0,2"/>
                                                            <TextBlock Grid.Column="9"
                                                                       Text="类别"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Margin="0,2,0,2"/>
                                                            <TextBlock Grid.Column="10"
                                                                       Text="层级"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Margin="0,2,0,2"/>
                                                            <TextBlock Grid.Column="11"
                                                                       Text="结果数"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Margin="0,2,0,2"/>
                                                            <TextBlock Grid.Column="12"
                                                                       Text="纬度"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Margin="0,2,0,2"/>
                                                            <TextBlock Grid.Column="13"
                                                                       Text="经度"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Margin="0,2,0,2"/>
                                                        </Grid>
                                                   </Border>

                                                <!-- Location rows -->
                                                <ItemsControl ItemsSource="{Binding GeocodingLocations}">
                                                    <ItemsControl.ItemTemplate>
                                                         <DataTemplate x:DataType="vm:GeocodingLocationViewModel">
                                                              <StackPanel>
                                                                  <!-- Main row -->
                                                                  <Border Margin="0,1"
                                                                          Padding="4,2"
                                                                          Background="{DynamicResource CalyFaintBackgroundBrush}">
                                                                       <Grid ColumnDefinitions="20,80,45,*,60,50,50,50,40,50,35,35,70,70">
                                                                           <!-- Expand/Collapse button -->
                                                                           <Button Grid.Column="0"
                                                                                   Width="20"
                                                                                   Height="20"
                                                                                   Padding="0"
                                                                                   Background="Transparent"
                                                                                   BorderThickness="0"
                                                                                   Click="ToggleExpanded_Click"
                                                                               AutomationProperties.Name="展开或折叠"
                                                                               ToolTip.Tip="展开或折叠候选地址"
                                                                                   IsVisible="{Binding HasMultipleResults}">
                                                                               <TextBlock Text="{Binding ExpandIcon}"
                                                                                          FontSize="11"
                                                                                          HorizontalAlignment="Center"
                                                                                          VerticalAlignment="Center"/>
                                                                           </Button>
                                                                           <TextBlock Grid.Column="0"
                                                                                      IsVisible="{Binding !HasMultipleResults}"
                                                                                      HorizontalAlignment="Center"
                                                                                      Text=" "/>

                                                                           <!-- Location name -->
                                                                           <TextBlock Grid.Column="1"
                                                                                      Text="{Binding Name}"
                                                                                      FontSize="11"
                                                                                      TextTrimming="CharacterEllipsis"/>

                                                                           <!-- Syntactic role -->
                                                                           <TextBlock Grid.Column="2"
                                                                                      Text="{Binding SyntacticRoleDisplay}"
                                                                                      FontSize="11"
                                                                                      FontWeight="SemiBold"
                                                                                      Foreground="{Binding SyntacticRoleColor}"
                                                                                      Margin="0,2,0,2"/>

                                                                           <!-- Display name (standard name) -->
                                                                           <TextBlock Grid.Column="3"
                                                                                      Text="{Binding DisplayName}"
                                                                                      FontSize="11"
                                                                                      Opacity="0.7"
                                                                                      TextTrimming="CharacterEllipsis"/>

                                                                           <!-- Status -->
                                                                           <TextBlock Grid.Column="4"
                                                                                      Text="{Binding StatusLabel}"
                                                                                      FontSize="11"
                                                                                      FontWeight="SemiBold"
                                                                                      Foreground="{Binding StatusColor}"/>

                                                                           <!-- Match Type -->
                                                                           <TextBlock Grid.Column="5"
                                                                                      Text="{Binding MatchType}"
                                                                                      FontSize="11"
                                                                                      Foreground="{DynamicResource CalyWarningForegroundBrush}"/>

                                                                           <!-- Matched Name -->
                                                                           <TextBlock Grid.Column="6"
                                                                                      Text="{Binding MatchedName}"
                                                                                      FontSize="11"
                                                                                      Foreground="{DynamicResource CalyAccentLightBlueBrush}"
                                                                                      TextTrimming="CharacterEllipsis"/>

                                                                           <!-- Matched Name Tag -->
                                                                           <TextBlock Grid.Column="7"
                                                                                      Text="{Binding MatchedNameTag}"
                                                                                      FontSize="11"
                                                                                      Foreground="{DynamicResource CalyMutedForegroundBrush}"/>

                                                                           <!-- Homophone indicator -->
                                                                           <TextBlock Grid.Column="8"
                                                                                      Text="✓"
                                                                                      FontSize="11"
                                                                                      FontWeight="Bold"
                                                                                      Foreground="{DynamicResource CalyErrorForegroundBrush}"
                                                                                      IsVisible="{Binding MatchByHomophone}"/>
                                                                           <TextBlock Grid.Column="8"
                                                                                      Text="-"
                                                                                      FontSize="11"
                                                                                      Opacity="0.4"
                                                                                      IsVisible="{Binding !MatchByHomophone}"/>

                                                                           <!-- Place Type (Category/Type) -->
                                                                           <TextBlock Grid.Column="9"
                                                                                      Text="{Binding PlaceType}"
                                                                                      FontSize="11"
                                                                                      Foreground="{DynamicResource CalyAccentGreenBrush}"
                                                                                      TextTrimming="CharacterEllipsis"/>

                                                                           <!-- Place Rank -->
                                                                           <TextBlock Grid.Column="10"
                                                                                      Text="{Binding PlaceRank}"
                                                                                      FontSize="11"
                                                                                      Foreground="{DynamicResource CalyAccentAmberBrush}"
                                                                                      HorizontalAlignment="Center"/>

                                                                           <!-- Result count -->
                                                                           <TextBlock Grid.Column="11"
                                                                                      Text="{Binding ResultCount}"
                                                                                      FontSize="11"
                                                                                      HorizontalAlignment="Center"/>

                                                                           <!-- Latitude -->
                                                                           <TextBlock Grid.Column="12"
                                                                                      Text="{Binding Latitude, StringFormat='{}{0:F4}'}"
                                                                                      FontSize="11"
                                                                                      IsVisible="{Binding HasCoordinates}"/>
                                                                           <TextBlock Grid.Column="12"
                                                                                      Text="-"
                                                                                      FontSize="11"
                                                                                      Opacity="0.4"
                                                                                      IsVisible="{Binding !HasCoordinates}"/>

                                                                           <!-- Longitude -->
                                                                           <TextBlock Grid.Column="13"
                                                                                      Text="{Binding Longitude, StringFormat='{}{0:F4}'}"
                                                                                      FontSize="11"
                                                                                      IsVisible="{Binding HasCoordinates}"/>
                                                                           <TextBlock Grid.Column="13"
                                                                                      Text="-"
                                                                                      FontSize="11"
                                                                                      Opacity="0.4"
                                                                                      IsVisible="{Binding !HasCoordinates}"/>
                                                                       </Grid>
                                                                  </Border>

                                                                  <!-- Expanded sub-results -->
                                                                  <ItemsControl ItemsSource="{Binding Results}"
                                                                                IsVisible="{Binding IsExpanded}">
                                                                      <ItemsControl.ItemTemplate>
                                                                          <DataTemplate x:DataType="vm:GeocodingResultViewModel">
                                                                              <Border Margin="24,1,0,1"
                                                                                      Padding="4,2"
                                                                                      Background="{DynamicResource CalySubtleBackgroundBrush}"
                                                                                      BorderBrush="{DynamicResource CalySubtleBorderBrush}"
                                                                                      BorderThickness="1">
                                                                                  <Grid ColumnDefinitions="20,*,70,70">
                                                                          <!-- Radio button for selection -->
                                                                          <RadioButton Grid.Column="0"
                                                                                      IsChecked="{Binding IsSelected}"
                                                                                      GroupName="{Binding Result.Name}"
                                                                                      AutomationProperties.Name="选择该候选地址"
                                                                                      ToolTip.Tip="选择该候选地址"
                                                                                      HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"/>
                                                                                      <!-- Display name -->
                                                                                      <TextBlock Grid.Column="1"
                                                                                                 Text="{Binding Result.DisplayName}"
                                                                                                 FontSize="11"
                                                                                                 Opacity="0.8"
                                                                                                 TextTrimming="CharacterEllipsis"
                                                                                                 TextWrapping="Wrap"/>
                                                                                      <!-- Latitude -->
                                                                                      <TextBlock Grid.Column="2"
                                                                                                 Text="{Binding Result.Latitude, StringFormat='{}{0:F4}'}"
                                                                                                 FontSize="11"
                                                                                                 Opacity="0.6"/>
                                                                                      <!-- Longitude -->
                                                                                      <TextBlock Grid.Column="3"
                                                                                                 Text="{Binding Result.Longitude, StringFormat='{}{0:F4}'}"
                                                                                                 FontSize="11"
                                                                                                 Opacity="0.6"/>
                                                                                  </Grid>
                                                                              </Border>
                                                                          </DataTemplate>
                                                                      </ItemsControl.ItemTemplate>
                                                                  </ItemsControl>
                                                              </StackPanel>
                                                          </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                           </StackPanel>
                                       </ScrollViewer>

                                      <!-- Error State: shown when geocoding failed (all failed) -->
                                      <Border IsVisible="{Binding GeoStatus, Converter={StaticResource EqualsConverter}, ConverterParameter={x:Static vm:GeoProcessStatus.Failed}}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Stretch"
                                              Padding="12"
                                              Margin="0,8,0,0"
                                              Background="{DynamicResource CalyAlertCardBackgroundBrush}"
                                              CornerRadius="4">
                                          <StackPanel Spacing="8"
                                                      HorizontalAlignment="Center">
                                              <TextBlock Text="{Binding GeoStatusText}"
                                                         FontSize="12"
                                                         Foreground="{DynamicResource CalyAlertCardForegroundBrush}"
                                                         TextAlignment="Center"
                                                         TextWrapping="Wrap"/>
                                              <Button Content="重试"
                                                      Command="{Binding GenerateGeoJsonCommand}"
                                                      HorizontalAlignment="Center"
                                                  AutomationProperties.Name="重新生成"
                                                      Padding="20,4"/>
                                          </StackPanel>
                                      </Border>


                                       <!-- Placeholder: shown when no locations loaded -->
                                       <Border IsVisible="{Binding ShowGeoPlaceholder}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Stretch"
                                               Padding="16">
                                           <StackPanel Spacing="8"
                                                       HorizontalAlignment="Center">
                                               <TextBlock Text="{Binding GeoStatusText}"
                                                          FontSize="12"
                                                          FontWeight="SemiBold"
                                                          HorizontalAlignment="Center"
                                                          Opacity="0.7"/>
                                               <TextBlock Text="点击顶部地图图标生成地理数据"
                                                          FontSize="11"
                                                          Opacity="0.5"
                                                          TextAlignment="Center"/>
                                           </StackPanel>
                                       </Border>

                                       <!-- Geo Control: shown when completed -->
                                       <controls:GeoViewControl
                                           IsVisible="{Binding GeoStatus, Converter={StaticResource EqualsConverter}, ConverterParameter={x:Static vm:GeoProcessStatus.Completed}}"
                                           GeoJsonFilePath="{Binding GeoJsonFilePath}"
                                           GeoLibreBaseUrl="https://web.geolibre.app"
                                           RefreshCommand="{Binding GenerateGeoJsonCommand}"
                                           ExportGeoLibreCommand="{Binding ExportGeoLibreJsonCommand}"/>
                                   </DockPanel>
                              </Border>

                             <!-- GridSplitter between Geo and Enriched -->
                             <GridSplitter Grid.Column="4"
                                           HorizontalAlignment="Right"
                                           Width="4"
                                           Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                           IsVisible="{Binding ShowEnrichedColumn}"/>

                              <!-- Column 6: Enriched Entity View -->
                              <Border Grid.Column="5"
                                      Padding="8"
                                      Background="{DynamicResource SystemChromeLowColor}"
                                      BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                      BorderThickness="1"
                                      IsVisible="{Binding ShowEnrichedColumn}">
                                  <DockPanel>
                                      <!-- Header -->
                                      <Grid DockPanel.Dock="Top"
                                            Margin="0,0,0,6"
                                            ColumnDefinitions="*,Auto">
                                          <StackPanel Grid.Column="0"
                                                      Spacing="2">
                                              <TextBlock Text="Enriched"
                                                         FontWeight="Bold"
                                                         FontSize="12"/>
                                              <TextBlock Text="{Binding EnrichStatusText}"
                                                         FontSize="11"
                                                         Opacity="0.5"
                                                         IsVisible="{Binding !IsEnrichProcessing}"/>
                                              <TextBlock Text="{Binding EnrichStatusText}"
                                                         FontSize="11"
                                                         Opacity="0.7"
                                                         IsVisible="{Binding IsEnrichProcessing}"/>
                                          </StackPanel>
                                      </Grid>

                                      <!-- Progress State -->
                                      <Border IsVisible="{Binding IsEnrichProcessing}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Stretch">
                                          <StackPanel VerticalAlignment="Center"
                                                      HorizontalAlignment="Center"
                                                      Spacing="12">
                                              <PathIcon Width="32"
                                                        Height="32"
                                                        Data="{StaticResource spinner_regular}"
                                                        Foreground="{DynamicResource SystemAccentColor}"
                                                        HorizontalAlignment="Center"/>
                                              <TextBlock Text="{Binding EnrichStatusText}"
                                                         FontSize="13"
                                                         HorizontalAlignment="Center"
                                                         TextAlignment="Center"/>
                                          </StackPanel>
                                      </Border>

                                      <!-- Enriched Results List -->
                                      <ScrollViewer IsVisible="{Binding !IsEnrichProcessing}"
                                                    HorizontalScrollBarVisibility="Disabled">
                                          <ItemsControl ItemsSource="{Binding EnrichedBlockViewModels}">
                                              <ItemsControl.ItemTemplate>
                                                  <DataTemplate x:DataType="vm:EnrichedBlockViewModel">
                                                      <Border Margin="0,4"
                                                              Padding="8"
                                                              Background="{DynamicResource CalyFaintBackgroundBrush}"
                                                              CornerRadius="4"
                                                              BorderThickness="1"
                                                              BorderBrush="{DynamicResource CalySubtleBorderBrush}">
                                                          <StackPanel Spacing="6">
                                                              <!-- Block Header -->
                                                              <Grid ColumnDefinitions="Auto,*">
                                                                  <TextBlock Grid.Column="0"
                                                                             Text="{Binding BlockLabel}"
                                                                             FontSize="11"
                                                                             FontWeight="SemiBold"/>
                                                                  <TextBlock Grid.Column="1"
                                                                             Text="{Binding Summary}"
                                                                             FontSize="11"
                                                                             Opacity="0.5"
                                                                             HorizontalAlignment="Right"/>
                                                              </Grid>

                                                              <!-- LOCATION entities -->
                                                              <StackPanel Spacing="3"
                                                                          IsVisible="{Binding LocationCount}">
                                                                  <TextBlock Text="地点"
                                                                             FontSize="11"
                                                                             FontWeight="SemiBold"
                                                                             Foreground="{DynamicResource CalyAccentGreenBrush}"
                                                                             Opacity="0.8"/>
                                                                  <ItemsControl ItemsSource="{Binding LocationEntities}">
                                                                      <ItemsControl.ItemsPanel>
                                                                          <ItemsPanelTemplate>
                                                                              <WrapPanel/>
                                                                          </ItemsPanelTemplate>
                                                                      </ItemsControl.ItemsPanel>
                                                                      <ItemsControl.ItemTemplate>
                                                                          <DataTemplate x:DataType="models:EnrichedEntityEntry">
                                                                              <Border Padding="6,4"
                                                                                      Margin="0,0,2,2"
                                                                                      CornerRadius="3"
                                                                                      Background="{Binding CategoryBackground}"
                                                                                      BorderThickness="1"
                                                                                      BorderBrush="{Binding CategoryBorder}">
                                                                                  <StackPanel Spacing="2">
                                                                                          <!-- Entity display: uses ArrowDisplayText for "original → enriched" -->
                                                                                          <TextBlock FontSize="11"
                                                                                                     Foreground="{Binding CategoryTextColor}"
                                                                                                     Text="{Binding ArrowDisplayText}"
                                                                                                     FontWeight="SemiBold"/>
                                                                                          <StackPanel Orientation="Horizontal"
                                                                                                    Spacing="6">
                                                                                              <TextBlock Text="{Binding StatusIcon}"
                                                                                                         FontSize="11"
                                                                                                         Foreground="{Binding StatusColor}"/>
                                                                                              <TextBlock Text="{Binding QuickSummary}"
                                                                                                         FontSize="11"
                                                                                                         Opacity="0.6"
                                                                                                         IsVisible="{Binding IsEnriched}"/>
                                                                                          </StackPanel>
                                                                                          <TextBlock FontSize="11"
                                                                                                     Foreground="{DynamicResource CalyErrorForegroundBrush}"
                                                                                                     IsVisible="{Binding ValidationStatus, Converter={StaticResource EqualsConverter}, ConverterParameter=invalid}"
                                                                                                     TextWrapping="Wrap"
                                                                                                     Text="{Binding ValidationReason, StringFormat='✗ {0}'}"/>
                                                                                  </StackPanel>
                                                                              </Border>
                                                                          </DataTemplate>
                                                                      </ItemsControl.ItemTemplate>
                                                                  </ItemsControl>
                                                              </StackPanel>

                                                              <!-- PERSON entities -->
                                                              <StackPanel Spacing="3"
                                                                          IsVisible="{Binding PersonCount}">
                                                                  <TextBlock Text="人物"
                                                                             FontSize="11"
                                                                             FontWeight="SemiBold"
                                                                             Foreground="{DynamicResource CalyAccentBlueBrush}"
                                                                             Opacity="0.8"/>
                                                                  <ItemsControl ItemsSource="{Binding PersonEntities}">
                                                                      <ItemsControl.ItemsPanel>
                                                                          <ItemsPanelTemplate>
                                                                              <WrapPanel/>
                                                                          </ItemsPanelTemplate>
                                                                      </ItemsControl.ItemsPanel>
                                                                      <ItemsControl.ItemTemplate>
                                                                          <DataTemplate x:DataType="models:EnrichedEntityEntry">
                                                                              <Border Padding="6,4"
                                                                                      Margin="0,0,2,2"
                                                                                      CornerRadius="3"
                                                                                      Background="{Binding CategoryBackground}"
                                                                                      BorderThickness="1"
                                                                                      BorderBrush="{Binding CategoryBorder}">
                                                                                  <StackPanel Spacing="2">
                                                                                          <TextBlock FontSize="11"
                                                                                                     Foreground="{Binding CategoryTextColor}"
                                                                                                     Text="{Binding ArrowDisplayText}"
                                                                                                     FontWeight="SemiBold"/>
                                                                                          <StackPanel Orientation="Horizontal"
                                                                                                    Spacing="6">
                                                                                              <TextBlock Text="{Binding StatusIcon}"
                                                                                                         FontSize="11"
                                                                                                         Foreground="{Binding StatusColor}"/>
                                                                                              <TextBlock Text="{Binding QuickSummary}"
                                                                                                         FontSize="11"
                                                                                                         Opacity="0.6"
                                                                                                         IsVisible="{Binding IsEnriched}"/>
                                                                                          </StackPanel>
                                                                                          <TextBlock FontSize="11"
                                                                                                     Foreground="{DynamicResource CalyErrorForegroundBrush}"
                                                                                                     IsVisible="{Binding ValidationStatus, Converter={StaticResource EqualsConverter}, ConverterParameter=invalid}"
                                                                                                     TextWrapping="Wrap"
                                                                                                     Text="{Binding ValidationReason, StringFormat='✗ {0}'}"/>
                                                                                  </StackPanel>
                                                                              </Border>
                                                                          </DataTemplate>
                                                                      </ItemsControl.ItemTemplate>
                                                                  </ItemsControl>
                                                              </StackPanel>

                                                              <!-- ORGANIZATION entities -->
                                                              <StackPanel Spacing="3"
                                                                          IsVisible="{Binding OrganizationCount}">
                                                                  <TextBlock Text="组织"
                                                                             FontSize="11"
                                                                             FontWeight="SemiBold"
                                                                             Foreground="{DynamicResource CalyAccentPinkBrush}"
                                                                             Opacity="0.8"/>
                                                                  <ItemsControl ItemsSource="{Binding OrganizationEntities}">
                                                                      <ItemsControl.ItemsPanel>
                                                                          <ItemsPanelTemplate>
                                                                              <WrapPanel/>
                                                                          </ItemsPanelTemplate>
                                                                      </ItemsControl.ItemsPanel>
                                                                      <ItemsControl.ItemTemplate>
                                                                          <DataTemplate x:DataType="models:EnrichedEntityEntry">
                                                                              <Border Padding="6,4"
                                                                                      Margin="0,0,2,2"
                                                                                      CornerRadius="3"
                                                                                      Background="{Binding CategoryBackground}"
                                                                                      BorderThickness="1"
                                                                                      BorderBrush="{Binding CategoryBorder}">
                                                                                  <StackPanel Spacing="2">
                                                                                          <TextBlock FontSize="11"
                                                                                                     Foreground="{Binding CategoryTextColor}"
                                                                                                     Text="{Binding ArrowDisplayText}"
                                                                                                     FontWeight="SemiBold"
                                                                                                     MaxWidth="200"
                                                                                                     TextTrimming="CharacterEllipsis"/>
                                                                                          <StackPanel Orientation="Horizontal"
                                                                                                    Spacing="6">
                                                                                              <TextBlock Text="{Binding StatusIcon}"
                                                                                                         FontSize="11"
                                                                                                         Foreground="{Binding StatusColor}"/>
                                                                                              <TextBlock Text="{Binding QuickSummary}"
                                                                                                         FontSize="11"
                                                                                                         Opacity="0.6"
                                                                                                         IsVisible="{Binding IsEnriched}"/>
                                                                                          </StackPanel>
                                                                                          <TextBlock FontSize="11"
                                                                                                     Foreground="{DynamicResource CalyErrorForegroundBrush}"
                                                                                                     IsVisible="{Binding ValidationStatus, Converter={StaticResource EqualsConverter}, ConverterParameter=invalid}"
                                                                                                     TextWrapping="Wrap"
                                                                                                     Text="{Binding ValidationReason, StringFormat='✗ {0}'}"/>
                                                                                  </StackPanel>
                                                                              </Border>
                                                                          </DataTemplate>
                                                                      </ItemsControl.ItemTemplate>
                                                                  </ItemsControl>
                                                              </StackPanel>

                                                              <!-- DATE entities -->
                                                              <StackPanel Spacing="3"
                                                                          IsVisible="{Binding DateCount}">
                                                                  <TextBlock Text="时间"
                                                                             FontSize="11"
                                                                             FontWeight="SemiBold"
                                                                             Foreground="{DynamicResource CalyAccentAmberBrush}"
                                                                             Opacity="0.8"/>
                                                                  <ItemsControl ItemsSource="{Binding DateEntities}">
                                                                      <ItemsControl.ItemsPanel>
                                                                          <ItemsPanelTemplate>
                                                                              <WrapPanel/>
                                                                          </ItemsPanelTemplate>
                                                                      </ItemsControl.ItemsPanel>
                                                                      <ItemsControl.ItemTemplate>
                                                                          <DataTemplate x:DataType="models:EnrichedEntityEntry">
                                                                              <Border Padding="6,4"
                                                                                      Margin="0,0,2,2"
                                                                                      CornerRadius="3"
                                                                                      Background="{Binding CategoryBackground}"
                                                                                      BorderThickness="1"
                                                                                      BorderBrush="{Binding CategoryBorder}">
                                                                                  <StackPanel Spacing="2">
                                                                                          <TextBlock FontSize="11"
                                                                                                     Foreground="{Binding CategoryTextColor}"
                                                                                                     Text="{Binding ArrowDisplayText}"
                                                                                                     FontWeight="SemiBold"/>
                                                                                          <StackPanel Orientation="Horizontal"
                                                                                                    Spacing="6">
                                                                                              <TextBlock Text="{Binding StatusIcon}"
                                                                                                         FontSize="11"
                                                                                                         Foreground="{Binding StatusColor}"/>
                                                                                              <TextBlock Text="{Binding QuickSummary}"
                                                                                                         FontSize="11"
                                                                                                         Opacity="0.6"
                                                                                                         IsVisible="{Binding IsEnriched}"/>
                                                                                          </StackPanel>
                                                                                          <TextBlock FontSize="11"
                                                                                                     Foreground="{DynamicResource CalyErrorForegroundBrush}"
                                                                                                     IsVisible="{Binding ValidationStatus, Converter={StaticResource EqualsConverter}, ConverterParameter=invalid}"
                                                                                                     TextWrapping="Wrap"
                                                                                                     Text="{Binding ValidationReason, StringFormat='✗ {0}'}"/>
                                                                                  </StackPanel>
                                                                              </Border>
                                                                          </DataTemplate>
                                                                      </ItemsControl.ItemTemplate>
                                                                  </ItemsControl>
                                                              </StackPanel>

                                                              <!-- NUMBER entities -->
                                                              <StackPanel Spacing="3"
                                                                          IsVisible="{Binding NumberCount}">
                                                                  <TextBlock Text="数值"
                                                                             FontSize="11"
                                                                             FontWeight="SemiBold"
                                                                             Foreground="{DynamicResource CalyTagVioletForegroundBrush}"
                                                                             Opacity="0.8"/>
                                                                  <ItemsControl ItemsSource="{Binding NumberEntities}">
                                                                      <ItemsControl.ItemsPanel>
                                                                          <ItemsPanelTemplate>
                                                                              <WrapPanel/>
                                                                          </ItemsPanelTemplate>
                                                                      </ItemsControl.ItemsPanel>
                                                                      <ItemsControl.ItemTemplate>
                                                                          <DataTemplate x:DataType="models:EnrichedEntityEntry">
                                                                              <Border Padding="6,4"
                                                                                      Margin="0,0,2,2"
                                                                                      CornerRadius="3"
                                                                                      Background="{Binding CategoryBackground}"
                                                                                      BorderThickness="1"
                                                                                      BorderBrush="{Binding CategoryBorder}">
                                                                                  <StackPanel Spacing="2">
                                                                                          <TextBlock FontSize="11"
                                                                                                     Foreground="{Binding CategoryTextColor}"
                                                                                                     Text="{Binding ArrowDisplayText}"
                                                                                                     FontWeight="SemiBold"/>
                                                                                          <StackPanel Orientation="Horizontal"
                                                                                                    Spacing="6">
                                                                                              <TextBlock Text="{Binding StatusIcon}"
                                                                                                         FontSize="11"
                                                                                                         Foreground="{Binding StatusColor}"/>
                                                                                              <TextBlock Text="{Binding QuickSummary}"
                                                                                                         FontSize="11"
                                                                                                         Opacity="0.6"
                                                                                                         IsVisible="{Binding IsEnriched}"/>
                                                                                          </StackPanel>
                                                                                          <TextBlock FontSize="11"
                                                                                                     Foreground="{DynamicResource CalyErrorForegroundBrush}"
                                                                                                     IsVisible="{Binding ValidationStatus, Converter={StaticResource EqualsConverter}, ConverterParameter=invalid}"
                                                                                                     TextWrapping="Wrap"
                                                                                                     Text="{Binding ValidationReason, StringFormat='✗ {0}'}"/>
                                                                                  </StackPanel>
                                                                              </Border>
                                                                          </DataTemplate>
                                                                      </ItemsControl.ItemTemplate>
                                                                  </ItemsControl>
                                                              </StackPanel>

                                                              <!-- FACILITY entities -->
                                                              <StackPanel Spacing="3"
                                                                          IsVisible="{Binding FacilityCount}">
                                                                  <TextBlock Text="设施"
                                                                             FontSize="11"
                                                                             FontWeight="SemiBold"
                                                                             Foreground="{DynamicResource CalyTagSteelForegroundBrush}"
                                                                             Opacity="0.8"/>
                                                                  <ItemsControl ItemsSource="{Binding FacilityEntities}">
                                                                      <ItemsControl.ItemsPanel>
                                                                          <ItemsPanelTemplate>
                                                                              <WrapPanel/>
                                                                          </ItemsPanelTemplate>
                                                                      </ItemsControl.ItemsPanel>
                                                                      <ItemsControl.ItemTemplate>
                                                                          <DataTemplate x:DataType="models:EnrichedEntityEntry">
                                                                              <Border Padding="6,4"
                                                                                      Margin="0,0,2,2"
                                                                                      CornerRadius="3"
                                                                                      Background="{Binding CategoryBackground}"
                                                                                      BorderThickness="1"
                                                                                      BorderBrush="{Binding CategoryBorder}">
                                                                                  <StackPanel Spacing="2">
                                                                                          <TextBlock FontSize="11"
                                                                                                     Foreground="{Binding CategoryTextColor}"
                                                                                                     Text="{Binding ArrowDisplayText}"
                                                                                                     FontWeight="SemiBold"/>
                                                                                          <StackPanel Orientation="Horizontal"
                                                                                                    Spacing="6">
                                                                                              <TextBlock Text="{Binding StatusIcon}"
                                                                                                         FontSize="11"
                                                                                                         Foreground="{Binding StatusColor}"/>
                                                                                              <TextBlock Text="{Binding QuickSummary}"
                                                                                                         FontSize="11"
                                                                                                         Opacity="0.6"
                                                                                                         IsVisible="{Binding IsEnriched}"/>
                                                                                          </StackPanel>
                                                                                          <TextBlock FontSize="11"
                                                                                                     Foreground="{DynamicResource CalyErrorForegroundBrush}"
                                                                                                     IsVisible="{Binding ValidationStatus, Converter={StaticResource EqualsConverter}, ConverterParameter=invalid}"
                                                                                                     TextWrapping="Wrap"
                                                                                                     Text="{Binding ValidationReason, StringFormat='✗ {0}'}"/>
                                                                                  </StackPanel>
                                                                              </Border>
                                                                          </DataTemplate>
                                                                      </ItemsControl.ItemTemplate>
                                                                  </ItemsControl>
                                                              </StackPanel>

                                                              <!-- OTHER entities -->
                                                              <StackPanel Spacing="3"
                                                                          IsVisible="{Binding OtherCount}">
                                                                  <TextBlock Text="其他"
                                                                             FontSize="11"
                                                                             FontWeight="SemiBold"
                                                                             Foreground="{DynamicResource CalyAccentSlateBrush}"
                                                                             Opacity="0.7"/>
                                                                  <ItemsControl ItemsSource="{Binding OtherEntities}">
                                                                      <ItemsControl.ItemsPanel>
                                                                          <ItemsPanelTemplate>
                                                                              <WrapPanel/>
                                                                          </ItemsPanelTemplate>
                                                                      </ItemsControl.ItemsPanel>
                                                                      <ItemsControl.ItemTemplate>
                                                                          <DataTemplate x:DataType="models:EnrichedEntityEntry">
                                                                              <Border Padding="6,4"
                                                                                      Margin="0,0,2,2"
                                                                                      CornerRadius="3"
                                                                                      Background="{DynamicResource CalyTagSteelBackgroundBrush}"
                                                                                      BorderThickness="1"
                                                                                      BorderBrush="{DynamicResource CalyTagSteelBorderBrush}"
                                                                                      Opacity="0.7">
                                                                                  <StackPanel Spacing="2">
                                                                                          <TextBlock FontSize="11"
                                                                                                     Foreground="{DynamicResource CalyTagSteelForegroundBrush}"
                                                                                                     Text="{Binding ArrowDisplayText}"
                                                                                                     FontWeight="SemiBold"/>
                                                                                          <StackPanel Orientation="Horizontal"
                                                                                                    Spacing="6">
                                                                                              <TextBlock Text="{Binding StatusIcon}"
                                                                                                         FontSize="11"
                                                                                                         Foreground="{Binding StatusColor}"/>
                                                                                              <TextBlock Text="{Binding QuickSummary}"
                                                                                                         FontSize="11"
                                                                                                         Opacity="0.6"
                                                                                                         IsVisible="{Binding IsEnriched}"/>
                                                                                          </StackPanel>
                                                                                          <TextBlock FontSize="11"
                                                                                                     Foreground="{DynamicResource CalyErrorForegroundBrush}"
                                                                                                     IsVisible="{Binding ValidationStatus, Converter={StaticResource EqualsConverter}, ConverterParameter=invalid}"
                                                                                                     TextWrapping="Wrap"
                                                                                                     Text="{Binding ValidationReason, StringFormat='✗ {0}'}"/>
                                                                                  </StackPanel>
                                                                              </Border>
                                                                          </DataTemplate>
                                                                      </ItemsControl.ItemTemplate>
                                                                  </ItemsControl>
                                                              </StackPanel>
                                                          </StackPanel>
                                                      </Border>
                                                  </DataTemplate>
                                              </ItemsControl.ItemTemplate>
                                          </ItemsControl>
                                      </ScrollViewer>
                                  </DockPanel>
                              </Border>

                             <!-- GridSplitter between Enriched and Term -->
                             <GridSplitter Grid.Column="5"
                                           HorizontalAlignment="Right"
                                           Width="4"
                                           Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                           IsVisible="{Binding ShowTermColumn}"/>

                              <!-- Column 7: Term Discovery Tree -->
                              <Border Grid.Column="6"
                                      Padding="8"
                                      Background="{DynamicResource SystemChromeLowColor}"
                                      BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                      BorderThickness="1"
                                      IsVisible="{Binding ShowTermColumn}">
                                  <DockPanel>
                                      <!-- Header -->
                                      <Grid DockPanel.Dock="Top"
                                            Margin="0,0,0,6">
                                          <StackPanel Spacing="2">
                                              <TextBlock Text="术语"
                                                         FontWeight="Bold"
                                                         FontSize="12"/>
                                              <TextBlock Text="{Binding TermStatusText}"
                                                         FontSize="11"
                                                         Opacity="0.5"/>
                                          </StackPanel>
                                      </Grid>

                                       <!-- Processing State: shown during term processing -->
                                       <Border IsVisible="{Binding IsTermProcessing}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Stretch">
                                           <StackPanel VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       Spacing="12">
                                               <PathIcon Width="32"
                                                         Height="32"
                                                         Data="{StaticResource spinner_regular}"
                                                         Foreground="{DynamicResource SystemAccentColor}"
                                                         HorizontalAlignment="Center"/>
                                               <TextBlock Text="{Binding TermStatusText}"
                                                          FontSize="13"
                                                          HorizontalAlignment="Center"
                                                          TextAlignment="Center"/>
                                           </StackPanel>
                                       </Border>

                                       <!-- Tree Content: hidden during processing -->
                                       <ScrollViewer IsVisible="{Binding !IsTermProcessing}"
                                                     HorizontalScrollBarVisibility="Auto"
                                                     VerticalScrollBarVisibility="Auto">
                                           <TreeView ItemsSource="{Binding TermBlockViewModel.RootNodes}"
                                                    BorderThickness="0"
                                                    Background="Transparent">
                                              <TreeView.ItemTemplate>
                                                  <TreeDataTemplate ItemsSource="{Binding Children}">
                                                      <StackPanel Orientation="Horizontal"
                                                                  Spacing="4"
                                                                  Margin="0,1">
                                                          <!-- Expand/Collapse arrow handled by TreeView -->
                                                          <Border Padding="4,2"
                                                                  CornerRadius="3"
                                                                  Background="{DynamicResource SystemChromeMediumLowColor}">
                                                              <StackPanel Spacing="2">
                                                                  <!-- Term name -->
                                                                  <TextBlock FontSize="11"
                                                                             FontWeight="SemiBold"
                                                                             Text="{Binding Term}"/>
                                                                  <!-- Category and Score -->
                                                                  <StackPanel Orientation="Horizontal"
                                                                              Spacing="4">
                                                                      <TextBlock FontSize="11"
                                                                                 Foreground="{Binding CategoryColorHex}"
                                                                                 Text="{Binding Category}"/>
                                                                      <TextBlock FontSize="11"
                                                                                 Opacity="0.5"
                                                                                 Text="{Binding ScoreDisplay, StringFormat='s={0}'}"/>
                                                                  </StackPanel>
                                                                  <!-- P2: Relation type and confidence (only for non-root nodes) -->
                                                                  <StackPanel Orientation="Horizontal"
                                                                              Spacing="4"
                                                                              IsVisible="{Binding HasRelationInfo}">
                                                                      <TextBlock FontSize="11"
                                                                                 Foreground="{DynamicResource CalyInfoForegroundBrush}"
                                                                                 FontWeight="SemiBold"
                                                                                 Text="{Binding RelationTypeDisplay}"/>
                                                                      <TextBlock FontSize="11"
                                                                                 Foreground="{DynamicResource CalyMutedForegroundBrush}"
                                                                                 Text="{Binding RelationConfidenceDisplay}"/>
                                                                  </StackPanel>
                                                                  <!-- Definition -->
                                                                  <TextBlock FontSize="11"
                                                                             Opacity="0.4"
                                                                             FontStyle="Italic"
                                                                             Text="{Binding Definition}"
                                                                              TextWrapping="Wrap"
                                                                              MaxWidth="240"/>
                                                                  <!-- P2: Relation evidence (only for non-root nodes with evidence) -->
                                                                  <TextBlock FontSize="11"
                                                                             Opacity="0.3"
                                                                             Foreground="{DynamicResource CalyMutedForegroundBrush}"
                                                                             Text="{Binding RelationEvidenceDisplay}"
                                                                             TextWrapping="Wrap"
                                                                             MaxWidth="240"
                                                                             IsVisible="{Binding HasParentRelationEvidence}"/>
                                                              </StackPanel>
                                                          </Border>
                                                      </StackPanel>
                                                  </TreeDataTemplate>
                                              </TreeView.ItemTemplate>
                                          </TreeView>
                                      </ScrollViewer>
                                  </DockPanel>
                              </Border>

                             <controls:ConnectionLinesControl 
                                 Grid.Column="0"
                                 Grid.ColumnSpan="7"
                                 Name="PART_ConnectionLinesControl"
                                 IsVisible="True"
                                 IsHitTestVisible="False"/>

                             <!-- Formula Overlay (covers all columns) -->
                             <Panel Grid.Column="0"
                                    Grid.ColumnSpan="7"
                                    IsVisible="{Binding ShowFormulaPanel}">
                                 <Rectangle Fill="{DynamicResource CalyScrimBrush}"/>
                                 <Border Background="{DynamicResource CalyCardBackgroundBrush}"
                                         BorderBrush="{DynamicResource CalyCardBorderBrush}"
                                         BorderThickness="1"
                                         CornerRadius="4"
                                         Padding="16"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         MaxWidth="700"
                                         MaxHeight="600">
                                     <DockPanel>
                                         <!-- Header: title left, filter + close buttons right -->
                                         <Grid DockPanel.Dock="Top"
                                               Margin="0,0,0,12">
                                             <StackPanel Orientation="Horizontal"
                                                         Spacing="8">
                                                 <TextBlock Text="公式索引"
                                                            FontWeight="Bold"
                                                            FontSize="16"
                                                            Foreground="{DynamicResource CalyStrongForegroundBrush}"
                                                            VerticalAlignment="Center"/>
                                                 <TextBlock Text="{Binding FormulaStatusText}"
                                                            FontSize="12"
                                                            Opacity="0.5"
                                                            VerticalAlignment="Center"/>
                                             </StackPanel>
                                             <StackPanel Orientation="Horizontal"
                                                         HorizontalAlignment="Right"
                                                         Spacing="8">
                                                 <ToggleButton FontSize="11"
                                                               Padding="8,4"
                                                               IsChecked="{Binding FilterByVisiblePages}"
                                                               ToolTip.Tip="仅显示当前可见页面上的公式"
                                                               AutomationProperties.Name="仅显示当前可见页面上的公式"
                                                               CornerRadius="4">
                                                             <StackPanel Orientation="Horizontal" Spacing="4">
                                                                 <Path Classes="toolIcon" Width="12" Height="12" Data="{StaticResource glyph_blocks_regular}"/>
                                                                 <TextBlock Text="当前页" VerticalAlignment="Center"/>
                                                             </StackPanel>
                                                         </ToggleButton>
                                                 <Button 
                                                         Command="{Binding CloseFormulaPanelCommand}"
                                                     AutomationProperties.Name="关闭公式面板"
                                                         ToolTip.Tip="关闭公式面板"
                                                         Padding="8,4">
                                                     <Path Classes="toolIcon" Width="14" Height="14" Data="{StaticResource glyph_close_regular}"/>
                                                 </Button>
                                             </StackPanel>
                                         </Grid>
                                         <!-- Formula list (no expander, direct display) -->
                                         <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                       MaxHeight="500">
                                             <ItemsControl ItemsSource="{Binding DisplayedFormulaBlockViewModels}">
                                                 <ItemsControl.ItemTemplate>
                                                     <DataTemplate x:DataType="vm:FormulaBlockViewModel">
                                                         <Border Padding="10"
                                                                 Margin="0,0,0,8"
                                                                 BorderBrush="{DynamicResource CalyChipBorderBrush}"
                                                                 BorderThickness="1"
                                                                 CornerRadius="4"
                                                                 Background="{DynamicResource CalyChipBackgroundBrush}">
                                                             <StackPanel Spacing="6">
                                                                 <StackPanel Orientation="Horizontal"
                                                                             Spacing="6">
                                                                     <Border Padding="4,2"
                                                                             CornerRadius="2"
                                                                             Background="{DynamicResource CalyPurpleSolidBrush}">
                                                                         <TextBlock Text="{Binding DisplayLabel}"
                                                                                    FontSize="11"
                                                                                    FontWeight="SemiBold"
                                                                                    Foreground="{DynamicResource CalyOnSolidBrush}"/>
                                                                     </Border>
                                                                     <TextBlock Text="{Binding FormulaCode}"
                                                                                FontSize="11"
                                                                                Opacity="0.6"/>
                                                                     <TextBlock Text="{Binding Page, StringFormat='(P{0})'}"
                                                                                FontSize="11"
                                                                                Opacity="0.4"/>
                                                                 </StackPanel>
                                                                  <TextBlock Text="{Binding RenderedContent}"
                                                                  FontSize="14"
                                                                  Foreground="{DynamicResource CalyOnAccentForegroundBrush}"
                                                                  FontWeight="Medium"
                                                                  TextWrapping="Wrap"
                                                                  Margin="0,2,0,0"/>
                                                                 <TextBlock Text="{Binding RawContent}"
                                                                            FontFamily="{DynamicResource CalyMonoFontFamily}"
                                                                            FontSize="11"
                                                                            Foreground="{DynamicResource CalyMutedForegroundBrush}"
                                                                            TextWrapping="Wrap"/>
                                                             </StackPanel>
                                                         </Border>
                                                     </DataTemplate>
                                                 </ItemsControl.ItemTemplate>
                                             </ItemsControl>
                                         </ScrollViewer>
                                     </DockPanel>
                                 </Border>
                             </Panel>

                             <!-- TOC Overlay (covers all columns) -->
                             <Panel Grid.Column="0"
                                    Grid.ColumnSpan="7"
                                    IsVisible="{Binding ShowTocPanel}">
                                 <Rectangle Fill="{DynamicResource CalyScrimBrush}"/>
                                 <Border Background="{DynamicResource CalyCardBackgroundBrush}"
                                         BorderBrush="{DynamicResource CalyCardBorderBrush}"
                                         BorderThickness="1"
                                         CornerRadius="4"
                                         Padding="16"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         MaxWidth="800"
                                         MaxHeight="600">
                                     <DockPanel>
                                         <StackPanel Orientation="Horizontal"
                                                     DockPanel.Dock="Top"
                                                     HorizontalAlignment="Right"
                                                     Margin="0,0,0,8">
                                              <TextBlock Text="目录"
                                                         FontWeight="Bold"
                                                         FontSize="16"
                                                         Foreground="{DynamicResource CalyStrongForegroundBrush}"
                                                         VerticalAlignment="Center"/>
                                             <Button 
                                                     Command="{Binding CloseTocPanelCommand}"
                                                     Margin="12,0,0,0"
                                                 AutomationProperties.Name="关闭目录面板"
                                                         ToolTip.Tip="关闭目录面板"
                                                     Padding="8,4">
                                                 <Path Classes="toolIcon" Width="14" Height="14" Data="{StaticResource glyph_close_regular}"/>
                                             </Button>
                                         </StackPanel>
                                         <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                       MaxHeight="500">
                                             <TextBlock Text="{Binding TocMarkdownText}"
                                                        TextWrapping="Wrap"
                                                        FontFamily="{DynamicResource CalyMonoFontFamily}"
                                                        FontSize="12"
                                                        Foreground="{DynamicResource CalyStrongForegroundBrush}"/>
                                         </ScrollViewer>
                                     </DockPanel>
                                 </Border>
                             </Panel>

                             <!-- Reference Overlay (covers all columns) -->
                             <Panel Grid.Column="0"
                                    Grid.ColumnSpan="6"
                                    IsVisible="{Binding ShowReferencePanel}">
                                 <Rectangle Fill="{DynamicResource CalyScrimBrush}"/>
                                 <Border Background="{DynamicResource CalyCardBackgroundBrush}"
                                         BorderBrush="{DynamicResource CalyCardBorderBrush}"
                                         BorderThickness="1"
                                         CornerRadius="4"
                                         Padding="16"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         MaxWidth="800"
                                         MaxHeight="600">
                                     <DockPanel>
                                         <StackPanel Orientation="Horizontal"
                                                     DockPanel.Dock="Top"
                                                     HorizontalAlignment="Right"
                                                     Margin="0,0,0,8">
                                              <TextBlock Text="参考文献"
                                                         FontWeight="Bold"
                                                         FontSize="16"
                                                         Foreground="{DynamicResource CalyStrongForegroundBrush}"
                                                         VerticalAlignment="Center"/>
                                             <Button 
                                                     Command="{Binding CloseReferencePanelCommand}"
                                                     Margin="12,0,0,0"
                                                 AutomationProperties.Name="关闭参考文献面板"
                                                         ToolTip.Tip="关闭参考文献面板"
                                                     Padding="8,4">
                                                 <Path Classes="toolIcon" Width="14" Height="14" Data="{StaticResource glyph_close_regular}"/>
                                             </Button>
                                         </StackPanel>
                                         <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                       MaxHeight="500">
                                             <TextBlock Text="{Binding ReferenceMarkdownText}"
                                                        TextWrapping="Wrap"
                                                        FontFamily="{DynamicResource CalyMonoFontFamily}"
                                                        FontSize="12"
                                                        Foreground="{DynamicResource CalyStrongForegroundBrush}"/>
                                         </ScrollViewer>
                                     </DockPanel>
                                 </Border>
                             </Panel>
                        </Grid>
                        </Grid>
                    </SplitView.Content>

						<!-- Left navigation bar -->
						<SplitView.Pane>

							<Grid ColumnDefinitions="*,5"
                                  IsVisible="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).IsDocumentPaneOpen}">

                                <Border Grid.Column="0"
                                        BorderThickness="1">

									<TabControl Name="PART_TabControlNavigation"
												TabStripPlacement="Left"
												Padding="12,0,0,0"
												SelectedIndex="{Binding SelectedTabIndex}">

										<!-- Thumbnails tab -->
										<TabItem MinHeight="40"
												 IsSelected="True">
											<TabItem.Header>
												<PathIcon Width="17"
														  Height="17"
														  Data="{StaticResource thumbnail_regular}">
													<ToolTip.Tip>缩略图</ToolTip.Tip>
												</PathIcon>
											</TabItem.Header>
											<Grid>
                                                <controls:ThumbnailItemsControl
                                                    IsVisible="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).IsDocumentPaneOpen}"
                                                    RefreshThumbnails="{Binding RefreshThumbnailsCommand}"
													RealisedThumbnails="{Binding RealisedThumbnails}"
													VisibleThumbnails="{Binding VisibleThumbnails}"
                                                    Background="Transparent"
                                                    SelectionMode="Single,AlwaysSelected"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"
                                                    BorderThickness="0"
                                                    ItemsSource="{Binding Pages}"
                                                    SelectedIndex="{Binding SelectedPageIndex, Mode=TwoWay}">

                                                    <controls:ThumbnailItemsControl.Styles>
                                                        <Style Selector="ListBoxItem">
                                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                                        </Style>
                                                    </controls:ThumbnailItemsControl.Styles>

                                                    <controls:ThumbnailItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:PageViewModel">
                                                            
                                                             <Grid Margin="3,4"
                                                                   Width="{Binding ThumbnailSize.Width}"
                                                                   Height="{Binding ThumbnailSize.Height}">
                                                                 <controls:ThumbnailControl VisibleArea="{Binding VisibleArea}"
                                                                         ThumbnailSize="{Binding ThumbnailSize}"
                                                                         PageSize="{Binding Size}"
                                                                         HorizontalAlignment="Stretch"
                                                                         VerticalAlignment="Stretch"/>
                                                                 <!-- Page Type Badge -->
                                                                 <Label Content="{Binding PageTypeBadgeText}"
                                                                        IsVisible="{Binding HasPageType}"
                                                                        MinWidth="25"
                                                                        HorizontalAlignment="Left"
                                                                        HorizontalContentAlignment="Center"
                                                                        VerticalAlignment="Top"
                                                                        Padding="3,0"
                                                                        Margin="3"
                                                                        FontSize="11"
                                                                        Background="{DynamicResource CalyScrimBrush}"
                                                                        Foreground="{DynamicResource CalyOnSolidBrush}"
                                                                        BorderThickness="0"
                                                                        CornerRadius="7"/>
                                                                 <Label Content="{Binding PageNumber}"
                                                                       MinWidth="25"
                                                                       HorizontalAlignment="Center"
                                                                       HorizontalContentAlignment="Center"
                                                                       VerticalAlignment="Bottom"
                                                                       Padding="3,0"
                                                                       Margin="3"
                                                                       Background="{DynamicResource SystemChromeMediumLowColor}"
                                                                       BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                                                       BorderThickness="1"
                                                                       CornerRadius="7"/>
                                                            </Grid>

                                                        </DataTemplate>
                                                    </controls:ThumbnailItemsControl.ItemTemplate>

                                                </controls:ThumbnailItemsControl>
                                            </Grid>
										</TabItem>

										<!-- Bookmarks tab -->
                                        <TabItem MinHeight="40"
                                                 IsVisible="{Binding BookmarksSource^, Converter={StaticResource IsNotNullConverter}}"
                                                 IsEnabled="{Binding BookmarksSource^, Converter={StaticResource IsNotNullConverter}}">
											<TabItem.Header>
												<PathIcon Width="17"
														  Height="17"
														  Data="{StaticResource bookmark_regular}">
													<ToolTip.Tip>书签</ToolTip.Tip>
												</PathIcon>
											</TabItem.Header>

                                            <TreeDataGrid Source="{Binding BookmarksSource^}"
                                                          ShowColumnHeaders="False"
                                                          CanUserSortColumns="False"
                                                          HorizontalAlignment="Stretch"
                                                          AutoScrollHorizontally="False"
                                                          AutoScrollSelectionIntoView="True"/>
										</TabItem>

										<!-- Search tab -->
										<TabItem MinHeight="40">
											<TabItem.Header>
												<PathIcon Width="17"
														  Height="17"
														  Data="{StaticResource document_search_regular}">
													<ToolTip.Tip>搜索</ToolTip.Tip>
												</PathIcon>
											</TabItem.Header>

											<controls:FullSearchPanelControl/>
										</TabItem>

										<!-- Doc information tab -->
										<TabItem MinHeight="40">
											<TabItem.Header>
												<PathIcon Width="17"
														  Height="17"
														  Data="{StaticResource info_regular}">
													<ToolTip.Tip>文档属性</ToolTip.Tip>
												</PathIcon>
											</TabItem.Header>

											<controls:DocumentPropertiesControl DataContext="{Binding Properties^}"/>

										</TabItem>

                                        <!-- Embedded files tab -->
                                        <TabItem MinHeight="40"
                                                 IsVisible="{Binding !!EmbeddedFiles^.Count}"
                                                 IsEnabled="{Binding !!EmbeddedFiles^.Count}">
                                            <TabItem.Header>
                                                <PathIcon Width="17"
                                                          Height="17"
                                                          Data="{StaticResource attach_text_regular}">
                                                    <ToolTip.Tip>嵌入文件</ToolTip.Tip>
                                                </PathIcon>
                                            </TabItem.Header>
                                            
                                            <ListBox ItemsSource="{Binding EmbeddedFiles^}"
                                                     Background="Transparent">
                                                <ListBox.Styles>
                                                    <Style Selector="ListBoxItem">
                                                        <Setter Property="Padding" Value="5,0" />
                                                    </Style>
                                                </ListBox.Styles>


                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel Background="Transparent"
                                                                   HorizontalSpacing="5"
                                                                   HorizontalAlignment="Stretch"
																   VerticalAlignment="Stretch"
                                                                   PointerPressed="EmbeddedFiles_OnPointerPressed"
                                                                   MinHeight="20">

                                                            <TextBlock DockPanel.Dock="Left"
                                                                       Text="{Binding Name}"
                                                                       HorizontalAlignment="Left"
                                                                       VerticalAlignment="Center"/>

                                                            <TextBlock DockPanel.Dock="Right"
                                                                       Text="{Binding FileSize}"
                                                                       HorizontalAlignment="Right"
                                                                       VerticalAlignment="Center"/>

                                                            <DockPanel.ContextFlyout>
                                                                <MenuFlyout>
                                                                    <MenuItem Header="Open" Command="{Binding OpenCommand}">
                                                                        <MenuItem.Icon>
                                                                            <PathIcon Width="15" Height="15" Data="{StaticResource open_regular}"/>
                                                                        </MenuItem.Icon>
                                                                    </MenuItem>

                                                                    <MenuItem Header="Save As..." Command="{Binding SaveAsCommand}">
                                                                        <MenuItem.Icon>
                                                                            <PathIcon Width="15" Height="15" Data="{StaticResource save_regular}"/>
                                                                        </MenuItem.Icon>
                                                                    </MenuItem>
                                                                </MenuFlyout>
                                                            </DockPanel.ContextFlyout>

                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </TabItem>

                                        <!-- AI Analysis tab -->
                                        <TabItem MinHeight="40"
                                                 IsVisible="{Binding HasStructureDocument}"
                                                 IsEnabled="{Binding HasStructureDocument}">
                                            <TabItem.Header>
                                                <PathIcon Width="17"
                                                          Height="17"
                                                          Data="{StaticResource nlp_process_regular}">
                                                    <ToolTip.Tip>AI 分析</ToolTip.Tip>
                                                </PathIcon>
                                            </TabItem.Header>

                                            <controls:AnalysisView DataContext="{Binding AnalysisViewModel}"/>
                                        </TabItem>

									</TabControl>
								</Border>

								<!-- Resize left navigation bar -->
                                <Grid Grid.Column="1"
									  Background="Transparent"
                                      PointerMoved="Resize_OnPointerMoved"
                                      PointerEntered="Resize_OnPointerEntered"
                                      PointerExited="Resize_OnPointerExited"
                                      PointerPressed="Resize_OnPointerPressed"
                                      PointerReleased="Resize_OnPointerReleased">
                                    <Rectangle Width="{DynamicResource CalySplitViewHandleWidth}"
                                               HorizontalAlignment="Center"
                                               Fill="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"/>
                                </Grid>
							</Grid>
						</SplitView.Pane>

					</SplitView>

				</Grid>

			</DataTemplate>
		</TabControl.ContentTemplate>
	</tabalonia:TabsControl>

</UserControl>