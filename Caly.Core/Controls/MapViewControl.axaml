<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="400"
             x:Class="Caly.Core.Controls.MapViewControl">

    <DockPanel Margin="8">
        <!-- Header -->
        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    Spacing="4"
                    Margin="0,0,0,8">
            <TextBlock Text="Map"
                       FontWeight="Bold"
                       FontSize="12"/>
        </StackPanel>

        <!-- Status -->
        <Border DockPanel.Dock="Top"
                Padding="8"
                Margin="0,0,0,8"
                Background="{DynamicResource SystemChromeMediumLowColor}"
                CornerRadius="4">
            <StackPanel Spacing="6">
                <TextBlock Name="PART_StatusText"
                           Text="No location data available."
                           FontSize="11"
                           Opacity="0.7"
                           TextWrapping="Wrap"/>
                
                <TextBlock Name="PART_GeoJsonPathText"
                           FontSize="10"
                           Opacity="0.5"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Actions -->
        <StackPanel DockPanel.Dock="Bottom"
                    Spacing="4"
                    Margin="0,8,0,0">
            <Button Name="PART_OpenInGeoLibreBtn"
                    Content="Open in GeoLibre"
                    Click="OnOpenInGeoLibre"
                    IsEnabled="False"
                    HorizontalAlignment="Stretch"/>
            
            <Button Name="PART_ExportGeoLibreBtn"
                    Content="导出 GeoLibre JSON"
                    Click="OnExportGeoLibre"
                    HorizontalAlignment="Stretch"/>
            
            <Button Name="PART_RefreshBtn"
                    Content="Refresh GeoJSON"
                    Click="OnRefreshGeoJson"
                    HorizontalAlignment="Stretch"/>
        </StackPanel>

        <!-- Placeholder for future WebView -->
        <Border Background="{DynamicResource SystemChromeLowColor}"
                CornerRadius="4"
                Margin="0,0,0,8">
            <Grid>
                <TextBlock Text="WebView will be integrated here"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Opacity="0.4"
                           FontSize="11"/>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>