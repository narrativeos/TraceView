<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:Caly.Core.Controls"
                    xmlns:vm="clr-namespace:Caly.Core.ViewModels"
                    xmlns:progRing="clr-namespace:AvaloniaProgressRing;assembly=AvaloniaProgressRing"
                    xmlns:utilities="clr-namespace:Caly.Core.Utilities"
                    xmlns:rendering="clr-namespace:Caly.Core.Controls.Rendering">

    <Design.PreviewWith>
		<StackPanel Width="400" Height="400">
			<controls:PageItem x:DataType="vm:PageViewModel"
                               Picture="{Binding PdfPicture}"
                               IsPageRendering="{Binding IsPageRendering}"/>
		</StackPanel>
	</Design.PreviewWith>

	<ControlTheme x:Key="{x:Type controls:PageItem}"
                  TargetType="controls:PageItem"
                  x:DataType="vm:PageViewModel">

        <!-- 卡片之间留 24px 纸面间隙（上下各 12），让阴影与点阵底有呼吸空间。 -->
        <Setter Property="Margin" Value="0,12"/>
        <Setter Property="Exception" Value="{Binding Exception}"/>
		<Setter Property="Width" Value="{Binding DisplayWidth}"/>
		<Setter Property="Height" Value="{Binding DisplayHeight}"/>
        <Setter Property="IsRotating" Value="{Binding IsRotating}"/>
        <Setter Property="Rotation" Value="{Binding Rotation}"/>
		<Setter Property="Picture" Value="{Binding PdfPicture}"/>
		<Setter Property="VisibleArea" Value="{Binding VisibleArea}"/>
		<Setter Property="IsPageRendering" Value="{Binding IsPageRendering}"/>
		<Setter Property="IsPageVisible" Value="{Binding IsPageVisible}"/>

		<!-- ContextFlyout -->
		<Setter Property="ContextFlyout">
			<MenuFlyout>
				<MenuItem Header="{DynamicResource StringTextFlyoutCopyText}"
                          Command="{Binding $parent[controls:PageItemsControl].((vm:DocumentViewModel)DataContext).CopyTextCommand}"
                          InputGesture="{x:Static utilities:CalyHotkeyConfiguration.CopyGesture}"/>

				<Separator/>

				<MenuItem Header="顺时针旋转本页"
                          Command="{Binding RotateClockwiseCommand}"
                          CommandParameter="{Binding PageNumber}">
					<MenuItem.Icon>
						<PathIcon Width="15"
                                  Height="15"
                                  Data="{StaticResource arrow_rotate_clockwise_regular}"/>
					</MenuItem.Icon>
				</MenuItem>

				<MenuItem Header="逆时针旋转本页"
                          Command="{Binding RotateCounterclockwiseCommand}"
                          CommandParameter="{Binding PageNumber}">
					<MenuItem.Icon>
						<PathIcon Width="15"
                                  Height="15"
                                  Data="{StaticResource arrow_rotate_counterclockwise_regular}"/>
					</MenuItem.Icon>
				</MenuItem>

				<Separator/>

				<MenuItem Header="查看本页颜色空间"
				          Command="{Binding $parent[controls:PageItemsControl].((vm:DocumentViewModel)DataContext).ViewPageColorSpacesCommand}"
				          CommandParameter="{Binding PageNumber}"/>
			</MenuFlyout>
		</Setter>

		<!-- Page -->
		<Setter Property="Template">
			<ControlTemplate>

				<ContentPresenter Name="PART_ContentPresenter">
					<ContentPresenter.Content>

						<!--
							卡片外壳：纸面卡片 = 卡片底色 + 1px 发丝线 + 8 圆角 + 双层柔和阴影。
							ClipToBounds 让方形 PDF 页被裁成圆角，避免纸角溢出描边。
						-->
						<Border Name="PART_CardBorder"
								Background="{DynamicResource CalyCardBackgroundBrush}"
								BorderBrush="{DynamicResource CalyCardBorderBrush}"
								BorderThickness="1"
								CornerRadius="{StaticResource CalyCardCornerRadius}"
								BoxShadow="0 1 2 #14000000, 0 6 20 #12000000"
								ClipToBounds="True">

						<LayoutTransformControl>
							<LayoutTransformControl.LayoutTransform>
								<RotateTransform Angle="{Binding Rotation}" />
							</LayoutTransformControl.LayoutTransform>

							<Grid Background="{DynamicResource CalyPaperBrush}"
								  Width="{Binding Size.Width}"
								  Height="{Binding Size.Height}">

								<Viewbox Width="{Binding ProgressRingSize}"
										 Height="{Binding ProgressRingSize}"
										 Margin="{Binding ProgressRingMargin}"
										 IsVisible="{Binding IsPageRendering}"
										 IsEnabled="{Binding IsPageRendering}"
										 HorizontalAlignment="Left"
										 VerticalAlignment="Top">
									<progRing:ProgressRing Width="50"
														   Height="50"
														   IsActive="{Binding IsPageRendering}"
														   Foreground="{DynamicResource SystemAccentColor}"/>
								</Viewbox>

								<rendering:TiledPdfPageControl TileRenderService="{Binding TileRenderService}"
                                                               Picture="{Binding PdfPicture}"
                                                               PpiScale="{Binding PpiScale}"
                                                               VisibleArea="{Binding VisibleArea}"
                                                               IsPageVisible="{Binding IsPageVisible}"
                                                               PageNumber="{Binding PageNumber}"
                                                               PageDisplaySize="{Binding Size}"
                                                               ZoomLevel="{Binding $parent[controls:PageItemsControl].ZoomLevel}"
                                                               HorizontalAlignment="Stretch"
                                                               VerticalAlignment="Stretch"/>

								<controls:PageInteractiveLayerControl Name="PART_PageInteractiveLayerControl"
                                                                       VisibleArea="{Binding VisibleArea}"
                                                                       PdfTextLayer="{Binding PdfTextLayer}"
                                                                       PageNumber="{Binding PageNumber}"
																	  SelectedWords="{Binding SelectedWords}"
																	  SearchResults="{Binding SearchResults}"
                                                                       HorizontalAlignment="Stretch"
                                                                       VerticalAlignment="Stretch">

									<FlyoutBase.AttachedFlyout>
										<Flyout ShowMode="Standard"
												Placement="Pointer"
												HorizontalOffset="15"
												OverlayInputPassThroughElement="{Binding $parent}"/>
									</FlyoutBase.AttachedFlyout>

								</controls:PageInteractiveLayerControl>

                                                                 <controls:BlockOverlayControl IsVisible="{Binding HasMinerUBlocks}"
                                                                  PageSize="{Binding Size}"
                                                                  PpiScale="{Binding PpiScale}"
                                                                  ZoomLevel="{Binding $parent[controls:PageItemsControl].ZoomLevel}"
                                                                  Blocks="{Binding PreprocBlocks}"
                                                                 VisibleArea="{Binding VisibleArea}"
                                                                 ShowBlockIndex="True"
                                                                 HighlightBlockId="{Binding $parent[controls:PageItemsControl].((vm:DocumentViewModel)DataContext).AnalysisViewModel.SelectedBlockId, FallbackValue={x:Null}}"
                                                                 RelatedHighlightBlockIds="{Binding $parent[controls:PageItemsControl].((vm:DocumentViewModel)DataContext).SelectedMinerUBlockRelatedIds, FallbackValue={x:Null}}"
                                                                 RelatedHighlightDestinationType="{Binding $parent[controls:PageItemsControl].((vm:DocumentViewModel)DataContext).SelectedMinerUBlockDestinationType, FallbackValue={x:Null}}"
                                                                 ShowLabels="True"
                                                                 HorizontalAlignment="Stretch"
                                                                 VerticalAlignment="Stretch"/>

                                                                 <!-- White balance marker -->
                                                                 <Border IsVisible="{Binding IsWhiteBalanced}"
                                                                         HorizontalAlignment="Right"
                                                                         VerticalAlignment="Top"
                                                                         Margin="0,6,6,0"
                                                                         CornerRadius="3"
                                                                         Background="{DynamicResource CalyBadgeBackgroundBrush}"
                                                                         BorderBrush="{DynamicResource CalyBadgeBorderBrush}"
                                                                         BorderThickness="1"
                                                                         Padding="5,2">
                                                                     <StackPanel Orientation="Horizontal"
                                                                                 Spacing="4"
                                                                                 VerticalAlignment="Center">
                                                                         <Ellipse Width="7"
                                                                                  Height="7"
                                                                                  Fill="{DynamicResource CalySelectionFillBrush}"
                                                                                  VerticalAlignment="Center"/>
                                                                         <TextBlock Text="白平衡"
                                                                                    FontSize="11"
                                                                                    Foreground="{DynamicResource CalyOnSolidBrush}"
                                                                                    VerticalAlignment="Center"/>
                                                                     </StackPanel>
                                                                 </Border>

							</Grid>
						</LayoutTransformControl>

						</Border>

					</ContentPresenter.Content>
				</ContentPresenter>

			</ControlTemplate>
		</Setter>

	</ControlTheme>

</ResourceDictionary>
