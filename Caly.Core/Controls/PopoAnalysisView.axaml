<UserControl xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:controls="using:Caly.Core.Controls"
                     xmlns:vm="using:Caly.Core.ViewModels"
                     xmlns:agent="using:Caly.Core.Services.Agent"
                     x:Class="Caly.Core.Controls.AnalysisView"
                     x:DataType="vm:AnalysisViewModel">

    <Grid>
        <!-- Main content -->
        <DockPanel>
            <!-- Top toolbar -->
            <StackPanel Orientation="Horizontal"
                        DockPanel.Dock="Top"
                        Margin="4"
                        Spacing="4">
                <Button Content="Block 叠加"
                        Command="{Binding ToggleTypeFilterCommand}"
                        CommandParameter="text"
                        MinWidth="80"/>
                <Button Content="重置选择"
                        Command="{Binding ResetSelectionCommand}"
                        MinWidth="80"/>
                <Button Content="对齐报告"
                        Command="{Binding GenerateAlignmentReportCommand}"
                        MinWidth="80"/>
                <Button Content="生成目录"
                        Command="{Binding GenerateTocCommand}"
                        IsEnabled="{Binding CanGenerateToc}"
                        MinWidth="80"/>
                <Button Content="参考文献"
                        Command="{Binding GenerateReferencesCommand}"
                        IsEnabled="{Binding CanGenerateReferences}"
                        MinWidth="80"/>
                <Button Content="TOC 对齐 (Agent)"
                        Command="{Binding RunTocAlignAgentCommand}"
                        IsEnabled="{Binding !IsAgentRunning}"
                        ToolTip.Tip="由智能体重新编排目录并对齐正文，生成待确认补丁"
                        MinWidth="80"/>
                <Button Content="TOC 规则调优 (Agent)"
                        Command="{Binding SeedTocTunePromptCommand}"
                        ToolTip.Tip="把调优提示词填入对话输入框，由你编辑后发送才开始执行"
                        MinWidth="80"/>
                <Button Content="推送九录文华"
                        Command="{Binding PushToJiuluCommand}"
                        IsEnabled="{Binding !IsAgentRunning}"
                        ToolTip.Tip="将当前 Popo 结构推送至九录文华时空知识中枢"
                        MinWidth="80"/>
                <TextBox PlaceholderText="搜索 Block..."
                         Text="{Binding BlockSearchText}"
                         MinWidth="150"/>
            </StackPanel>

            <!-- The agent conversation moved to its own column (see AgentConversationControl
                 hosted in DocumentsTabsControl); only the run trace stays here. -->

            <!-- Agent run trace (popo.toc-tune): one line per tool outcome -->
            <Expander Header="智能体执行轨迹"
                      DockPanel.Dock="Top"
                      IsVisible="{Binding ShowAgentRunTrace}"
                      Margin="0,4,0,0">
                <TextBlock Text="{Binding AgentRunTraceText}"
                           TextWrapping="Wrap"
                           FontFamily="{DynamicResource CalyMonoFontFamily}"
                           FontSize="12"/>
            </Expander>

            <!-- Main content with tabs -->
            <TabControl>
                <!-- Block List Tab -->
                <TabItem Header="Block 列表">
                    <StackPanel>
                        <controls:BlockListControl DataContext="{Binding}"/>
                    </StackPanel>
                </TabItem>

                <!-- Tree View Tab -->
                <TabItem Header="树形结构">
                    <StackPanel>
                        <controls:TreeViewControl DataContext="{Binding}"/>
                    </StackPanel>
                </TabItem>

                <!-- Markdown Preview Tab -->
                <TabItem Header="Markdown">
                    <StackPanel>
                        <controls:MarkdownPreviewControl DataContext="{Binding}"/>
                    </StackPanel>
                </TabItem>

                <!-- Aggregation Tab -->
                <TabItem Header="聚合关系">
                    <StackPanel>
                        <controls:AggregationViewControl DataContext="{Binding}"/>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </DockPanel>

        <!-- Alignment Report Overlay -->
        <Panel IsVisible="{Binding ShowAlignmentReport}">
            <Rectangle Fill="{DynamicResource CalyScrimBrush}"/>
            <Border Background="{DynamicResource CalyCardBackgroundBrush}"
                    BorderBrush="{DynamicResource CalyCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="800"
                    MaxHeight="600">
                <DockPanel>
                    <StackPanel Orientation="Horizontal"
                                DockPanel.Dock="Top"
                                HorizontalAlignment="Right"
                                Margin="0,0,0,8">
                        <TextBlock Text="MinerU-Popo 对齐报告"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   VerticalAlignment="Center"/>
                        <Button 
                                Command="{Binding CloseAlignmentReportCommand}"
                                AutomationProperties.Name="关闭对齐报告"
                                ToolTip.Tip="关闭对齐报告"
                                Margin="12,0,0,0"
                                Padding="8,4">
                            <Path Classes="toolIcon" Width="14" Height="14" Data="{StaticResource glyph_close_regular}"/>
                        </Button>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  MaxHeight="500">
                        <TextBlock Text="{Binding AlignmentReportText}"
                                   TextWrapping="Wrap"
                                   FontFamily="{DynamicResource CalyMonoFontFamily}"
                                   FontSize="12"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Panel>

        <!-- TOC Overlay -->
        <Panel IsVisible="{Binding ShowTocPanel}">
            <Rectangle Fill="{DynamicResource CalyScrimBrush}"/>
            <Border Background="{DynamicResource CalyCardBackgroundBrush}"
                    BorderBrush="{DynamicResource CalyCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="860"
                    MaxHeight="620">
                <DockPanel>
                    <!-- Header: title on the left, AI orchestration + close on the right -->
                    <Grid DockPanel.Dock="Top"
                          ColumnDefinitions="*,Auto"
                          Margin="0,0,0,12">
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalAlignment="Center">
                            <Border Width="28"
                                    Height="28"
                                    CornerRadius="6"
                                    Background="{DynamicResource CalyTagVioletBackgroundBrush}">
                                <Path Width="15"
                                      Height="15"
                                      Stretch="Uniform"
                                      Stroke="{DynamicResource CalyTagVioletForegroundBrush}"
                                      StrokeThickness="1.7"
                                      StrokeJoin="Round"
                                      StrokeLineCap="Round"
                                      Data="{StaticResource glyph_sparkle_regular}"/>
                            </Border>
                            <StackPanel Spacing="1"
                                        VerticalAlignment="Center">
                                <TextBlock Text="目录"
                                           FontWeight="Bold"
                                           FontSize="15"
                                           Foreground="{DynamicResource CalyStrongForegroundBrush}"/>
                                <TextBlock Text="由文档结构树自动生成"
                                           FontSize="11"
                                           Foreground="{DynamicResource CalyMutedForegroundBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <Button Command="{Binding OpenTocTuneConversationCommand}"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Padding="12,5"
                                    AutomationProperties.Name="TOC AI 重排编排"
                                    ToolTip.Tip="打开内置智能体对话并预填目录重排调优任务，编辑后发送才开始执行">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6">
                                    <Path Classes="toolIcon"
                                          Width="13"
                                          Height="13"
                                          Data="{StaticResource glyph_sparkle_regular}"/>
                                    <TextBlock Text="AI 重排编排"/>
                                </StackPanel>
                            </Button>
                            <Button
                                    Command="{Binding CloseTocPanelCommand}"
                                    AutomationProperties.Name="关闭目录面板"
                                    ToolTip.Tip="关闭目录面板"
                                    Padding="8,4">
                                <Path Classes="toolIcon" Width="14" Height="14" Data="{StaticResource glyph_close_regular}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <!-- TOC revision lineage (M4-C): head badge + append-only replay history -->
                    <StackPanel Orientation="Horizontal"
                                DockPanel.Dock="Top"
                                Spacing="6"
                                Margin="0,0,0,4">
                        <TextBlock Text="!"
                                   FontWeight="Bold"
                                   IsVisible="{Binding TocLineageWarning}"
                                   Foreground="{DynamicResource CalyWarningForegroundBrush}"
                                   VerticalAlignment="Center"
                                   ToolTip.Tip="head 版本存在跳变或编号违规，建议调规则重放"/>
                        <TextBlock Text="{Binding TocLineageBadgeText}"
                                   FontSize="11"
                                   Opacity="0.75"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <ScrollViewer DockPanel.Dock="Top"
                                  MaxHeight="180"
                                  VerticalScrollBarVisibility="Auto"
                                  IsVisible="{Binding HasTocLineage}">
                        <ItemsControl ItemsSource="{Binding TocRevisions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TocRevisionEntryViewModel">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="8"
                                                Margin="0,2">
                                        <TextBlock Text="{Binding Rev, StringFormat='rev {0}'}"
                                                   FontWeight="Bold"
                                                   MinWidth="52"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Source}"
                                                   MinWidth="40"
                                                   Opacity="0.7"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Fingerprint}"
                                                   FontFamily="{DynamicResource CalyMonoFontFamily}"
                                                   FontSize="11"
                                                   Opacity="0.7"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding AtText}"
                                                   FontSize="11"
                                                   Opacity="0.6"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding SummaryText}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="!"
                                                   FontWeight="Bold"
                                                   IsVisible="{Binding Warning}"
                                                   Foreground="{DynamicResource CalyWarningForegroundBrush}"
                                                   VerticalAlignment="Center"/>
                                        <Button Content="按此 rev 重放"
                                                FontSize="11"
                                                Padding="8,2"
                                                Margin="8,0,0,0"
                                                ToolTip.Tip="以该 rev 记录的规则包与覆盖重放目录层，作为新的 rev 记入谱系（页内树保持当前显示）"
                                                IsEnabled="{Binding !$parent[UserControl].((vm:AnalysisViewModel)DataContext).IsTocLineageBusy}"
                                                Command="{Binding $parent[UserControl].((vm:AnalysisViewModel)DataContext).ReplayAtRevisionCommand}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  MaxHeight="500"
                                  Padding="2,0,8,0">
                        <TextBlock Text="{Binding TocMarkdownText}"
                                   TextWrapping="Wrap"
                                   FontFamily="{DynamicResource CalyMonoFontFamily}"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource CalyStrongForegroundBrush}"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Panel>

        <!-- Reference Overlay -->
        <Panel IsVisible="{Binding ShowReferencePanel}">
            <Rectangle Fill="{DynamicResource CalyScrimBrush}"/>
            <Border Background="{DynamicResource CalyCardBackgroundBrush}"
                    BorderBrush="{DynamicResource CalyCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="800"
                    MaxHeight="600">
                <DockPanel>
                    <StackPanel Orientation="Horizontal"
                                DockPanel.Dock="Top"
                                HorizontalAlignment="Right"
                                Margin="0,0,0,8">
                        <TextBlock Text="参考文献"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   VerticalAlignment="Center"/>
                        <Button 
                                Command="{Binding CloseReferencePanelCommand}"
                                AutomationProperties.Name="关闭参考文献面板"
                                ToolTip.Tip="关闭参考文献面板"
                                Margin="12,0,0,0"
                                Padding="8,4">
                            <Path Classes="toolIcon" Width="14" Height="14" Data="{StaticResource glyph_close_regular}"/>
                        </Button>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  MaxHeight="500">
                        <TextBlock Text="{Binding ReferenceMarkdownText}"
                                   TextWrapping="Wrap"
                                   FontFamily="{DynamicResource CalyMonoFontFamily}"
                                   FontSize="12"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Panel>

        <!-- Agent TOC patch Overlay -->
        <Panel IsVisible="{Binding ShowAgentPatchPanel}">
            <Rectangle Fill="{DynamicResource CalyScrimBrush}"/>
            <Border Background="{DynamicResource CalyCardBackgroundBrush}"
                    BorderBrush="{DynamicResource CalyCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="640">
                <StackPanel Spacing="12">
                    <TextBlock Text="TOC 对齐补丁"
                               FontWeight="Bold"
                               FontSize="16"/>
                    <TextBlock Text="{Binding AgentPatchSummary}"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding AgentStatusText}"
                               TextWrapping="Wrap"
                               FontSize="12"/>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="8">
                        <Button Content="应用补丁"
                                Command="{Binding ApplyTocPatchCommand}"
                                AutomationProperties.Name="应用 TOC 对齐补丁"
                                Padding="12,4"/>
                        <Button Content="关闭"
                                Command="{Binding CloseAgentPatchPanelCommand}"
                                AutomationProperties.Name="关闭 TOC 对齐补丁面板"
                                Padding="12,4"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Panel>
    </Grid>
</UserControl>
