<UserControl xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:controls="using:Caly.Core.Controls"
                     xmlns:vm="using:Caly.Core.ViewModels"
                     x:Class="Caly.Core.Controls.AnalysisView"
                     x:DataType="vm:AnalysisViewModel">

    <Grid>
        <!-- Main content -->
        <DockPanel>
            <!-- Top toolbar -->
            <StackPanel Orientation="Horizontal"
                        DockPanel.Dock="Top"
                        Margin="4"
                        Spacing="4">
                <Button Content="Block 叠加"
                        Command="{Binding ToggleTypeFilterCommand}"
                        CommandParameter="text"
                        MinWidth="80"/>
                <Button Content="重置选择"
                        Command="{Binding ResetSelectionCommand}"
                        MinWidth="80"/>
                <Button Content="对齐报告"
                        Command="{Binding GenerateAlignmentReportCommand}"
                        MinWidth="80"/>
                <Button Content="生成目录"
                        Command="{Binding GenerateTocCommand}"
                        IsEnabled="{Binding CanGenerateToc}"
                        MinWidth="80"/>
                <Button Content="参考文献"
                        Command="{Binding GenerateReferencesCommand}"
                        IsEnabled="{Binding CanGenerateReferences}"
                        MinWidth="80"/>
                <TextBox PlaceholderText="搜索 Block..."
                         Text="{Binding BlockSearchText}"
                         MinWidth="150"/>
            </StackPanel>

            <!-- Main content with tabs -->
            <TabControl>
                <!-- Block List Tab -->
                <TabItem Header="Block 列表">
                    <StackPanel>
                        <controls:BlockListControl DataContext="{Binding}"/>
                    </StackPanel>
                </TabItem>

                <!-- Tree View Tab -->
                <TabItem Header="树形结构">
                    <StackPanel>
                        <controls:TreeViewControl DataContext="{Binding}"/>
                    </StackPanel>
                </TabItem>

                <!-- Markdown Preview Tab -->
                <TabItem Header="Markdown">
                    <StackPanel>
                        <controls:MarkdownPreviewControl DataContext="{Binding}"/>
                    </StackPanel>
                </TabItem>

                <!-- Aggregation Tab -->
                <TabItem Header="聚合关系">
                    <StackPanel>
                        <controls:AggregationViewControl DataContext="{Binding}"/>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </DockPanel>

        <!-- Alignment Report Overlay -->
        <Panel IsVisible="{Binding ShowAlignmentReport}">
            <Rectangle Fill="Gray"
                       Opacity="0.3"/>
            <Border Background="White"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="800"
                    MaxHeight="600">
                <DockPanel>
                    <StackPanel Orientation="Horizontal"
                                DockPanel.Dock="Top"
                                HorizontalAlignment="Right"
                                Margin="0,0,0,8">
                        <TextBlock Text="MinerU-Popo 对齐报告"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   VerticalAlignment="Center"/>
                        <Button Content="✕"
                                Command="{Binding CloseAlignmentReportCommand}"
                                Margin="12,0,0,0"
                                Padding="8,4"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  MaxHeight="500">
                        <TextBlock Text="{Binding AlignmentReportText}"
                                   TextWrapping="Wrap"
                                   FontFamily="Consolas, Menlo, monospace"
                                   FontSize="12"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Panel>

        <!-- TOC Overlay -->
        <Panel IsVisible="{Binding ShowTocPanel}">
            <Rectangle Fill="Gray"
                       Opacity="0.3"/>
            <Border Background="White"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="800"
                    MaxHeight="600">
                <DockPanel>
                    <StackPanel Orientation="Horizontal"
                                DockPanel.Dock="Top"
                                HorizontalAlignment="Right"
                                Margin="0,0,0,8">
                        <TextBlock Text="目录"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   VerticalAlignment="Center"/>
                        <Button Content="✕"
                                Command="{Binding CloseTocPanelCommand}"
                                Margin="12,0,0,0"
                                Padding="8,4"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  MaxHeight="500">
                        <TextBlock Text="{Binding TocMarkdownText}"
                                   TextWrapping="Wrap"
                                   FontFamily="Consolas, Menlo, monospace"
                                   FontSize="12"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Panel>

        <!-- Reference Overlay -->
        <Panel IsVisible="{Binding ShowReferencePanel}">
            <Rectangle Fill="Gray"
                       Opacity="0.3"/>
            <Border Background="White"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="800"
                    MaxHeight="600">
                <DockPanel>
                    <StackPanel Orientation="Horizontal"
                                DockPanel.Dock="Top"
                                HorizontalAlignment="Right"
                                Margin="0,0,0,8">
                        <TextBlock Text="参考文献"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   VerticalAlignment="Center"/>
                        <Button Content="✕"
                                Command="{Binding CloseReferencePanelCommand}"
                                Margin="12,0,0,0"
                                Padding="8,4"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  MaxHeight="500">
                        <TextBlock Text="{Binding ReferenceMarkdownText}"
                                   TextWrapping="Wrap"
                                   FontFamily="Consolas, Menlo, monospace"
                                   FontSize="12"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Panel>
    </Grid>
</UserControl>
