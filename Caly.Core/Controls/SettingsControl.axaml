<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:Caly.Core.Controls"
                    xmlns:vm="clr-namespace:Caly.Core.ViewModels">

    <Design.PreviewWith>
        <DockPanel Width="400" Height="700">
            <DockPanel Background="{DynamicResource SystemRegionBrush}">
                <controls:SettingsControl />
            </DockPanel>
        </DockPanel>
    </Design.PreviewWith>

    <ControlTheme x:Key="{x:Type controls:SettingsControl}"
                  TargetType="controls:SettingsControl"
                  x:DataType="vm:MainViewModel">
        <Setter Property="Template">
            <ControlTemplate>

                <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                        BorderThickness="1">

                    <ScrollViewer>
                        <StackPanel Spacing="12" Margin="16">

                            <!-- License -->
                            <controls:LicenseControl/>

                            <!-- Display / Rendering -->
                            <Expander Header="显示设置" IsExpanded="True">
                                <StackPanel Spacing="8" Margin="8,8">
                                    <CheckBox Content="扫描件白平衡（去除扫描页暖色/粉色底）"
                                              IsChecked="{Binding ScanWhiteBalance, Mode=TwoWay}"/>
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="11"
                                               Foreground="{DynamicResource SystemControlPageTextChromeDisabledBrush}"
                                               Text="开启后，扫描页会按页自动校正纸张的暖色/粉色偏色，使其背景接近中性白；已校正的页面会显示标识。"/>
                                </StackPanel>
                            </Expander>

                            <!-- MinerU Configuration -->
                            <Expander Header="MinerU AI Configuration" IsExpanded="True">
                                <StackPanel Spacing="8" Margin="8,8">

                                    <!-- Server URL -->
                                    <Grid ColumnDefinitions="Auto,12,*" RowDefinitions="Auto">
                                        <TextBlock Grid.Column="0"
                                                   Grid.Row="0"
                                                   VerticalAlignment="Center"
                                                   Text="服务器地址"/>
                                        <TextBox Grid.Column="2"
                                                 Grid.Row="0"
                                                 Margin="0,2"
                                                 Text="{Binding Settings.MinerUBaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>

                                    <!-- Parse Tier -->
                                    <Grid ColumnDefinitions="Auto,12,*" RowDefinitions="Auto">
                                        <TextBlock Grid.Column="0"
                                                   Grid.Row="0"
                                                   VerticalAlignment="Center"
                                                   Text="服务档位"/>
                                        <ComboBox Grid.Column="2"
                                                  Grid.Row="0"
                                                  Margin="0,2"
                                                  SelectedValue="{Binding Settings.MinerUTier, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                            <ComboBoxItem Content="flash"/>
                                            <ComboBoxItem Content="basic"/>
                                            <ComboBoxItem Content="standard"/>
                                            <ComboBoxItem Content="advanced"/>
                                        </ComboBox>
                                    </Grid>

                                    <!-- API Key -->
                                    <Grid ColumnDefinitions="Auto,12,*" RowDefinitions="Auto">
                                        <TextBlock Grid.Column="0"
                                                   Grid.Row="0"
                                                   VerticalAlignment="Center"
                                                   Text="API 密钥"/>
                                        <TextBox Grid.Column="2"
                                                 Grid.Row="0"
                                                 Margin="0,2"
                                                 Text="{Binding Settings.MinerUApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>

                                    <TextBlock Margin="0,2,0,0"
                                               FontSize="11"
                                               Foreground="{DynamicResource SystemControlPageTextChromeDisabledBrush}"
                                               Text="仅当 MinerU 服务以 --api-key 启动时才需要填写密钥。"/>

                                    <!-- Enable Toggle -->
                                    <CheckBox Content="启用 MinerU AI 解析"
                                              Margin="0,4,0,0"
                                              IsChecked="{Binding Settings.MinerUEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Expander>

                             <!-- Popo Configuration -->
                             <Expander Header="Popo Configuration" IsExpanded="True">
                                 <StackPanel Spacing="8" Margin="8,8">

                                     <!-- Popo Server URL -->
                                     <Grid ColumnDefinitions="Auto,12,*" RowDefinitions="Auto">
                                         <TextBlock Grid.Column="0"
                                                    Grid.Row="0"
                                                    VerticalAlignment="Center"
                                                    Text="服务器地址"/>
                                         <TextBox Grid.Column="2"
                                                  Grid.Row="0"
                                                  Margin="0,2"
                                                  Text="{Binding Settings.PopoBaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                     </Grid>
                                 </StackPanel>
                             </Expander>

                             <!-- Project Settings -->
                             <Expander Header="Project Settings" IsExpanded="True">
                                 <StackPanel Spacing="8" Margin="8,8">

                                     <!-- Project Home Directory -->
                                     <Grid ColumnDefinitions="Auto,12,*,Auto" RowDefinitions="Auto">
                                         <TextBlock Grid.Column="0"
                                                    Grid.Row="0"
                                                    VerticalAlignment="Center"
                                                    Text="项目主目录"/>
                                         <TextBox Grid.Column="2"
                                                  Grid.Row="0"
                                                  Margin="0,2"
                                                  Text="{Binding Settings.ProjectHome, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                         <Button x:Name="PART_BrowseProjectHome"
                                                  Grid.Column="3"
                                                  Grid.Row="0"
                                                  Margin="4,0,0,0"
                                                  Content="浏览…"/>
                                     </Grid>

                                      <TextBlock Margin="0,4,0,0"
                                                 FontSize="11"
                                                 Foreground="{DynamicResource SystemControlPageTextChromeDisabledBrush}"
                                                 Text="所有 TraceView 项目都会保存在此目录下。"/>
                                  </StackPanel>
                              </Expander>

                              <!-- Geo Configuration -->
                              <Expander Header="Geo Configuration" IsExpanded="True">
                                  <StackPanel Spacing="8" Margin="8,8">

                                      <!-- GeoLibre Base URL -->
                                      <Grid ColumnDefinitions="Auto,12,*" RowDefinitions="Auto">
                                          <TextBlock Grid.Column="0"
                                                     Grid.Row="0"
                                                     VerticalAlignment="Center"
                                                     Text="GeoLibre 地址"/>
                                          <TextBox Grid.Column="2"
                                                   Grid.Row="0"
                                                   Margin="0,2"
                                                   Text="{Binding Settings.GeoLibreBaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                      </Grid>
                                  </StackPanel>
                              </Expander>

                          </StackPanel>
                    </ScrollViewer>

                </Border>

            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>