<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:Caly.Core.Controls"
                    xmlns:models="clr-namespace:Caly.Core.Models"
                    xmlns:vm="clr-namespace:Caly.Core.ViewModels">

    <Design.PreviewWith>
        <DockPanel Width="400" Height="700">
            <DockPanel Background="{DynamicResource SystemRegionBrush}">
                <controls:SettingsControl />
            </DockPanel>
        </DockPanel>
    </Design.PreviewWith>

    <ControlTheme x:Key="{x:Type controls:SettingsControl}"
                  TargetType="controls:SettingsControl"
                  x:DataType="vm:MainViewModel">
        <Setter Property="Template">
            <ControlTemplate>

                <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                        BorderThickness="1">

                    <ScrollViewer>
                        <StackPanel Spacing="12" Margin="16">

                            <!-- License -->
                            <controls:LicenseControl/>

                            <!-- Display / Rendering -->
                            <Expander Header="显示设置" IsExpanded="True">
                                <StackPanel Spacing="8" Margin="8,8">
                                    <CheckBox Content="扫描件白平衡（去除扫描页暖色/粉色底）"
                                              IsChecked="{Binding ScanWhiteBalance, Mode=TwoWay}"/>
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="11"
                                               Foreground="{DynamicResource SystemControlPageTextChromeDisabledBrush}"
                                               Text="开启后，扫描页会按页自动校正纸张的暖色/粉色偏色，使其背景接近中性白；已校正的页面会显示标识。"/>
                                </StackPanel>
                            </Expander>

                            <!-- MinerU Configuration -->
                            <Expander Header="MinerU AI Configuration" IsExpanded="True">
                                <StackPanel Spacing="8" Margin="8,8">

                                    <!-- Server URL -->
                                    <Grid ColumnDefinitions="Auto,12,*" RowDefinitions="Auto">
                                        <TextBlock Grid.Column="0"
                                                   Grid.Row="0"
                                                   VerticalAlignment="Center"
                                                   Text="服务器地址"/>
                                        <TextBox Grid.Column="2"
                                                 Grid.Row="0"
                                                 Margin="0,2"
                                                 Text="{Binding Settings.MinerUBaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>

                                    <!-- Parse Tier -->
                                    <Grid ColumnDefinitions="Auto,12,*" RowDefinitions="Auto">
                                        <TextBlock Grid.Column="0"
                                                   Grid.Row="0"
                                                   VerticalAlignment="Center"
                                                   Text="服务档位"/>
                                        <!-- String items + SelectedItem: in Avalonia 12 SelectedValuePath no
                                             longer exists (SelectedValueBinding resolves against the outer
                                             DataContext under compiled bindings), and ComboBoxItem items
                                             would write their ToString() back into the setting. -->
                                        <ComboBox Grid.Column="2"
                                                  Grid.Row="0"
                                                  Margin="0,2"
                                                  SelectedItem="{Binding Settings.MinerUTier, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                            <x:String>flash</x:String>
                                            <x:String>basic</x:String>
                                            <x:String>standard</x:String>
                                            <x:String>advanced</x:String>
                                        </ComboBox>
                                    </Grid>

                                    <!-- Parse Engine (ocr_mode) -->
                                    <Grid ColumnDefinitions="Auto,12,*" RowDefinitions="Auto">
                                        <TextBlock Grid.Column="0"
                                                   Grid.Row="0"
                                                   VerticalAlignment="Center"
                                                   Text="解析引擎"/>
                                        <!-- Same string-items + SelectedItem pattern as the tier above.
                                             Maps to the MinerU ocr_mode parameter: auto picks the parsing
                                             branch per page, txt uses the native text layer for the whole
                                             document, ocr forces OCR for the whole document. -->
                                        <ComboBox Grid.Column="2"
                                                  Grid.Row="0"
                                                  Margin="0,2"
                                                  SelectedItem="{Binding Settings.MinerUOcrMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                            <x:String>auto</x:String>
                                            <x:String>txt</x:String>
                                            <x:String>ocr</x:String>
                                        </ComboBox>
                                    </Grid>

                                    <TextBlock Margin="0,0,0,0"
                                               FontSize="11"
                                               Foreground="{DynamicResource SystemControlPageTextChromeDisabledBrush}"
                                               Text="引擎即 MinerU 的 ocr_mode：auto 逐页选分支（默认）、txt 整本用文字层、ocr 整本强制 OCR。这里设置的是默认值，点“加工”时的弹框可临时改，并会记住最后一次选择。"/>

                                    <!-- API Key -->
                                    <Grid ColumnDefinitions="Auto,12,*" RowDefinitions="Auto">
                                        <TextBlock Grid.Column="0"
                                                   Grid.Row="0"
                                                   VerticalAlignment="Center"
                                                   Text="API 密钥"/>
                                        <TextBox Grid.Column="2"
                                                 Grid.Row="0"
                                                 Margin="0,2"
                                                 Text="{Binding Settings.MinerUApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>

                                    <TextBlock Margin="0,2,0,0"
                                               FontSize="11"
                                               Foreground="{DynamicResource SystemControlPageTextChromeDisabledBrush}"
                                               Text="仅当 MinerU 服务以 --api-key 启动时才需要填写密钥。"/>

                                    <!-- Enable Toggle -->
                                    <CheckBox Content="启用 MinerU AI 解析"
                                              Margin="0,4,0,0"
                                              IsChecked="{Binding Settings.MinerUEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Expander>

                             <!-- Popo Configuration -->
                             <Expander Header="Popo Configuration" IsExpanded="True">
                                 <StackPanel Spacing="8" Margin="8,8">

                                     <!-- Popo Server URL -->
                                     <Grid ColumnDefinitions="Auto,12,*" RowDefinitions="Auto">
                                         <TextBlock Grid.Column="0"
                                                    Grid.Row="0"
                                                    VerticalAlignment="Center"
                                                    Text="服务器地址"/>
                                         <TextBox Grid.Column="2"
                                                  Grid.Row="0"
                                                  Margin="0,2"
                                                  x:Name="PART_PopoBaseUrlInput"
                                                  Text="{Binding Settings.PopoBaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                     </Grid>

                                     <!-- EPUB Output -->
                                     <CheckBox Content="输出 EPUB (output_epub)"
                                               Margin="0,4,0,0"
                                               IsChecked="{Binding Settings.PopoOutputEpub, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                         <ToolTip.Tip>让 Popo 服务端在结果中额外渲染 {doc_id}.epub。该参数在提交任务时确定，关闭后只能重新处理才能拿到 EPUB。</ToolTip.Tip>
                                     </CheckBox>
                                 </StackPanel>
                             </Expander>

                             <!-- Built-in Agents / LLM -->
                             <Expander Header="内置智能体 Configuration" IsExpanded="True">
                                 <StackPanel Spacing="8" Margin="8,8">

                                     <!-- OpenAI-compatible endpoint -->
                                     <Grid ColumnDefinitions="Auto,12,*" RowDefinitions="Auto">
                                         <TextBlock Grid.Column="0"
                                                    Grid.Row="0"
                                                    VerticalAlignment="Center"
                                                    Text="服务地址"/>
                                         <TextBox Grid.Column="2"
                                                  Grid.Row="0"
                                                  Margin="0,2"
                                                  Watermark="https://api.openai.com/v1（留空用 OpenAI 默认端点）"
                                                  x:Name="PART_AiBaseUrlInput"
                                                  Text="{Binding Settings.AiBaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                     </Grid>

                                     <!-- Model id -->
                                     <Grid ColumnDefinitions="Auto,12,*" RowDefinitions="Auto">
                                         <TextBlock Grid.Column="0"
                                                    Grid.Row="0"
                                                    VerticalAlignment="Center"
                                                    Text="模型"/>
                                         <TextBox Grid.Column="2"
                                                  Grid.Row="0"
                                                  Margin="0,2"
                                                  Watermark="gpt-4o-mini"
                                                  x:Name="PART_AiModelInput"
                                                  Text="{Binding Settings.AiModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                     </Grid>

                                     <!-- Credential reference -->
                                     <Grid ColumnDefinitions="Auto,12,*" RowDefinitions="Auto">
                                         <TextBlock Grid.Column="0"
                                                    Grid.Row="0"
                                                    VerticalAlignment="Center"
                                                    Text="密钥引用"/>
                                         <TextBox Grid.Column="2"
                                                  Grid.Row="0"
                                                  Margin="0,2"
                                                  Watermark="keychain:com.traceview.llm/api_key 或 env:OPENAI_API_KEY"
                                                  x:Name="PART_AiCredentialRefInput"
                                                  Text="{Binding Settings.AiCredentialRef, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                     </Grid>

                                     <!-- Store the raw key in the OS keychain -->
                                     <Grid ColumnDefinitions="Auto,12,*,Auto" RowDefinitions="Auto">
                                         <TextBlock Grid.Column="0"
                                                    Grid.Row="0"
                                                    VerticalAlignment="Center"
                                                    Text="API 密钥"/>
                                         <TextBox Grid.Column="2"
                                                  Grid.Row="0"
                                                  Margin="0,2"
                                                  x:Name="PART_AiKeyInput"
                                                  PasswordChar="•"
                                                  Watermark="输入 API 密钥后点右侧按钮存入系统钥匙串"/>
                                         <Button Grid.Column="3"
                                                 Grid.Row="0"
                                                 Margin="4,0,0,0"
                                                 x:Name="PART_SaveAiKeyButton"
                                                 Content="存入钥匙串"/>
                                     </Grid>

                                     <TextBlock Margin="0,2,0,0"
                                                FontSize="11"
                                                Foreground="{DynamicResource SystemControlPageTextChromeDisabledBrush}"
                                                Text="内置智能体使用 OpenAI 兼容的对话接口。密钥本体不写入设置文件：keychain:服务/账户 形式存入系统钥匙串（可用上方按钮），env:变量名 形式读取环境变量（只读）。"/>
                                 </StackPanel>
                             </Expander>

                             <!-- MCP Servers -->
                             <Expander Header="MCP 服务器" IsExpanded="True">
                                 <StackPanel Spacing="8" Margin="8,8">

                                     <ItemsControl ItemsSource="{Binding McpServers}">
                                         <ItemsControl.ItemTemplate>
                                             <DataTemplate x:DataType="models:McpServerConfig">
                                                 <Border Margin="0,4"
                                                         Padding="8"
                                                         CornerRadius="4"
                                                         Background="{DynamicResource SystemControlBackgroundListLowBrush}">
                                                     <StackPanel Spacing="6">
                                                         <Grid ColumnDefinitions="Auto,12,*">
                                                             <TextBlock Grid.Column="0"
                                                                        VerticalAlignment="Center"
                                                                        Text="标识"/>
                                                             <TextBox Grid.Column="2"
                                                                      Margin="0,2"
                                                                      ToolTip.Tip="注册表内唯一名称，调用点按此名绑定工具"
                                                                      Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                         </Grid>
                                                         <Grid ColumnDefinitions="Auto,12,*">
                                                             <TextBlock Grid.Column="0"
                                                                        VerticalAlignment="Center"
                                                                        Text="显示名"/>
                                                             <TextBox Grid.Column="2"
                                                                      Margin="0,2"
                                                                      ToolTip.Tip="审批对话框等处展示给用户看的名称"
                                                                      Text="{Binding DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                         </Grid>
                                                         <Grid ColumnDefinitions="Auto,12,*">
                                                             <TextBlock Grid.Column="0"
                                                                        VerticalAlignment="Center"
                                                                        Text="服务地址"/>
                                                             <TextBox Grid.Column="2"
                                                                      Margin="0,2"
                                                                      Watermark="https://example.com/mcp"
                                                                      Text="{Binding Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                         </Grid>
                                                         <Grid ColumnDefinitions="Auto,12,*">
                                                             <TextBlock Grid.Column="0"
                                                                        VerticalAlignment="Center"
                                                                        Text="密钥引用"/>
                                                             <TextBox Grid.Column="2"
                                                                      Margin="0,2"
                                                                      Watermark="keychain:com.traceview.mcp/token 或 env:JIULU_MCP_TOKEN"
                                                                      Text="{Binding CredentialRef, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                         </Grid>
                                                         <Grid ColumnDefinitions="*,Auto">
                                                             <CheckBox Grid.Column="0"
                                                                       Content="写操作需确认"
                                                                       IsChecked="{Binding RequiresApprovalForWrites, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                             <Button Grid.Column="1"
                                                                     Classes="flat"
                                                                     Content="删除"
                                                                     Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).RemoveMcpServerCommand}"
                                                                     CommandParameter="{Binding}"/>
                                                         </Grid>
                                                     </StackPanel>
                                                 </Border>
                                             </DataTemplate>
                                         </ItemsControl.ItemTemplate>
                                     </ItemsControl>

                                     <Button Content="添加服务器"
                                             HorizontalAlignment="Left"
                                             Command="{Binding AddMcpServerCommand}"/>

                                     <TextBlock FontSize="11"
                                                Foreground="{DynamicResource SystemControlPageTextChromeDisabledBrush}"
                                                Text="内置智能体可从这里登记的 MCP 服务绑定工具。令牌通过密钥引用间接解析，不保存在设置文件中。"/>
                                 </StackPanel>
                             </Expander>

                             <!-- Project Settings -->
                             <Expander Header="Project Settings" IsExpanded="True">
                                 <StackPanel Spacing="8" Margin="8,8">

                                     <!-- Project Home Directory -->
                                     <Grid ColumnDefinitions="Auto,12,*,Auto" RowDefinitions="Auto">
                                         <TextBlock Grid.Column="0"
                                                    Grid.Row="0"
                                                    VerticalAlignment="Center"
                                                    Text="项目主目录"/>
                                         <TextBox Grid.Column="2"
                                                  Grid.Row="0"
                                                  Margin="0,2"
                                                  Text="{Binding Settings.ProjectHome, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                         <Button x:Name="PART_BrowseProjectHome"
                                                  Grid.Column="3"
                                                  Grid.Row="0"
                                                  Margin="4,0,0,0"
                                                  Content="浏览…"/>
                                     </Grid>

                                      <TextBlock Margin="0,4,0,0"
                                                 FontSize="11"
                                                 Foreground="{DynamicResource SystemControlPageTextChromeDisabledBrush}"
                                                 Text="所有 TraceView 项目都会保存在此目录下。"/>
                                  </StackPanel>
                              </Expander>

                              <!-- Geo Configuration -->
                              <Expander Header="Geo Configuration" IsExpanded="True">
                                  <StackPanel Spacing="8" Margin="8,8">

                                      <!-- GeoLibre Base URL -->
                                      <Grid ColumnDefinitions="Auto,12,*" RowDefinitions="Auto">
                                          <TextBlock Grid.Column="0"
                                                     Grid.Row="0"
                                                     VerticalAlignment="Center"
                                                     Text="GeoLibre 地址"/>
                                          <TextBox Grid.Column="2"
                                                   Grid.Row="0"
                                                   Margin="0,2"
                                                   Text="{Binding Settings.GeoLibreBaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                      </Grid>
                                  </StackPanel>
                              </Expander>

                          </StackPanel>
                    </ScrollViewer>

                </Border>

            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>