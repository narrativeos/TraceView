<UserControl xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:vm="using:Caly.Core.ViewModels"
                xmlns:models="using:Caly.Core.Models"
                x:Class="Caly.Core.Controls.TreeViewControl"
                x:DataType="vm:AnalysisViewModel"
                ClipToBounds="True">

    <TreeView ItemsSource="{Binding TreeRootChildren}"
               HorizontalAlignment="Stretch"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ClipToBounds="True">
        <TreeView.Styles>
            <Style Selector="TreeViewItem">
                <Setter Property="IsExpanded" Value="True"/>
            </Style>
        </TreeView.Styles>
        <TreeView.ItemTemplate>
            <TreeDataTemplate x:DataType="vm:TreeNodeViewModel"
                              ItemsSource="{Binding Children}">
                <Border Padding="8"
                        Margin="0,2,0,2"
                        CornerRadius="6"
                        BorderThickness="1,1,1,1"
                        BorderBrush="{Binding TypeColorHex}"
                        Background="{StaticResource SystemControlBackgroundChromeLowBrush}"
                        HorizontalAlignment="Stretch"
                        ClipToBounds="True">
                    <Grid ColumnDefinitions="Auto,*"
                          ClipToBounds="True">
                        <!-- Type Icon -->
                        <TextBlock Grid.Column="0"
                                   Text="{Binding TypeIcon}"
                                   FontSize="16"
                                   VerticalAlignment="Top"
                                   Margin="0,0,6,0"/>

                        <!-- Card Content -->
                        <StackPanel Grid.Column="1" Spacing="4">
                            <!-- Header: Type + Level + Blocks + Pages -->
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{Binding Type}"
                                           FontWeight="Bold"
                                           FontSize="12"
                                           Foreground="{Binding TypeColorHex}"
                                           MaxWidth="80"
                                           TextTrimming="CharacterEllipsis"/>

                                <TextBlock Text="L"
                                           FontSize="10"
                                           Opacity="0.6"/>
                                <TextBlock Text="{Binding Level}"
                                           FontSize="10"
                                           Opacity="0.6"/>

                                <TextBlock Text="·"
                                           FontSize="10"
                                           Opacity="0.5"/>

                                <TextBlock Text="{Binding BlockCount}"
                                           FontSize="10"
                                           Opacity="0.7"/>
                                <TextBlock Text="blocks"
                                           FontSize="10"
                                           Opacity="0.6"/>

                                <TextBlock Text="{Binding PageRange}"
                                           FontSize="10"
                                           Foreground="#2196F3"/>

                                <!-- Copy table markdown button -->
                                <Button Content="📋"
                                        FontSize="10"
                                        Padding="2,0"
                                        Margin="4,0,0,0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        IsVisible="{Binding CanCopyTable}"
                                        Click="OnCopyTableMarkdownClick">
                                    <ToolTip.Tip>复制 Markdown</ToolTip.Tip>
                                </Button>
                            </StackPanel>

                            <!-- Title (if present) -->
                            <TextBlock Text="{Binding Title}"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       MaxLines="2"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       IsVisible="{Binding HasTitle}"/>

                            <!-- Content Preview (non-image nodes, collapsed) -->
                            <TextBlock Text="{Binding ContentPreview}"
                                       FontSize="11"
                                       Opacity="0.8"
                                       MaxLines="3"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Stretch"
                                       TextAlignment="Left"
                                       IsVisible="{Binding ShowContentPreview}"/>

                            <!-- Full Content (non-image nodes, expanded) -->
                            <TextBlock Text="{Binding DisplayContent}"
                                       FontSize="11"
                                       Opacity="0.8"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Stretch"
                                       TextAlignment="Left"
                                       IsVisible="{Binding ShowFullContent}"/>

                            <!-- Structured Content Preview (nodes with ordered lists, collapsed) -->
                            <TextBlock Text="{Binding StructuredContentPreview}"
                                       FontSize="11"
                                       Opacity="0.8"
                                       MaxLines="3"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Stretch"
                                       TextAlignment="Left"
                                       IsVisible="{Binding ShowStructuredPreview}"/>

                            <!-- Structured Content (nodes with ordered lists, expanded) -->
                            <ItemsControl ItemsSource="{Binding StructuredContentLines}"
                                          HorizontalAlignment="Stretch"
                                          IsVisible="{Binding ShowStructuredFull}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:ContentDisplayLine">
                                        <Grid ColumnDefinitions="24,*"
                                              Margin="0,1,0,1"
                                              RowDefinitions="Auto,*">
                                            <!-- List separator (between a paragraph and the next list) -->
                                            <Rectangle Grid.Row="0"
                                                       Grid.ColumnSpan="2"
                                                       Height="1"
                                                       Fill="Gray"
                                                       Opacity="0.25"
                                                       Margin="0,4,0,3"
                                                       IsVisible="{Binding IsListStart}"/>
                                            <!-- Number (list items only, right-aligned) -->
                                            <TextBlock Grid.Row="1"
                                                       Grid.Column="0"
                                                       Text="{Binding Number}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Opacity="0.6"
                                                       TextAlignment="Right"
                                                       VerticalAlignment="Top"
                                                       Margin="0,0,4,0"
                                                       IsVisible="{Binding IsListItem}"/>
                                            <!-- Line text -->
                                            <TextBlock Grid.Row="1"
                                                       Grid.Column="1"
                                                       Text="{Binding Text}"
                                                       FontSize="11"
                                                       Opacity="0.8"
                                                       TextWrapping="Wrap"
                                                       TextAlignment="Left"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Structured table (table_data / table_key_value / legacy HTML table) -->
                            <DataGrid ItemsSource="{Binding TableRows}"
                                      AutoGenerateColumns="False"
                                      HeadersVisibility="{Binding TableHeadersVisibility}"
                                      GridLinesVisibility="Horizontal"
                                      FontSize="10"
                                      MaxHeight="200"
                                      HorizontalAlignment="Stretch"
                                      IsVisible="{Binding ShowTableGrid}"
                                      Loaded="OnTableDataGridLoaded"
                                      DataContextChanged="OnTableDataGridDataContextChanged"/>

                            <!-- Image caption/metadata (image nodes) -->
                            <TextBlock Text="{Binding DisplayMetadata}"
                                       FontSize="11"
                                       Opacity="0.7"
                                       FontStyle="Italic"
                                       MaxLines="3"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Stretch"
                                       TextAlignment="Left"
                                       IsVisible="{Binding ShowMetadata}"/>

                            <!-- Meta info row -->
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                                <!-- Block IDs -->
                                <TextBlock FontSize="9"
                                           Opacity="0.5"
                                           MaxLines="1"
                                           TextTrimming="CharacterEllipsis">
                                    <Run Text="🔗"/>
                                    <Run Text="{Binding BlockIdsDisplay}"/>
                                </TextBlock>

                                <!-- Location count -->
                                <StackPanel Orientation="Horizontal" Spacing="2"
                                            IsVisible="{Binding IsContentLong}">
                                    <TextBlock Text="📍" FontSize="9"/>
                                    <TextBlock Text="{Binding UniquePageCount}"
                                               FontSize="9"
                                               Opacity="0.5"/>
                                    <TextBlock Text="pages"
                                               FontSize="9"
                                               Opacity="0.5"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </TreeDataTemplate>
        </TreeView.ItemTemplate>
    </TreeView>
</UserControl>