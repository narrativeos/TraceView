<UserControl xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:vm="using:Caly.Core.ViewModels"
                x:Class="Caly.Core.Controls.TreeViewControl"
                x:DataType="vm:AnalysisViewModel">

    <TreeView ItemsSource="{Binding TreeRootChildren}">
        <TreeView.ItemTemplate>
            <TreeDataTemplate x:DataType="vm:TreeNodeViewModel"
                              ItemsSource="{Binding Children}">
                <Border Padding="8"
                        Margin="0,2,0,2"
                        CornerRadius="6"
                        BorderThickness="1,1,1,1"
                        BorderBrush="{Binding TypeColorHex}"
                        Background="{StaticResource SystemControlBackgroundChromeLowBrush}">
                    <Grid ColumnDefinitions="Auto,*">
                        <!-- Type Icon -->
                        <TextBlock Grid.Column="0"
                                   Text="{Binding TypeIcon}"
                                   FontSize="16"
                                   VerticalAlignment="Top"
                                   Margin="0,0,6,0"/>

                        <!-- Card Content -->
                        <StackPanel Grid.Column="1" Spacing="4">
                            <!-- Header: Type + Level + Blocks + Pages -->
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{Binding Type}"
                                           FontWeight="Bold"
                                           FontSize="12"
                                           Foreground="{Binding TypeColorHex}"/>

                                <TextBlock Text="L"
                                           FontSize="10"
                                           Opacity="0.6"/>
                                <TextBlock Text="{Binding Level}"
                                           FontSize="10"
                                           Opacity="0.6"/>

                                <TextBlock Text="·"
                                           FontSize="10"
                                           Opacity="0.5"/>

                                <TextBlock Text="{Binding BlockCount}"
                                           FontSize="10"
                                           Opacity="0.7"/>
                                <TextBlock Text="blocks"
                                           FontSize="10"
                                           Opacity="0.6"/>

                                <TextBlock Text="{Binding PageRange}"
                                           FontSize="10"
                                           Foreground="#2196F3"/>
                            </StackPanel>

                            <!-- Title (if present) -->
                            <TextBlock Text="{Binding Title}"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       MaxLines="1"
                                       TextTrimming="CharacterEllipsis"
                                       IsVisible="{Binding HasTitle}"/>

                            <!-- Content Preview -->
                            <TextBlock Text="{Binding ContentPreview}"
                                       FontSize="11"
                                       Opacity="0.8"
                                       MaxLines="3"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"/>

                            <!-- Meta info row -->
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                                <!-- Block IDs -->
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <TextBlock Text="🔗" FontSize="9"/>
                                    <TextBlock Text="{Binding BlockIdsDisplay}"
                                               FontSize="9"
                                               Opacity="0.5"
                                               MaxLines="1"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- Location count -->
                                <StackPanel Orientation="Horizontal" Spacing="2"
                                            IsVisible="{Binding IsContentLong}">
                                    <TextBlock Text="📍" FontSize="9"/>
                                    <TextBlock Text="{Binding UniquePageCount}"
                                               FontSize="9"
                                               Opacity="0.5"/>
                                    <TextBlock Text="pages"
                                               FontSize="9"
                                               Opacity="0.5"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </TreeDataTemplate>
        </TreeView.ItemTemplate>
    </TreeView>
</UserControl>