<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Caly.Core.ViewModels"
        x:Class="Caly.Core.Views.AlignmentReportWindow"
        x:DataType="vm:DocumentViewModel"
        Width="700"
        Height="500"
        CanResize="True"
        Icon="{DynamicResource AppIcon}"
        Title="MinerU-Popo 对齐报告">

    <DockPanel Margin="12">
        <!-- Header with buttons -->
        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    Spacing="8"
                    Margin="0,0,0,8">
            <TextBlock Text="MinerU-Popo 对齐报告"
                       FontWeight="Bold"
                       FontSize="16"
                       VerticalAlignment="Center"/>
            
            <Button 
                    Click="CopyButton_OnClick"
                    AutomationProperties.Name="复制报告全文"
                    ToolTip.Tip="复制报告全文到剪贴板"
                    Margin="8,0,0,0"
                    Padding="8,4">
                <StackPanel Orientation="Horizontal" Spacing="4"><Path Classes="toolIcon" Width="13" Height="13" Data="{StaticResource glyph_copy_regular}"/><TextBlock Text="复制" VerticalAlignment="Center"/></StackPanel>
            </Button>
            
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button 
                        Command="{Binding CloseAlignmentReportCommand}"
                        AutomationProperties.Name="关闭对齐报告"
                        ToolTip.Tip="关闭对齐报告"
                        Margin="8,0,0,0"
                        Padding="8,4">
                    <Path Classes="toolIcon" Width="14" Height="14" Data="{StaticResource glyph_close_regular}"/>
                </Button>
            </StackPanel>
        </StackPanel>

        <!-- Report content - using TextBox for text selection support -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <TextBox Text="{Binding AlignmentReportText}"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     FontFamily="{DynamicResource CalyMonoFontFamily}"
                     FontSize="12"
                     BorderThickness="1"
                     BorderBrush="{DynamicResource CalyDividerBrush}"
                     Padding="8"/>
        </ScrollViewer>
    </DockPanel>
</Window>
