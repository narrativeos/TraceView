<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="460" d:DesignHeight="240"
        x:Class="Caly.Core.Views.MinerUParseOptionsWindow"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        ShowActivated="True"
        Title="MinerU 加工选项"
        Width="460" MinWidth="460"
        Height="240" MinHeight="240">
    <StackPanel Margin="16" Spacing="12">
        <!-- Page range -->
        <TextBlock Text="页面范围" FontSize="14" FontWeight="Bold"/>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <RadioButton x:Name="AllPagesRadio"
                         GroupName="PageRange"
                         Content="全部"
                         IsChecked="True"
                         VerticalAlignment="Center"/>
            <RadioButton x:Name="RangePagesRadio"
                         GroupName="PageRange"
                         Content="起止页"
                         VerticalAlignment="Center"/>
            <NumericUpDown x:Name="StartPageBox"
                           Width="90"
                           Minimum="1"
                           Maximum="100000"
                           Increment="1"
                           Value="1"
                           FormatString="0"
                           ParsingNumberStyle="Integer"
                           IsEnabled="{Binding IsChecked, ElementName=RangePagesRadio}"/>
            <TextBlock Text="到" VerticalAlignment="Center"/>
            <NumericUpDown x:Name="EndPageBox"
                           Width="90"
                           Minimum="1"
                           Maximum="100000"
                           Increment="1"
                           Value="15"
                           FormatString="0"
                           ParsingNumberStyle="Integer"
                           IsEnabled="{Binding IsChecked, ElementName=RangePagesRadio}"/>
            <TextBlock Text="页" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Parse tier -->
        <TextBlock Text="档位" FontSize="14" FontWeight="Bold"/>
        <!-- String items + SelectedIndex: same pattern as SettingsControl (default: standard) -->
        <ComboBox x:Name="TierCombo"
                  HorizontalAlignment="Left"
                  Width="160"
                  SelectedIndex="2">
            <x:String>flash</x:String>
            <x:String>basic</x:String>
            <x:String>standard</x:String>
            <x:String>advanced</x:String>
        </ComboBox>

        <!-- Actions -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
            <Button Content="确定" Click="OnOkClick" IsDefault="True" Width="90"/>
            <Button Content="取消" Click="OnCancelClick" IsCancel="True" Width="90"/>
        </StackPanel>
    </StackPanel>
</Window>
