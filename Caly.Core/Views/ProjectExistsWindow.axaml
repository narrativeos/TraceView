<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Caly.Core.Views"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="400"
        x:Class="Caly.Core.Views.ProjectExistsWindow"
        Width="520" Height="400"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ShowActivated="True"
        Title="选择项目">
    <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,*,Auto">
        <!-- Header with message -->
        <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,10">
            <TextBlock Text="发现已有项目，请选择："
                       FontWeight="Bold"
                       FontSize="14"/>
            <TextBlock Text="选择一个现有项目打开，或创建新项目。"
                       FontSize="12"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Divider -->
        <Rectangle Grid.Row="1" Height="1" 
                   Margin="0,5,0,10"
                   Fill="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

        <!-- Project List -->
        <StackPanel Grid.Row="2" Spacing="8">
            <TextBlock Text="现有项目："
                       FontWeight="SemiBold"
                       FontSize="12"/>
            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Background="{DynamicResource SystemControlBackgroundChromeLowBrush}">
                <ListBox x:Name="PART_ProjectList"
                         MaxHeight="200"
                         Padding="4"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="views:ProjectListItem">
                            <Border Padding="10,8"
                                    Background="Transparent"
                                    CornerRadius="2"
                                    Margin="0,2">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="13"
                                           FontWeight="Normal"/>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="创建新项目"
                    Padding="16,8"
                    Click="CreateNewButton_OnClick"/>
            <Button Content="打开选中项目"
                    Padding="16,8"
                    IsDefault="True"
                    Classes="accent"
                    Click="OpenProjectButton_OnClick"/>
        </StackPanel>
    </Grid>
</Window>