<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<!--If you are willing to use Windows/MacOS native APIs you will need to create 3 projects.
    One for Windows with net7.0-windows TFM, one for MacOS with net7.0-macos and one with net7.0 TFM for Linux.-->
		<TargetFrameworks>net9.0;net10.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<BuiltInComInteropSupport>true</BuiltInComInteropSupport>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<AssemblyName>TraceView</AssemblyName>
		<Version>0.2.0.0</Version>
		<JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
		<Deterministic>true</Deterministic>
		<Configurations>Debug;Release;AOT</Configurations>
		<SignAssembly>True</SignAssembly>
		<AssemblyOriginatorKeyFile>..\Caly.snk</AssemblyOriginatorKeyFile>
	</PropertyGroup>

	<!-- Begin AOT publish -->
	<PropertyGroup Condition="'$(Configuration)'=='AOT'">
		<PublishAot>true</PublishAot>
		<Optimize>True</Optimize>
		<OptimizationPreference>Speed</OptimizationPreference>
		<IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
		<IlcTrimMetadata>true</IlcTrimMetadata>

		<InvariantGlobalization>true</InvariantGlobalization>
		<HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
		<EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
		<EnableUnsafeUTF7Encoding>false</EnableUnsafeUTF7Encoding>
		<EventSourceSupport>false</EventSourceSupport>
		<MetadataUpdaterSupport>false</MetadataUpdaterSupport>
		<UseNativeHttpHandler>true</UseNativeHttpHandler>
		<CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
		<MetricsSupport>false</MetricsSupport>
		<XmlResolverIsNetworkingEnabledByDefault>false</XmlResolverIsNetworkingEnabledByDefault>

		<!--<StripSymbols>true</StripSymbols>
		<DebugSymbols>false</DebugSymbols>
		<UseSystemResourceKeys>true</UseSystemResourceKeys>
		<DebuggerSupport>false</DebuggerSupport>
		<TrimmerRemoveSymbols>true</TrimmerRemoveSymbols>
		<StackTraceSupport>false</StackTraceSupport>-->
	</PropertyGroup>

	<!-- Begin Link Static libs -->
	<ItemGroup Condition="'$(Configuration)'=='AOT' And $(RuntimeIdentifier) == 'win-x64'">
		<DirectPInvoke Include="libSkiaSharp" />
		<NativeLibrary Include="..\native\skia.lib" />
		<NativeLibrary Include="..\native\SkiaSharp.lib" />

		<DirectPInvoke Include="libHarfBuzzSharp" />
		<NativeLibrary Include="..\native\libHarfBuzzSharp.lib" />
	</ItemGroup>

	<ItemGroup Condition="'$(Configuration)'=='AOT' And $(RuntimeIdentifier) == 'linux-x64'">
		<DirectPInvoke Include="libSkiaSharp" />
		<NativeLibrary Include="..\native\libskia.a" />
		<NativeLibrary Include="..\native\libSkiaSharp.a" />

		<DirectPInvoke Include="libHarfBuzzSharp" />
		<NativeLibrary Include="..\native\libHarfBuzzSharp.a" />

		<LinkerArg Include="-lstdc++" />
		<LinkerArg Include="-lfontconfig" />
		<LinkerArg Include="-lfreetype" />
	</ItemGroup>

	<Target Condition="'$(Configuration)'=='AOT' And $(RuntimeIdentifier.StartsWith('win'))" Name="DeleteLinkedLibAfterPublish" AfterTargets="Publish">
		<ItemGroup>
			<FilesToDelete Include="$(PublishDir)libHarfBuzzSharp.dll;$(PublishDir)libSkiaSharp.dll;$(PublishDir)av_libglesv2.dll;" />
		</ItemGroup>
		<Delete Files="@(FilesToDelete)" />
		<Message Text="Deleted Linked dlls" Importance="high" />
	</Target>

	<Target Condition="'$(Configuration)'=='AOT' And $(RuntimeIdentifier.StartsWith('linux'))" Name="DeleteLinkedLibAfterPublishLinux" AfterTargets="Publish">
		<ItemGroup>
			<FilesToDelete Include="$(PublishDir)libHarfBuzzSharp.so;$(PublishDir)libSkiaSharp.so;" />
		</ItemGroup>
		<Delete Files="@(FilesToDelete)" />
		<Message Text="Deleted Linked dlls" Importance="high" />
	</Target>

	<!-- End Link Static libs -->
	<!-- End AOT publish -->

	<PropertyGroup>
		<IlcGenerateMapFile>true</IlcGenerateMapFile>
		<IlcGenerateMetadataLog>true</IlcGenerateMetadataLog>
		<IlcGenerateMstatFile>true</IlcGenerateMstatFile>
		<IlcGenerateDgmlFile>true</IlcGenerateDgmlFile>
	</PropertyGroup>
	
	<PropertyGroup Label="Avalonia">
		<AvaloniaUseCompiledBindingsByDefault>True</AvaloniaUseCompiledBindingsByDefault>
		<ApplicationIcon>..\Caly.Core\Assets\caly-logo.ico</ApplicationIcon>
	</PropertyGroup>

	<!-- macOS: after each build, assemble TraceView.app so the Dock shows the app icon.
	     Files are hard-linked (cp -al) into the bundle: zero extra disk usage, and the
	     apphost is a real file inside the bundle so LaunchServices/Dock pick up AppIcon.icns.
	     The bundle is staged in a sibling temp dir first (so cp never recurses into itself),
	     then moved into place. -->
	<Target Name="CreateMacAppBundle" AfterTargets="Build" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
		<PropertyGroup>
			<AppBundlePath>$(OutDir)TraceView.app</AppBundlePath>
			<AppBundleStaging>$(MSBuildProjectDirectory)/obj/.TraceView.app.staging</AppBundleStaging>
		</PropertyGroup>
		<Exec Command="rm -rf &quot;$(AppBundleStaging)&quot; &quot;$(AppBundlePath)&quot; &amp;&amp; mkdir -p &quot;$(AppBundleStaging)/Contents/MacOS&quot; &quot;$(AppBundleStaging)/Contents/Resources&quot; &amp;&amp; cp -al &quot;$(OutDir).&quot; &quot;$(AppBundleStaging)/Contents/MacOS/&quot; &amp;&amp; cp &quot;$(MSBuildProjectDirectory)/../Logo/AppIcon.icns&quot; &quot;$(AppBundleStaging)/Contents/Resources/AppIcon.icns&quot; &amp;&amp; sed -e 's/__VERSION__/$(Version)/g' &quot;$(MSBuildProjectDirectory)/MacAppBundle/Info.plist&quot; &gt; &quot;$(AppBundleStaging)/Contents/Info.plist&quot; &amp;&amp; mv &quot;$(AppBundleStaging)&quot; &quot;$(AppBundlePath)&quot;" />
	</Target>

	<Target Name="DeletePdbAfterPublish" AfterTargets="Publish">
		<ItemGroup>
			<FilesToDelete Include="$(PublishDir)*.pdb;" />
		</ItemGroup>
		<Delete Files="@(FilesToDelete)" />
		<Message Text="Deleted PDB files" Importance="high" />
	</Target>

	<ItemGroup>
		<PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
		<PackageReference Condition="'$(Configuration)'=='Debug'" Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.2" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Caly.Core\Caly.Core.csproj" />
		<ProjectReference Include="..\Caly.Printing\Caly.Printing.Windows\Caly.Printing.Windows.csproj" />
		<ProjectReference Include="..\Caly.Printing\Caly.Printing.Unix\Caly.Printing.Unix.csproj" />
	</ItemGroup>
</Project>