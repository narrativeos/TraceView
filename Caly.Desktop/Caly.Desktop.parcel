{
    "GeneralSettings": {
        "NetProjectPath": "Caly.Desktop.csproj",
        "ApplicationName": "TraceView",
        "Version": {
            "$type": "msbuild",
            "property": "Version"
        },
        "PackageName": {
            "$type": "msbuild",
            "property": "AssemblyName"
        },
        "AssemblyName": {
            "$type": "msbuild",
            "property": "AssemblyName"
        }
    },
    "LinuxSettings": {
        "CreateBinSymlink": "True",
        "DesktopCategory": "Viewer"
    },
    "Win32Settings": {
        "InstallerIcon": "../Caly.Core/Assets/caly-logo.ico",
        "InstallerLicense": "../LICENSE",
        "InstallerRequiresAdmin": "False",
        "IncludeUninstaller": "True"
    },
    "MacOsSettings": {
        "CreateBundle": true,
        "BundleIdentifier": "com.CompanyName.TraceView",
        "SigningCredentialsType": "AdHoc"
    },
    "PublishSettings": {
        "Configuration": "Release",
        "PublishSingleFile": "True",
        "PublishTrimmed": "True",
        "PublishReadyToRun": "True",
        "ExtraBuildProperties": {}
    }
}